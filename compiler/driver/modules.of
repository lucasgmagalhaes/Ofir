/**
 * @module
 * Loading the modules of a program (spec 7.1 and 7.2; stage 0:
 * bootstrap/src/driver_modules.c): the root file, then every module it
 * imports, transitively. `import a.b` is the file `<root dir>/a/b.of` or
 * `<root dir>/a/b/index.of`, where the root dir is the project's (the
 * nearest directory with an `ofir.json`) or the root file's; `import
 * std.x` is in the standard library, and `std.core` (the prelude) is always
 * loaded. When `a.b` names a declaration rather than a module (`import
 * std.collections.Map`), its module `a` is loaded. Imports that match no
 * file are reported by the resolver (E0204).
 *
 * Stage 1 has no `ofir test` yet: the `_test.of` files are not loaded.
 */

import base.intern.Interner
import base.intern.Symbol
import base.span.FileId
import base.span.SourceMap
import diag.Diagnostics
import driver.cfg.CfgTarget
import driver.cfg.stripCfg
import sema.program.Program
import sema.program.ProgramModule
import sema.program.newProgram
import std.fs
import std.mem
import std.os
import syntax.ast.ItemKind
import syntax.ast.Module
import syntax.lexer.tokenize
import syntax.parser.parseFrom

/**
 * The tables of a compilation: files, names and diagnostics.
 */
pub struct Front {
    /** The files read so far. */
    pub map: SourceMap
    /** The interner of every file's names. */
    pub names: Interner
    /** The diagnostics of every phase. */
    pub diags: Diagnostics
    /** Texts read in place of their files: the unsaved buffers of an editor. */
    pub overlays: Map<str, str>

    /**
     * Reads a file into the source map, or its overlay.
     *
     * @param path its path
     * @returns its id, or `None` when it cannot be read
     */
    pub fn load(mut self, path: str) Option<FileId> {
        if const Option.Some(text) = self.overlays.get(path) {
            const saved = text.clone()
            return Option.Some(self.map.add(path.toOwned(), saved))
        }
        const Result.Ok(text) = fs.readToString(path) else {
            return Option.None
        }
        return Option.Some(self.map.add(path.toOwned(), text))
    }

    /**
     * Lexes and parses a file, as stage 0 does: nothing is parsed once an
     * error was reported, in this file or an earlier one.
     *
     * @param file a file of the source map
     * @returns its tree, also when it has syntax errors
     */
    pub fn parseFile(mut self, file: FileId) Option<Module> {
        return self.parseFileFrom(file, 0)
    }

    /**
     * `parseFile` with the nodes numbered from `firstId`.
     *
     * @param file a file of the source map
     * @param firstId the number of the first node
     * @returns its tree
     */
    pub fn parseFileFrom(mut self, file: FileId, firstId: int) Option<Module> {
        const tokens = tokenize(self.map.file(file).text, file, self.names, self.diags)
        if self.diags.hasErrors() {
            return Option.None
        }
        const names = mem.replace(self.names, Interner.new())
        const diags = mem.replace(self.diags, Diagnostics.new())
        const parsed = parseFrom(file, self.map.file(file).text, tokens, names, diags, firstId)
        self.names = parsed.names
        self.diags = parsed.diags
        return Option.Some(parsed.module)
    }
}

struct Loader {
    modules: List<ProgramModule>
    rootDir: str
    stdDir: Option<str>
    testing: bool
    target: CfgTarget
}

// `ofir test` (spec 12.2): the tests of `a/b.of` are in `a/b_test.of`, part
// of the same module, so that they may use its private declarations. The
// test file of a module outside std, or of the root, joins its items.
fn addTestFile(ld: Loader, front: mut Front, module: mut Module, name: str, path: str) {
    const inStd = name.startsWith("std")
    if !ld.testing || (inStd && ld.modules.len() > 0) || path.len() < 3 {
        return
    }
    const test = "{path.slice(0, path.len() - 3)}_test.of"
    if !fs.exists(test) {
        return
    }
    const Option.Some(file) = front.load(test) else {
        return
    }
    const Option.Some(tests) = front.parseFileFrom(file, module.nodeCount) else {
        return
    }
    if tests.items.len() == 0 {
        return
    }
    module.items.extend(tests.items)
    module.nodeCount = tests.nodeCount
}

// The position of the last `/` of `path`, or -1.
fn lastSlash(path: str) int {
    let found = -1
    let i = 0
    for b in path.bytes() {
        if b == b'/' {
            found = i
        }
        i += 1
    }
    return found
}

fn isLoaded(ld: Loader, name: str) bool {
    for i in 0..ld.modules.len() {
        if ld.modules[i].name == name {
            return true
        }
    }
    return false
}

// The file of module `name`, if it exists.
fn moduleFile(ld: Loader, name: str) Option<str> {
    const inStd = name.startsWith("std.")
    let dir = ld.rootDir.clone()
    let rest = name.toOwned()
    if inStd {
        const Option.Some(std) = ld.stdDir.clone() else {
            return Option.None
        }
        dir = std.clone()
        rest = name.sliceFrom(4).toOwned()
    }
    const relative = rest.replace(".", "/")
    const file = "{dir}/{relative}.of"
    if fs.exists(file) {
        return Option.Some(file)
    }
    const index = "{dir}/{relative}/index.of"
    if fs.exists(index) {
        return Option.Some(index)
    }
    return Option.None
}

fn loadModule(ld: mut Loader, front: mut Front, name: str, path: str) {
    const Option.Some(file) = front.load(path) else {
        return
    }
    if const Option.Some(parsed) = front.parseFile(file) {
        let module = parsed
        addTestFile(ld, front, module, name, path)
        stripCfg(module, &ld.target, front.names, front.diags)
        ld.modules.push(ProgramModule{name: name.toOwned(), module})
    }
}

fn dottedName(names: Interner, path: &List<Symbol>, count: int) str {
    let out = ""
    for i in 0..count {
        if i > 0 {
            out.push(".")
        }
        out.push(names.name(path[i]))
    }
    return out
}

// The module named by the path, then its parent.
fn loadImport(ld: mut Loader, front: mut Front, path: &List<Symbol>) {
    let count = path.len()
    for count >= 1 && count + 1 >= path.len() {
        const name = dottedName(front.names, path, count)
        if isLoaded(ld, name) {
            return
        }
        if const Option.Some(file) = moduleFile(ld, name) {
            loadModule(ld, front, name, file)
            return
        }
        count -= 1
    }
}

// The module name of a root file outside std and the project: its name
// without the directory and `.of`; the directory's name for an `index.of`.
fn rootName(input: str) str {
    const slash = lastSlash(input)
    const base = input.sliceFrom(slash + 1)
    if base == "index.of" && slash >= 0 {
        const dir = input.slice(0, slash)
        return dir.sliceFrom(lastSlash(dir) + 1).toOwned()
    }
    if base.len() > 3 && base.endsWith(".of") {
        return base.slice(0, base.len() - 3).toOwned()
    }
    return base.toOwned()
}

// The dotted name of `input` relative to the directory `dir`, with `prefix`
// (`std.` for the standard library), if `input` is inside it.
fn nameUnder(input: str, dir: str, prefix: str) Option<str> {
    const Result.Ok(file) = fs.canonicalize(input) else {
        return Option.None
    }
    const Result.Ok(base) = fs.canonicalize(dir) else {
        return Option.None
    }
    if !file.startsWith("{base}/") {
        return Option.None
    }
    const dotted = "{prefix}{file.sliceFrom(base.len() + 1)}"
    const min = prefix.len() + 4   // at least `x.of`
    if dotted.len() < min {
        return Option.None
    }
    const isIndex = dotted.len() > min + 5 && dotted.endsWith("/index.of")
    const cut = dotted.len() - if isIndex { 9 } else { 3 }   // or `.of`
    return Option.Some(dotted.slice(0, cut).replace("/", "."))
}

// The project root (spec 7.2): the nearest directory above the root file
// that holds an `ofir.json`.
fn projectDir(input: str) Option<str> {
    const Result.Ok(path) = fs.canonicalize(input) else {
        return Option.None
    }
    let dir = path
    for {
        const slash = lastSlash(dir)
        if slash <= 0 {
            return Option.None
        }
        dir = dir.slice(0, slash).toOwned()
        if fs.exists("{dir}/ofir.json") {
            return Option.Some(dir)
        }
    }
}

// The standard library: `$OFIR_STD`, or installed next to the compiler.
fn findStd() Option<str> {
    if const Option.Some(given) = os.env("OFIR_STD") {
        if given.len() > 0 {
            return Option.Some(given)
        }
    }
    const Result.Ok(exe) = os.executablePath() else {
        return Option.None
    }
    const dir = exe.slice(0, if lastSlash(exe) >= 0 { lastSlash(exe) } else { exe.len() })
    const places = ["../../std", "../lib/ofir/std"]
    for i in 0..places.len() {
        const place = "{dir}/{places[i]}"
        if fs.exists(place) {
            return Option.Some(place)
        }
    }
    return Option.None
}

// The name of the root module: a file inside std is that std module, and a
// file of a project is named from the project root (`base.intern`).
fn rootModuleName(ld: Loader, input: str, inProject: bool) str {
    if const Option.Some(std) = ld.stdDir.clone() {
        if const Option.Some(name) = nameUnder(input, std, "std.") {
            return name
        }
    }
    if inProject {
        if const Option.Some(name) = nameUnder(input, ld.rootDir, "") {
            return name
        }
    }
    return rootName(input)
}

/**
 * The modules of the program whose root file is `input`.
 *
 * @param input the root file's path, as given
 * @param root its tree
 * @param front the tables, where the other files go
 * @param target what `@cfg` conditions are evaluated against; under `ofir test`, the
 *   test files of the modules are loaded
 * @returns the program, the root first
 */
pub fn loadProgram(input: str, root: move Module, front: mut Front,
                   target: move CfgTarget) Program {
    const slash = lastSlash(input)
    let rootDir = if slash >= 0 { input.slice(0, slash).toOwned() } else { "." }
    const project = projectDir(input)
    const inProject = project.isSome()
    if const Option.Some(dir) = project {
        rootDir = dir
    }
    const testing = target.test
    let ld = Loader{modules: [], rootDir, stdDir: findStd(), testing, target}
    const name = rootModuleName(ld, input, inProject)
    let module = root
    addTestFile(ld, front, module, name, input)
    stripCfg(module, &ld.target, front.names, front.diags)
    ld.modules.push(ProgramModule{name, module})
    if !isLoaded(ld, "std.core") {   // the prelude, in every program
        if const Option.Some(core) = moduleFile(ld, "std.core") {
            loadModule(ld, front, "std.core", core)
        }
    }
    let m = 0
    for m < ld.modules.len() {   // grows while it is walked
        let imports: List<List<Symbol>> = []
        const items = &ld.modules[m].module.items
        for i in 0..items.len() {
            if const ItemKind.Import(path, _) = items[i].kind {
                imports.push(path.clone())
            }
        }
        for i in 0..imports.len() {
            loadImport(ld, front, &imports[i])
        }
        m += 1
        if m == ld.modules.len() {
            // `Any` (spec 9.8) and `Iterator<T>` (spec 9.5): prelude modules
            // that stage 0 cannot read, so `std.core` does not import them;
            // loaded last, they leave the numbers of the other modules as
            // stage 0 gives them.
            let late = ["std.core.any", "std.core.iter"]
            if ld.target.bench {
                late.push("std.core.bench")   // `Bencher` (spec 12.3)
            }
            for k in 0..late.len() {
                if isLoaded(ld, late[k]) {
                    continue
                }
                if const Option.Some(file) = moduleFile(ld, late[k]) {
                    loadModule(ld, front, late[k], file)
                }
            }
        }
    }
    return newProgram(ld.modules)
}
