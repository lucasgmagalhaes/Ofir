/**
 * @module
 * Semantic versions and the requirements on them (ADR 0032): a version is
 * `MAJOR.MINOR.PATCH`; a requirement is `^1.2.3` (also a bare `1.2.3`),
 * `~1.2.3`, `=1.2.3`, `>=1.2.3` or `*`. A requirement may leave out the
 * patch or the minor (`^1.2`, `~1`): they are 0.
 */

/**
 * A version `major.minor.patch`.
 */
pub copy struct Version {
    pub major: int
    pub minor: int
    pub patch: int

    /**
     * Orders two versions.
     *
     * @param other the other version
     * @returns negative, zero or positive as `self` is lower, equal or higher
     */
    pub fn compare(self, other: Version) int {
        if self.major != other.major {
            return self.major - other.major
        }
        if self.minor != other.minor {
            return self.minor - other.minor
        }
        return self.patch - other.patch
    }

    /**
     * The version as `major.minor.patch`.
     *
     * @returns its text
     */
    pub fn text(self) str {
        return "{self.major}.{self.minor}.{self.patch}"
    }
}

/**
 * How a requirement compares a version with its own.
 */
pub copy enum Op {
    /** `^`: the same leftmost non-zero part, and not lower. */
    Caret
    /** `~`: the same major and minor, and not lower. */
    Tilde
    /** `=`: exactly. */
    Exact
    /** `>=`: not lower. */
    AtLeast
    /** `*`: any. */
    Any
}

/**
 * A requirement on the version of a package.
 */
pub copy struct Requirement {
    pub op: Op
    pub version: Version
    /** How many parts were written (1 to 3; 0 for `*`). */
    pub parts: int

    /**
     * Whether `v` satisfies the requirement.
     *
     * @param v a version
     * @returns true if it is accepted
     */
    pub fn matches(self, v: Version) bool {
        const base = self.version
        match self.op {
            Op.Any => {
                return true
            }
            Op.Exact => {
                return v.compare(base) == 0
            }
            Op.AtLeast => {
                return v.compare(base) >= 0
            }
            Op.Tilde => {
                if v.compare(base) < 0 || v.major != base.major {
                    return false
                }
                return self.parts < 2 || v.minor == base.minor
            }
            Op.Caret => {
                if v.compare(base) < 0 || v.major != base.major {
                    return false
                }
                if base.major > 0 || self.parts < 2 {
                    return true
                }
                if v.minor != base.minor {
                    return false
                }
                return base.minor > 0 || self.parts < 3 || v.patch == base.patch
            }
        }
    }

    /**
     * The requirement as it is written.
     *
     * @returns its text
     */
    pub fn text(self) str {
        const v = self.version
        const digits = if self.parts == 1 {
            "{v.major}"
        } else if self.parts == 2 {
            "{v.major}.{v.minor}"
        } else {
            v.text()
        }
        match self.op {
            Op.Any => {
                return "*"
            }
            Op.Exact => {
                return "={digits}"
            }
            Op.AtLeast => {
                return ">={digits}"
            }
            Op.Tilde => {
                return "~{digits}"
            }
            Op.Caret => {
                return "^{digits}"
            }
        }
    }
}

/**
 * Parses a version `MAJOR.MINOR.PATCH`, with an optional leading `v` (as
 * git tags have).
 *
 * @param text the version
 * @returns it, or `None` if it is not one
 */
pub fn parseVersion(text: str) Option<Version> {
    const start = if text.startsWith("v") { 1 } else { 0 }
    const parsed = parseParts(text.sliceFrom(start))
    if parsed.1 != 3 {
        return Option.None
    }
    return Option.Some(parsed.0)
}

/**
 * Parses a requirement.
 *
 * @param text the requirement, as `^1.2`, `~1.2.3`, `=1.0.0`, `>=0.3` or `*`
 * @returns it, or `None` if it is not one
 */
pub fn parseRequirement(text: str) Option<Requirement> {
    const t = text.trim()
    if t == "*" {
        return Option.Some(Requirement{op: Op.Any, version: Version{major: 0, minor: 0, patch: 0},
                                       parts: 0})
    }
    let op = Op.Caret
    let skip = 0
    if t.startsWith(">=") {
        op = Op.AtLeast
        skip = 2
    } else if t.startsWith("^") {
        skip = 1
    } else if t.startsWith("~") {
        op = Op.Tilde
        skip = 1
    } else if t.startsWith("=") {
        op = Op.Exact
        skip = 1
    }
    const parsed = parseParts(t.sliceFrom(skip).trim())
    if parsed.1 == 0 {
        return Option.None
    }
    return Option.Some(Requirement{op, version: parsed.0, parts: parsed.1})
}

// The parts of `a`, `a.b` or `a.b.c` (the others 0) and how many there
// are; 0 when `text` is not that.
fn parseParts(text: str) (Version, int) {
    let parts = [0, 0, 0]
    let count = 0
    for part in text.split(".") {
        if count == 3 || part.len() == 0 {
            return (Version{major: 0, minor: 0, patch: 0}, 0)
        }
        let value = 0
        for b in part.bytes() {
            if b < b'0' || b > b'9' || value > 100000000 {
                return (Version{major: 0, minor: 0, patch: 0}, 0)
            }
            value = value * 10 + (b - b'0') as int
        }
        parts[count] = value
        count += 1
    }
    return (Version{major: parts[0], minor: parts[1], patch: parts[2]}, count)
}
