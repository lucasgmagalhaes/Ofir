/**
 * The type `self` and `Self` stand for in the methods of item `index` of
 * module `m`: the struct or enum applied to its own parameters
 * (`Stack<T>`), or the primitive of a `@lang` declaration.
 *
 * @param c the checker
 * @param p the program
 * @param m a module
 * @param index an item of it
 * @returns the type
 */
pub fn ownerTypeOf(c: mut Checker, p: Program, m: int, index: int) int {
    for t in 0..c.r.lang.len() {
        let lang = c.r.lang[t]
        if lang != 0 && c.def(lang).module == m && c.def(lang).item == index {
            return t
        }
    }
    let id = c.itemDefs[m][index]
    let params = itemTypeParams(&p.modules[m].module.items[index])
    let isInterface = match p.modules[m].module.items[index].kind {
        ItemKind.Interface(_, _, _) => true
        _ => false
    }
    if isInterface {   // in an interface, `Self` is its type parameter 0
        return c.types.param(0, params[0].0)
    }
    var args: List<int> = []
    for i in 0..params.len() {
        args.push(c.types.param(i, params[i].0))
    }
    return c.types.adt(id, args)
}

/**
 * The type `self` stands for in the methods of a declaration's item.
 *
 * @param c the checker
 * @param p the program
 * @param id a struct, enum or `@lang` declaration
 * @returns the type
 */
pub fn ownerType(c: mut Checker, p: Program, id: int) int {
    if c.def(id).item < 0 {   // a type the checker made: a union
        return c.types.adt(id, [])
    }
    return ownerTypeOf(c, p, c.def(id).module, c.def(id).item)
}

/**
 * `Name<args>` for a type alias, expanded with its arguments so that the
 * checks of the aliased type run at each use.
 *
 * @param c the checker
 * @param p the program
 * @param id the alias
 * @param args its type arguments
 * @param span where it is named
 * @returns the type
 */
pub fn resolveAlias(c: mut Checker, p: Program, id: int, args: &List<TypeExpr>, span: Span) int {
    let item = itemOf(p, c.loc(id))
    return match item.kind {
        ItemKind.TypeAlias(typeParams, aliased) => aliasType(c, p, id, &typeParams, &aliased, args,
                                                             span)
        _ => ERROR
    }
}

fn aliasType(c: mut Checker, p: Program, id: int, typeParams: &List<Symbol>,
             aliased: &TypeExpr, args: &List<TypeExpr>, span: Span) int {
    if args.len() != typeParams.len() {
        c.error("E0302", span, "wrong number of type arguments for `{c.text(c.def(id).name)}`: "
                + "expected {typeParams.len()}, found {args.len()}")
        return ERROR
    }
    // Arguments belong to the caller; nested uses are not recursive bodies.
    var generics = noGenerics()
    generics.owner = typeParams.clone()
    generics.bounds = c.generics.bounds.clone()
    for i in 0..args.len() {
        generics.aliasArgs.push(resolveType(c, p, &args[i]))
    }
    if c.info[id].checking {
        c.error("E0310", span, "the type alias `{c.text(c.def(id).name)}` refers to itself")
        return ERROR
    }
    if typeParams.len() == 0 && c.info[id].typed {
        return c.info[id].ty
    }
    let saved = c.enter(c.def(id).module)
    let outer = c.enterGenerics(generics)
    let savedSelf = c.selfType
    let savedAlias = c.aliasDef
    c.selfType = ERROR
    c.aliasDef = id
    c.info[id].checking = true
    var ty = ERROR
    if checkAliasBounds(c, p, id, span) {
        ty = resolveType(c, p, aliased)
    }
    c.info[id].checking = false
    c.aliasDef = savedAlias
    c.selfType = savedSelf
    c.enterGenerics(outer)
    c.enter(saved)
    if typeParams.len() == 0 {
        c.info[id].ty = ty
        c.info[id].typed = true
    }
    return ty
}

/**
 * `Name<args>` for a struct or enum, checking the number of arguments (E0302).
 *
 * @param c the checker
 * @param p the program
 * @param id its `DefId`
 * @param args its type arguments
 * @param span where it is named
 * @returns the type
 */
pub fn adtInstance(c: mut Checker, p: Program, id: int, args: [int], span: Span) int {
    let expected = itemTypeParams(itemOf(p, c.loc(id))).len()
    if args.len() != expected {
        c.error("E0302", span, "wrong number of type arguments for `{c.text(c.def(id).name)}`: "
                + "expected {expected}, found {args.len()}")
        return ERROR
    }
    let ty = c.types.adt(id, args)
    let generics = typeGenericsOf(c, p, id)
    var list: List<int> = []
    for i in 0..args.len() {
        list.push(args[i])
    }
    checkBounds(c, p, &generics, &list, span)
    checkInstanceStorable(c, p, ty, span)
    return ty
}

// The type parameter named `name`, if it is in scope.
fn typeParameter(c: mut Checker, name: Symbol) Option<int> {
    var bound = c.typeVars.len()
    for bound > 0 {   // the innermost first
        bound -= 1
        if c.typeVars[bound].0 == name.0 {
            return Option.Some(c.typeVarTypes[bound])
        }
    }
    for i in 0..c.generics.fnParams.len() {
        if c.generics.fnParams[i].0 == name.0 {
            return Option.Some(c.types.param(c.generics.owner.len() + i, name.0))
        }
    }
    for i in 0..c.generics.owner.len() {
        if c.generics.owner[i].0 == name.0 {
            return Option.Some(if c.generics.aliasArgs.len() > 0 { c.generics.aliasArgs[i] }
                         else { c.types.param(i, name.0) })
        }
    }
    return Option.None
}

fn namedType(c: mut Checker, p: Program, id: int, args: &List<TypeExpr>, span: Span) int {
    let kind = c.def(id).kind
    warnDeprecated(c.r, id, span)
    if args.len() > 0 && kind != DefKind.Struct && kind != DefKind.Enum &&
       kind != DefKind.TypeAlias {
        c.error("E0302", span, "`{c.text(c.def(id).name)}` takes no type arguments")
        return ERROR
    }
    return match kind {
        DefKind.Primitive => c.def(id).primitive
        DefKind.TypeAlias => resolveAlias(c, p, id, args, span)
        DefKind.Struct | DefKind.Enum => {
            if c.def(id).lang {
                return c.def(id).primitive   // a `@lang` body names its primitive
            }
            var types: List<int> = []
            for i in 0..args.len() {
                types.push(resolveType(c, p, &args[i]))
            }
            adtInstance(c, p, id, types, span)
        }
        DefKind.Interface => {
            let name = c.text(c.def(id).name)
            c.error("E0356", span, "`{name}` is an interface: only a parameter type can name it "
                    + "alone; write `dyn {name}` or a type parameter (spec 9.6)")
            ERROR
        }
        _ => {
            c.error("E0310", span, "expected a type, found `{c.text(c.def(id).name)}`")
            ERROR
        }
    }
}

/**
 * A declaration of another module named in a type or a pattern; reports
 * E0200 when it is missing and E0202 when it is private.
 *
 * @param c the checker
 * @param m the module
 * @param name the name
 * @param span where it is used
 * @returns its `DefId`, or 0
 */
pub fn moduleType(c: mut Checker, m: int, name: Symbol, span: Span) int {
    let id = c.r.scope.moduleIn(m, name)
    let moduleName = c.r.moduleNames[m].clone()
    if id == 0 || c.def(id).inPrelude || c.def(id).module != m {
        c.error("E0200", span, "cannot find `{c.text(name)}` in module `{moduleName}`")
        suggestMember(c.r, m, name)
        return 0
    }
    if !c.def(id).isPub {
        c.error("E0202", span, "`{c.text(name)}` is private to module `{moduleName}`")
    }
    return id
}

// `Name` or `module.Name`: its `DefId`, or 0.
fn pathTarget(c: mut Checker, segments: &List<Symbol>, span: Span) int {
    let first = c.r.scope.module(segments[0])
    c.r.noteImportUse(segments[0])
    if segments.len() == 1 {
        return first
    }
    if first == 0 {   // `nowhere.Name`
        c.error("E0200", span, "cannot find `{c.text(segments[0])}` in this scope")
        suggestName(c.r, segments[0], SuggestScope.Item)
        return 0
    }
    if segments.len() > 2 || c.def(first).kind != DefKind.Module {
        c.unsupported(span, "nested module paths in types are")
        return 0
    }
    return moduleType(c, c.def(first).target, segments[segments.len() - 1], span)
}

fn resolvePath(c: mut Checker, p: Program, segments: &List<Symbol>, args: &List<TypeExpr>,
               span: Span) int {
    if segments.len() == 1 {
        if let Option.Some(param) = typeParameter(c, segments[0]) {
            if args.len() > 0 {
                c.error("E0302", span, "a type parameter takes no type arguments".toOwned())
            }
            return param
        }
    }
    let id = pathTarget(c, segments, span)
    if id == 0 && segments.len() > 1 {
        return ERROR   // reported by moduleType
    }
    if id == 0 {
        let name = segments[segments.len() - 1]
        c.error("E0200", span, "cannot find type `{c.text(name)}` in this scope")
        suggestName(c.r, name, SuggestScope.Type)
        return ERROR
    }
    return namedType(c, p, id, args, span)
}

// `[T]` and `&[T]`: the std `Slice<T>`, a pointer and a length (spec 2.12).
pub fn sliceOf(c: mut Checker, elem: int, span: Span) int {
    let slice = c.r.langItems[4]
    if slice == 0 {
        return c.unsupported(span, "slices without the standard library are")
    }
    return c.types.adt(slice, [elem])
}

/**
 * Whether a type is the built-in `str` view or a reference written `&[T]`:
 * the kinds `resolveRef` passes through.
 *
 * @param t a type as written
 * @returns true for `[T]`
 */
fn isSliceType(t: &TypeExpr) bool {
    return match t.kind {
        TypeKind.Slice(_) => true
        _ => false
    }
}

/**
 * The type a type expression names, in the current module and generics.
 *
 * @param c the checker
 * @param p the program
 * @param t the type as written
 * @returns the type
 */
pub fn resolveType(c: mut Checker, p: Program, t: &TypeExpr) int {
    return match t.kind {
        TypeKind.Path(segments, args) => resolvePath(c, p, &segments, &args, t.span)
        TypeKind.SelfType => {
            if c.selfType == ERROR {
                c.error("E0200", t.span, "`Self` is only available inside a type".toOwned())
            }
            c.selfType
        }
        TypeKind.Ref(mutable, inner) => {
            let target = resolveType(c, p, &*inner)
            if target == STR && !mutable {
                return STR   // stage 0: `&str` is a `str` view
            }
            if isSliceType(&*inner) {   // `&[T]` is the slice itself
                if mutable {
                    return c.unsupported(t.span, "mutable slices `&mut [T]` are")
                }
                return target
            }
            c.types.ref(target, mutable)
        }
        TypeKind.Ptr(mutable, inner) => {
            let target = resolveType(c, p, &*inner)
            c.types.ptr(target, mutable)
        }
        TypeKind.Slice(elem) => {
            let item = resolveType(c, p, &*elem)
            sliceOf(c, item, t.span)
        }
        TypeKind.Array(elem, len) => {
            let item = resolveType(c, p, &*elem)
            match len.kind {
                ExprKind.Int(n) => {
                    if n > 4294967295 {
                        return c.unsupported(len.span,
                                             "array lengths other than integer literals are")
                    }
                    c.types.intern(TyKind.Array, n as int, item, [])
                }
                _ => c.unsupported(len.span, "array lengths other than integer literals are")
            }
        }
        TypeKind.Tuple(items) => {
            var types: List<int> = []
            for i in 0..items.len() {
                types.push(resolveType(c, p, &items[i]))
            }
            c.types.tuple(types)
        }
        TypeKind.Fn(params, _, ret, owned) => {
            var types: List<int> = []
            for i in 0..params.len() {
                types.push(resolveType(c, p, &params[i]))
            }
            let result = match ret {
                Option.Some(r) => resolveType(c, p, &*r)
                Option.None => UNIT
            }
            c.types.fnValueType(types, result, owned)
        }
        TypeKind.Never => NEVER
        TypeKind.Dyn(inner) => dynType(c, p, &*inner, t.span)
        TypeKind.Optional(_) => c.unsupported(t.span, "optional types (`T?`) are")
        TypeKind.KeyOf(inner) => keyofType(c, p, &*inner, t.span)
        TypeKind.Key(name) => c.types.keys([name.0])
        TypeKind.KeyOp(op, left, right) => keyOpType(c, p, op, &*left, &*right, t.span)
        TypeKind.Index(base, key) => indexType(c, p, &*base, &*key, t.span)
        TypeKind.Mapped(param, keys, filter, optional, field) => {
            mappedType(c, p, t, param, &*keys, &filter, optional, &*field)
        }
        TypeKind.Is(_, _) => isType(c, p, t)
        TypeKind.Cond(test, then, otherwise) => condType(c, p, &*test, &*then, &*otherwise)
        TypeKind.Infer(name) => inferType(c, name, t.span)
        TypeKind.Bool(value) => boolType(c, value)
    }
}

/**
 * The signature of a function, computed once: its names are looked up in
 * its own module, and `Self` is a method's own type.
 *
 * @param c the checker
 * @param p the program
 * @param id the function's `DefId`
 * @returns its `fn` type, without `self`
 */
pub fn fnSignature(c: mut Checker, p: Program, id: int) int {
    if c.info[id].typed {
        return c.info[id].ty
    }
    let def = c.def(id)
    let module = def.module
    let decl = fnOf(p, c.loc(id))
    let item = itemOf(p, c.loc(id))
    let isMethod = match item.kind {
        ItemKind.Struct(_, _, _, _, _, _) | ItemKind.Enum(_, _, _, _) |
        ItemKind.Interface(_, _, _) => true
        _ => false
    }
    let saved = c.enter(module)
    let savedSelf = c.selfType
    let owner = typeGenerics(c, p, item)
    let outer = c.enterGenerics(fnGenericsIn(c, p, &owner, decl))
    if isMethod {
        c.selfType = ownerTypeOf(c, p, module, c.def(id).item)
    }
    var params: List<int> = []
    for i in 0..decl.params.len() {
        var ty = resolveType(c, p, &decl.params[i].ty)
        if decl.params[i].mode == Mode.Move {   // `f: move fn(A) R` takes an owned function
            ty = ownedFn(c, ty)
        }
        if c.types.kind(ty) == TyKind.Dyn {   // `s: dyn Shape` borrows the value
            if decl.params[i].mode != Mode.Borrow {
                ty = c.unsupported(decl.params[i].ty.span, "`mut` and `move` `dyn` parameters are")
            } else {
                ty = c.types.ref(ty, false)
            }
        }
        params.push(ty)
    }
    let ret = match decl.ret {
        Option.Some(t) => resolveType(c, p, &t)
        Option.None => UNIT
    }
    c.enterGenerics(outer)
    c.selfType = savedSelf
    c.enter(saved)
    let sig = c.types.fnType(params, ret)
    c.info[id].ty = sig
    c.info[id].typed = true
    return sig
}

/**
 * Whether `found` fits `expected`: `!` converts to every type, and the
 * error type is compatible with everything, so that one mistake is
 * reported once.
 *
 * @param found the type found
 * @param expected the type expected
 * @returns true if compatible
 */
pub fn compatible(found: int, expected: int) bool {
    return found == expected || found == ERROR || expected == ERROR || found == NEVER
}

// The owned function type `move fn(A) R` of `fn(A) R`; other types as they are.
fn ownedFn(c: mut Checker, ty: int) int {
    let t = c.types.get(ty)
    if t.kind != TyKind.Fn || t.data != FN_BORROWED {
        return ty
    }
    let args = t.args.clone()
    let ret = t.inner
    return c.types.fnValueType(args, ret, true)
}

// `dyn I`: E0333 unless `I` names an interface, E0338 unless its methods
// can be called through a vtable (spec 9.7).
fn dynType(c: mut Checker, p: Program, inner: &TypeExpr, span: Span) int {
    let iface = interfaceOf(c, inner)
    if iface == 0 {
        c.error("E0333", inner.span, "`{typeText(inner, c.r.names)}` is not an interface")
        return ERROR
    }
    let generic = match inner.kind {
        TypeKind.Path(_, args) => args.len() > 0
        _ => false
    }
    if generic {
        return c.unsupported(span, "`dyn` of generic interfaces is")
    }
    let why = dynIncompatible(c, p, iface)
    if why.len() > 0 {
        c.error("E0338", span, "`dyn {typeText(inner, c.r.names)}` is not allowed: {why}")
        return ERROR
    }
    return c.types.dynOf(iface, [])
}
