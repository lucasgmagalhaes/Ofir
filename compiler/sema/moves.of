/**
 * @module
 * Move analysis (spec 5.1; stage 0: bootstrap/src/sema/moves.c): states,
 * statements and loops. Expressions and places are in `moves_expr`,
 * patterns and `match` in `moves_match`.
 *
 * After a function is type checked, its body is walked in evaluation order
 * with a state per program point: which variables, or parts of them, may
 * have been moved out, and which may not be initialized yet. At a join
 * (after `if`, `match`, `&&`, loops) a variable is maybe-moved if it is on
 * some path. Loops are walked until their entry state no longer changes,
 * then once more to report errors.
 *
 * Stage 0 walks a tree into which the checker wrote the implicit
 * dereferences (`*r`, `*b.ptr`) and the conversions (`list.asSlice()`);
 * stage 1 finds them in the checker's tables (`Checker.derefs`,
 * `Checker.sliceCoercions`) and walks them as if they were written.
 *
 * The same walk checks borrows (`borrows`): the state also holds the
 * loans that may be alive and the conflicting accesses to them.
 */

import base.span.Span
import sema.borrows.Loan
import sema.borrows.Conflict
import sema.borrows.access
import sema.borrows.bindLoans
import sema.borrows.carriedSince
import sema.borrows.dropCarry
import sema.borrows.joinLoans
import sema.borrows.killHolder
import sema.borrows.loansOf
import sema.borrows.sameLoans
import sema.borrows.useHolder
import sema.check.Checker
import sema.check.fnOf
import sema.check_list.iteratorItem
import sema.check_ref.holdsRef
import sema.moves_expr.isPlaceView
import sema.moves_expr.movesNode
import sema.moves_expr.viewType
import sema.moves_match.patternInit
import sema.program.Program
import sema.structs.isCopy
import syntax.ast.Block
import syntax.ast.ExprKind
import syntax.ast.ForKind
import syntax.ast.Mode
import syntax.ast.Op
import syntax.ast.PatternKind
import syntax.ast.Stmt
import syntax.ast.StmtKind
import std.mem

/** A part of a local: `p.a.b` is local p with the path of fields [a, b]. */
pub struct Part {
    /** The local. */
    pub local: int
    /** The fields, outermost first; empty for the whole local. */
    pub fields: List<int>

    /**
     * Whether two parts are the same.
     *
     * @param other the other part
     * @returns true if they are
     */
    pub fn same(self, other: &Part) bool {
        if self.local != other.local || self.fields.len() != other.fields.len() {
            return false
        }
        for i in 0..self.fields.len() {
            if self.fields[i] != other.fields[i] {
                return false
            }
        }
        return true
    }

    /**
     * Whether one path is a prefix of the other: using one uses the other.
     *
     * @param other the other part
     * @returns true if they overlap
     */
    pub fn overlaps(self, other: &Part) bool {
        if self.local != other.local {
            return false
        }
        let len = if self.fields.len() < other.fields.len() { self.fields.len() } else {
            other.fields.len()
        }
        for i in 0..len {
            if self.fields[i] != other.fields[i] {
                return false
            }
        }
        return true
    }

    /**
     * Whether this part is `other` or inside it.
     *
     * @param other the enclosing part
     * @returns true if it is
     */
    pub fn inside(self, other: &Part) bool {
        return self.local == other.local && self.fields.len() >= other.fields.len() &&
               self.overlaps(other)
    }
}

/**
 * The deepest path of a moved part, as stage 0 (`PART_DEPTH`).
 */
pub const PART_DEPTH: int = 7

/** What is known at a program point. */
pub struct State {
    /** Unreachable: a join ignores it. */
    pub dead: bool
    /** Per local: maybe moved as a whole. */
    pub moved: List<bool>
    /** Per local: maybe not initialized. */
    pub uninit: List<bool>
    /** The parts maybe moved out. */
    pub parts: List<Part>
    /** The loans maybe alive. */
    pub loans: List<Loan>
    /** The accesses that conflict with a loan, errors if its holder is used. */
    pub conflicts: List<Conflict>

    /**
     * A copy of this state.
     *
     * @returns the copy
     */
    pub fn dup(self) State {
        return State{dead: self.dead, moved: self.moved.clone(), uninit: self.uninit.clone(),
                     parts: self.parts.clone(), loans: self.loans.clone(),
                     conflicts: self.conflicts.clone()}
    }

    /**
     * Whether a part overlaps something moved.
     *
     * @param part the part
     * @returns true if it does
     */
    pub fn movedPart(self, part: &Part) bool {
        if self.moved[part.local] {
            return true
        }
        for i in 0..self.parts.len() {
            if self.parts[i].overlaps(part) {
                return true
            }
        }
        return false
    }

    fn addPart(mut self, part: &Part) {
        for i in 0..self.parts.len() {
            if self.parts[i].same(part) {
                return
            }
        }
        self.parts.push(part.clone())
    }

    /**
     * Joins the state of another path into this one.
     *
     * @param other the other path's state
     */
    pub fn join(mut self, other: &State) {
        if other.dead {
            return
        }
        if self.dead {
            self.replace(other.dup())
            return
        }
        for i in 0..self.moved.len() {
            self.moved[i] = self.moved[i] || other.moved[i]
            self.uninit[i] = self.uninit[i] || other.uninit[i]
        }
        for i in 0..other.parts.len() {
            self.addPart(&other.parts[i])
        }
        joinLoans(self, other)
    }

    /**
     * Makes this state another one.
     *
     * @param other the new state
     */
    pub fn replace(mut self, other: move State) {
        self.dead = other.dead
        self.moved = other.moved
        self.uninit = other.uninit
        self.parts = other.parts
        self.loans = other.loans
        self.conflicts = other.conflicts
    }

    /**
     * Whether two states are the same.
     *
     * @param other the other state
     * @returns true if they are
     */
    pub fn equals(self, other: &State) bool {
        if self.dead != other.dead || self.parts.len() != other.parts.len() {
            return false
        }
        for i in 0..self.moved.len() {
            if self.moved[i] != other.moved[i] || self.uninit[i] != other.uninit[i] {
                return false
            }
        }
        for i in 0..self.parts.len() {
            if !self.parts[i].same(&other.parts[i]) {
                return false
            }
        }
        return sameLoans(&self, other)
    }

    /**
     * An assignment to `part` makes it, and everything inside it, a value
     * again.
     *
     * @param part the assigned part
     */
    pub fn initPart(mut self, part: &Part) {
        if part.fields.len() == 0 {
            self.moved[part.local] = false
            self.uninit[part.local] = false
        }
        var kept: List<Part> = []
        for i in 0..self.parts.len() {
            if !self.parts[i].inside(part) {
                kept.push(self.parts[i].clone())
            }
        }
        self.parts = kept
    }
}

/**
 * A state where nothing is moved.
 *
 * @param count the number of locals
 * @returns the state
 */
pub fn newState(count: int) State {
    return State{dead: false, moved: List.filled(false, count),
                 uninit: List.filled(false, count), parts: [], loans: [], conflicts: []}
}

/**
 * The state of no path.
 *
 * @returns the state
 */
pub fn deadState() State {
    return State{dead: true, moved: [], uninit: [], parts: [], loans: [], conflicts: []}
}

/** The states leaving a loop by `break` and by `continue`. */
pub struct LoopFrame {
    /** Joined at each `break`. */
    pub breaks: State
    /** Joined at each `continue` and at the end of the body. */
    pub continues: State
}

/**
 * How an expression is used: its value read (borrowed), consumed, for the
 * target of `=` overwritten, or, for a `mut` argument, borrowed mutably
 * once the other arguments are evaluated (two-phase borrows).
 */
pub copy enum Use {
    Read
    Move
    Assign
    Mutate
}

/** What the lowering needs from the analysis of a function. */
pub struct FnMoves {
    /** Per local: it borrows a place (borrowed parameter, `for` variable, binding). */
    pub borrowed: List<bool>
    /** Every part moved somewhere. */
    pub parts: List<Part>
}

/** A flag of `Moves.flags`: the value of the local is moved out, so it is not dropped. */
pub const MOVES: int = 1
/** A flag of `Moves.flags`: the temporary is consumed, so it is not dropped. */
pub const CONSUMED: int = 2
/** A flag of `Moves.flags`: the `list.asSlice()` a conversion inserts is consumed. */
pub const COERCION_CONSUMED: int = 4

/** The analysis of a function. */
pub struct Moves {
    /** The function's `DefId`. */
    pub fnDef: int
    /** False while a loop's fixpoint is computed. */
    pub report: bool
    /** Per local: borrows a place. */
    pub borrowed: List<bool>
    /** The open loops. */
    pub loops: List<LoopFrame>
    /** Every part moved somewhere, for the drops. */
    pub allParts: List<Part>
    /** Per local: its type holds a reference, so it holds the loans of its value. */
    pub refLocal: List<bool>
    /** Per local: its type is Copy, so a binding that borrows copies instead. */
    pub copyLocal: List<bool>
    /** The holder of the loan of the outermost `for` loop; inner loops follow. */
    pub holderBase: int
    /** The loans of the values being computed, innermost last. */
    pub carry: List<Loan>
    /** The loans the bindings of the current pattern take. */
    pub binding: List<Loan>
    /** The place of the last place expression walked, if `lastLocal`. */
    pub lastPlace: Part
    /** The last place expression walked is rooted at a local. */
    pub lastLocal: bool

    /**
     * Marks a part moved.
     *
     * @param s the state
     * @param part the part
     */
    pub fn movePart(mut self, s: mut State, part: &Part) {
        if part.fields.len() == 0 {
            s.moved[part.local] = true
            return
        }
        s.addPart(part)
        for i in 0..self.allParts.len() {
            if self.allParts[i].same(part) {
                return
            }
        }
        self.allParts.push(part.clone())
    }
}

/**
 * Records a flag of a node of the current module, for the lowering.
 *
 * @param c the checker
 * @param id the node
 * @param flag `MOVES`, `CONSUMED` or `COERCION_CONSUMED`
 */
pub fn markFlag(c: mut Checker, id: int, flag: int) {
    let old = match c.moveFlags[c.module()].get(id) {
        .Some(value) => *value
        .None => 0
    }
    c.moveFlags[c.module()].insert(id, old | flag)
}

/**
 * Reports a move error, unless a loop's fixpoint is being computed.
 *
 * @param m the analysis
 * @param c the checker
 * @param code the error code
 * @param span where
 * @param message what
 */
pub fn moveError(m: Moves, c: mut Checker, code: str, span: Span, message: move str) {
    if m.report {
        c.error(code, span, message)
    }
}

/**
 * The name of a local, for messages.
 *
 * @param c the checker
 * @param local the local
 * @returns its name
 */
pub fn localName(c: Checker, local: int) str {
    return c.text(c.locals[local].name).toOwned()
}

// A `mut` parameter may be moved out of, but it must hold a value again
// when the function returns: the caller still owns it (spec 5.3).
fn checkMutParams(m: Moves, c: mut Checker, p: Program, s: &State, span: Span) {
    if s.dead {
        return
    }
    let decl = fnOf(p, c.loc(m.fnDef))
    for i in 0..decl.params.len() + 1 {
        let isSelf = i == decl.params.len()
        if isSelf && !(decl.hasSelf && decl.selfMode == .Mut) {
            continue
        }
        if !isSelf && decl.params[i].mode != .Mut {
            continue
        }
        let local = if isSelf { 0 } else { c.localAt(decl.params[i].id.0) }
        if local >= 0 && s.movedPart(&Part{local: local, fields: []}) {
            moveError(m, c, "E0602", span, "`{localName(c, local)}` is moved out of and not "
                      + "given a new value before the function returns")
        }
    }
}

/**
 * Walks a block.
 *
 * @param m the analysis
 * @param c the checker
 * @param p the program
 * @param block the block
 * @param s the state, updated
 * @param tail how the value of its last expression is used
 */
pub fn movesBlock(m: mut Moves, c: mut Checker, p: Program, block: &Block, s: mut State,
                  tail: Use) {
    let count = block.stmts.len()
    for i in 0..count {
        let stmt = &block.stmts[i]
        var done = false
        if i + 1 == count {
            if let StmtKind.ExprStmt(e) = stmt.kind {
                movesNode(m, c, p, &e, s, tail)
                done = true
            }
        }
        if !done {
            let mark = m.carry.len()
            movesStmt(m, c, p, stmt, s)
            dropCarry(m, mark)
        }
    }
}

fn movesStmt(m: mut Moves, c: mut Checker, p: Program, stmt: &Stmt, s: mut State) {
    match stmt.kind {
        .Let(pattern, _, value, otherwise) => {
            // `let _ = value` keeps nothing: the value is a temporary, dropped at once.
            let keeps = match pattern.kind {
                .Wildcard => false
                _ => true
            }
            let mark = m.carry.len()
            movesNode(m, c, p, &value, s, if keeps { Use.Move } else { Use.Read })
            let loans = carriedSince(m, mark)
            if let .Some(block) = otherwise {
                var other = s.dup()
                movesBlock(m, c, p, &block, other, .Read)   // never falls through
            }
            m.binding = loans
            patternInit(m, c, &pattern, s, false)
            m.binding = []
        }
        .Var(_, _, value) => {
            let mark = m.carry.len()
            if let .Some(v) = value {
                movesNode(m, c, p, &v, s, .Move)
            }
            let local = c.localAt(stmt.id.0)
            if local >= 0 {
                s.uninit[local] = value.isNone()
                s.moved[local] = false
                killHolder(s, local)
                if m.refLocal[local] {
                    bindLoans(s, local, &carriedSince(m, mark))
                }
            }
        }
        .Assign(op, target, value) => {
            // `x = v` moves `v` into `x`; `x op= v` only reads it (`s += t` appends).
            let mark = m.carry.len()
            movesNode(m, c, p, &value, s, if op == .Assign { Use.Move } else { Use.Read })
            if op != .Assign {   // `x += 1` reads `x` first, then writes it
                m.lastLocal = false
                movesNode(m, c, p, &target, s, .Mutate)
                if m.lastLocal && isPlaceView(c, &target) {
                    access(s, &m.lastPlace, .Write, target.span)
                }
                return
            }
            m.binding = carriedSince(m, mark)
            movesNode(m, c, p, &target, s, .Assign)
            m.binding = []
        }
        .For(_, _, _, _, _, _) => {
            loopBody(m, c, p, stmt, s)
        }
        .Return(value) => {
            if let .Some(v) = value {
                movesNode(m, c, p, &v, s, .Move)
            }
            checkMutParams(m, c, p, &s, stmt.span)
            s.dead = true
        }
        .Break => {
            let last = m.loops.len() - 1
            if last >= 0 {   // else E0309 was reported
                m.loops[last].breaks.join(&s)
            }
            s.dead = true
        }
        .Continue => {
            let last = m.loops.len() - 1
            if last >= 0 {
                useHolder(m, c, s, m.holderBase + last)   // the next iteration
                m.loops[last].continues.join(&s)
            }
            s.dead = true
        }
        .ExprStmt(e) => {
            movesNode(m, c, p, &e, s, .Read)
        }
    }
}

// ---------------------------------------------------------------------------
// Loops

fn isRange(stmt: &Stmt) bool {
    return match stmt.kind {
        .For(_, _, _, _, expr, _) => match expr {
            .Some(e) => match e.kind {
                .Range(_, _, _) => true
                _ => false
            }
            .None => false
        }
        _ => false
    }
}

// One iteration from `entry`: the condition or the iterated value, the
// bindings, the body. Returns the state at the loop's exit.
fn iteration(m: mut Moves, c: mut Checker, p: Program, stmt: &Stmt, entry: &State) State {
    let last = m.loops.len() - 1
    m.loops[last].breaks = deadState()
    m.loops[last].continues = deadState()
    var st = entry.dup()
    var exit = deadState()
    match stmt.kind {
        .For(kind, _, _, second, expr, body) => {
            if kind == .Cond {
                if let .Some(cond) = expr {
                    movesNode(m, c, p, &cond, st, .Read)
                }
                exit = st.dup()   // the condition was false
            } else if kind == .In {
                let first = c.localAt(stmt.id.0)
                var owns = isRange(stmt)
                if !owns {
                    if let .Some(e) = expr {
                        owns = iteratorItem(c, p, viewType(c, &e, -1)).isSome()
                    }
                }
                if owns {   // the variable owns a new item
                    exit = st.dup()
                    if first >= 0 {
                        st.initPart(&Part{local: first, fields: []})
                        bindLoopVar(m, st, first, false, last)
                    }
                } else if first >= 0 {   // the variables borrow the elements
                    m.borrowed[first] = true
                    bindLoopVar(m, st, first, true, last)
                    if second.isSome() {
                        m.borrowed[first + 1] = true
                        bindLoopVar(m, st, first + 1, true, last)
                    }
                    exit = st.dup()
                } else {
                    exit = st.dup()
                }
            }
            movesBlock(m, c, p, &body, st, .Read)
            useHolder(m, c, st, m.holderBase + last)   // the next iteration
        }
        _ => {}
    }
    m.loops[last].continues.join(&st)
    exit.join(&m.loops[last].breaks)
    return exit
}

// A `for` variable holds the loans of the loop: those of the iterator, or
// the borrow of the iterated place, unless it holds a copy.
fn bindLoopVar(m: mut Moves, st: mut State, local: int, borrows: bool, last: int) {
    killHolder(st, local)
    if m.refLocal[local] || (borrows && !m.copyLocal[local]) {
        let loans = loansOf(&st, m.holderBase + last)
        bindLoans(st, local, &loans)
    }
}

// The loans of a `for` loop: those of the iterator, or a borrow of the
// iterated place, shared or, for `for mut`, exclusive.
fn loopLoans(m: mut Moves, c: mut Checker, p: Program, stmt: &Stmt, st: mut State) {
    let holder = m.holderBase + m.loops.len()
    if let StmtKind.For(kind, mutable, _, _, expr, _) = stmt.kind {
        if kind != .In {
            return
        }
        if let .Some(e) = expr {
            let mark = m.carry.len()
            m.lastLocal = false
            movesNode(m, c, p, &e, st, .Read)   // evaluated once, borrowed
            var loans = carriedSince(m, mark)
            dropCarry(m, mark)
            let owns = isRange(stmt) || iteratorItem(c, p, viewType(c, &e, -1)).isSome()
            if !owns && m.lastLocal && isPlaceView(c, &e) {
                if mutable {
                    access(st, &m.lastPlace, .BorrowMut, e.span)
                }
                loans.push(Loan{holder, part: m.lastPlace.clone(), mutable, span: e.span})
            }
            bindLoans(st, holder, &loans)
        }
    }
}

// The state at the start of an iteration is the entry state joined with
// the states at the end of every iteration. The first walk reports; when
// an iteration changes that state (it moves or initializes something),
// the loop is walked without reporting until the state is stable, then
// once more to report. Errors reported twice are rendered once.
fn loopBody(m: mut Moves, c: mut Checker, p: Program, stmt: &Stmt, st: mut State) {
    loopLoans(m, c, p, stmt, st)
    m.loops.push(LoopFrame{breaks: deadState(), continues: deadState()})
    let last = m.loops.len() - 1
    var entry = st.dup()
    var exit = iteration(m, c, p, stmt, &entry)
    var next = entry.dup()
    next.join(&m.loops[last].continues)
    if !next.equals(&entry) {
        let report = m.report
        m.report = false
        var round = 0
        for round < 16 && !next.equals(&entry) {
            entry = mem.replace(next, deadState())
            iteration(m, c, p, stmt, &entry)
            next = entry.dup()
            next.join(&m.loops[last].continues)
            round += 1
        }
        m.report = report
        exit = iteration(m, c, p, stmt, &entry)
    }
    st.replace(exit)
    let _ = m.loops.pop()
    killHolder(st, m.holderBase + m.loops.len())
}

/**
 * Runs the analysis on a function whose body was just checked, and keeps
 * what the lowering needs.
 *
 * @param c the checker, with the function's locals and types
 * @param p the program
 * @param id the function's `DefId`
 */
pub fn checkMoves(c: mut Checker, p: Program, id: int) {
    let decl = fnOf(p, c.loc(id))
    if decl.body.isNone() {
        return
    }
    let count = c.locals.len()
    var refLocal = List.filled(false, count)
    var copyLocal = List.filled(false, count)
    for i in 0..count {
        if i < c.localTypes.len() {
            let ty = c.localTypes[i]
            refLocal[i] = holdsRef(c, p, ty)
            copyLocal[i] = isCopy(c, p, ty)
        }
    }
    var m = Moves{fnDef: id, report: true, borrowed: List.filled(false, count), loops: [],
                  allParts: [], refLocal, copyLocal, holderBase: count, carry: [],
                  binding: [], lastPlace: Part{local: 0, fields: []}, lastLocal: false}
    if decl.hasSelf && decl.selfMode == .Borrow && count > 0 {
        m.borrowed[0] = true
    }
    for i in 0..decl.params.len() {
        let local = c.localAt(decl.params[i].id.0)
        if decl.params[i].mode == .Borrow && local >= 0 {
            m.borrowed[local] = true
        }
    }
    var s = newState(count)
    match decl.body {
        .Some(body) => movesBlock(m, c, p, &body, s, .Read)
        .None => {}
    }
    checkMutParams(m, c, p, &s, decl.span)
    c.fnMoves.insert(id, FnMoves{borrowed: mem.replace(m.borrowed, []),
                                 parts: mem.replace(m.allParts, [])})
}
