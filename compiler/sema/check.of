import base.span.Span
import diag.noSpan
import sema.check_ref.checkBorrowSource
import sema.check_stmt.checkBlock
import sema.check_unsafe.checkCSignature
import sema.check_types.fnSignature
import sema.check_types.ownerTypeOf
import sema.check_types.resolveType
import sema.const_eval.ConstValue
import sema.def.Def
import sema.def.DefKind
import sema.def.Local
import sema.def.Res
import sema.enums.EnumInfo
import sema.enums.checkEnumLayouts
import sema.enums.enumVariants
import sema.expr_check.checkConst
import sema.interfaces.unsatisfied
import sema.moves.FnMoves
import sema.moves.checkMoves
import sema.program.Program
import sema.resolve.Resolver
import sema.resolve.findAttribute
import sema.resolve.moduleInStd
import sema.structs.StructInfo
import sema.structs.checkStructLayouts
import sema.structs.structFields
import sema.types.ERROR
import sema.types.NEVER
import sema.types.TyKind
import sema.types.TypeTable
import sema.types.UNIT
import syntax.ast.FnDecl
import syntax.ast.Item
import syntax.ast.ItemKind
import syntax.ast.Mode
import syntax.ast.TypeExpr
import syntax.ast.TypeKind
import syntax.ast.WherePred
import syntax.ast_text.typeText
import std.mem

/**
 * What the checker knows of a declaration.
 */
pub struct DefInfo {
    /** A function's signature, a constant's type, an alias's type. */
    pub ty: int
    /** `ty` is known. */
    pub typed: bool
    /** Being computed: a cycle guard. */
    pub checking: bool
    /** A struct's fields, once computed. */
    pub fields: Option<Box<StructInfo>>
    /** An enum's variants, once computed. */
    pub variants: Option<Box<EnumInfo>>
    /** A constant's value, when it could be computed. */
    pub value: Option<ConstValue>
    /** A function that returns a reference (spec 5.6). */
    pub returnsBorrow: bool
    /** The parameter it borrows from; -1 for `self`. */
    pub borrowSource: int
    /** That parameter is borrowed, not a reference itself. */
    pub sourceByRef: bool
}

/**
 * The type parameters in scope: those of the type declaring the method,
 * numbered first, then those of the function (spec 8.3).
 */
pub struct Generics {
    /** The type's parameters. */
    pub owner: List<Symbol>
    /** The function's own parameters. */
    pub fnParams: List<Symbol>
    /** The bounds of each parameter, numbered as above: `BOUND_EQ`, ... (spec 8.1). */
    pub bounds: List<int>
    /** The interfaces each parameter is bounded by, as `DefId`s (spec 9.6). */
    pub ifaces: List<List<int>>
    /** Actual arguments when expanding an alias; empty for generic declarations. */
    pub aliasArgs: List<int>
}

/**
 * No type parameters.
 *
 * @returns the empty generics
 */
pub fn noGenerics() Generics {
    return Generics{owner: [], fnParams: [], bounds: [], ifaces: [], aliasArgs: []}
}

/** The built-in interfaces a bound can name until interfaces (roadmap 5.3), as bits. */
pub const BOUND_EQ: int = 1
/** `Ord`: `<`, `<=`, `>`, `>=` and `sort`. */
pub const BOUND_ORD: int = 2
/** `Hash`: with `Eq`, `Map` keys. */
pub const BOUND_HASH: int = 4
/** `Clone`: `.clone()`. */
pub const BOUND_CLONE: int = 8

/**
 * The bit of the built-in interface a bound names, or 0.
 *
 * @param c the checker
 * @param t the bound
 * @returns `BOUND_EQ`, `BOUND_ORD`, `BOUND_HASH`, `BOUND_CLONE` or 0
 */
pub fn boundBit(c: Checker, t: &TypeExpr) int {
    let name = match t.kind {
        TypeKind.Path(segments, args) => if segments.len() == 1 && args.len() == 0 {
            segments[0]
        } else {
            return 0
        }
        _ => {
            return 0
        }
    }
    let text = c.text(name)
    return if text == "Eq" {
        BOUND_EQ
    } else if text == "Ord" {
        BOUND_ORD
    } else if text == "Hash" {
        BOUND_HASH
    } else if text == "Clone" {
        BOUND_CLONE
    } else {
        0
    }
}

/**
 * The number of the type parameter a bounded type names, or -1.
 *
 * @param t the bounded type
 * @param owner the type's parameters
 * @param fnParams the function's own
 * @returns its number: the type's first, then the function's
 */
pub fn boundedParam(t: &TypeExpr, owner: &List<Symbol>, fnParams: &List<Symbol>) int {
    let name = match t.kind {
        TypeKind.Path(segments, args) => if segments.len() == 1 && args.len() == 0 {
            segments[0]
        } else {
            return -1
        }
        _ => {
            return -1
        }
    }
    for i in 0..fnParams.len() {
        if fnParams[i].0 == name.0 {
            return owner.len() + i
        }
    }
    for i in 0..owner.len() {
        if owner[i].0 == name.0 {
            return i
        }
    }
    return -1
}

/**
 * The interface a bound names, `Name` or `module.Name`, or 0 when it names
 * none (built-in bounds included).
 *
 * @param c the checker, in the module of the bound
 * @param t the bound
 * @returns the interface's `DefId`, or 0
 */
pub fn interfaceOf(c: Checker, t: &TypeExpr) int {
    return match t.kind {
        TypeKind.Path(segments, args) => if args.len() == 0 {
            interfaceAt(c, &segments)
        } else {
            0
        }
        _ => 0
    }
}

fn interfaceAt(c: Checker, segments: &List<Symbol>) int {
    var id = c.r.scope.module(segments[0])
    if segments.len() == 2 && id != 0 && c.def(id).kind == DefKind.Module {
        let target = c.def(id).target
        id = c.r.scope.moduleIn(target, segments[1])
        if id != 0 && c.def(id).module != target {   // an import of that module
            return 0
        }
    } else if segments.len() != 1 {
        return 0
    }
    return if id != 0 && c.def(id).kind == DefKind.Interface { id } else { 0 }
}

// Empty interface lists, one per type parameter.
fn noIfaces(n: int) List<List<int>> {
    var ifaces: List<List<int>> = []
    for _ in 0..n {
        ifaces.push([])
    }
    return ifaces
}

fn addBounds(c: Checker, preds: &List<WherePred>, owner: &List<Symbol>,
             fnParams: &List<Symbol>, bounds: mut List<int>, ifaces: mut List<List<int>>) {
    for i in 0..preds.len() {
        let index = boundedParam(&preds[i].ty, owner, fnParams)
        if index < 0 {
            continue   // E0334, reported with the declaration
        }
        for j in 0..preds[i].bounds.len() {
            bounds[index] = bounds[index] | boundBit(c, &preds[i].bounds[j])
            let iface = interfaceOf(c, &preds[i].bounds[j])
            if iface != 0 {
                ifaces[index].push(iface)
            }
        }
    }
}

/**
 * The `DefId` of an interface declaration.
 *
 * @param c the checker
 * @param item the interface
 * @returns its `DefId`, or 0
 */
pub fn interfaceDef(c: Checker, item: &Item) int {
    for id in 1..c.r.defs.len() {
        let def = &c.r.defs[id]
        let sameSpan = def.span.file.0 == item.span.file.0 && def.span.start == item.span.start
        if def.kind == DefKind.Interface && sameSpan {
            return id
        }
    }
    return 0
}

/**
 * The type parameters of a struct or enum, with their bounds; none for
 * other items.
 *
 * @param c the checker
 * @param item the item
 * @returns them
 */
pub fn typeGenerics(c: Checker, item: &Item) Generics {
    let owner = itemTypeParams(item)
    var bounds = List.filled(0, owner.len())
    var ifaces = noIfaces(owner.len())
    let none: List<Symbol> = []
    addBounds(c, &item.bounds, &owner, &none, bounds, ifaces)
    let isInterface = match item.kind {
        ItemKind.Interface(_, _, _) => true
        _ => false
    }
    if isInterface {   // `Self` satisfies the interface it is declared in
        ifaces[0].push(interfaceDef(c, item))
    }
    return Generics{owner, fnParams: [], bounds, ifaces, aliasArgs: []}
}

/**
 * The type parameters of a function declared in `outer`: the type's, then
 * its own, with their bounds and those of its `where` clause.
 *
 * @param c the checker
 * @param outer the type's parameters
 * @param decl the function
 * @returns them
 */
pub fn fnGenericsIn(c: Checker, outer: &Generics, decl: &FnDecl) Generics {
    var bounds = List.filled(0, outer.owner.len() + decl.typeParams.len())
    var ifaces = noIfaces(outer.owner.len() + decl.typeParams.len())
    for i in 0..outer.owner.len() {
        if i < outer.bounds.len() {
            bounds[i] = outer.bounds[i]
        }
        if i < outer.ifaces.len() {
            ifaces[i] = outer.ifaces[i].clone()
        }
    }
    addBounds(c, &decl.bounds, &outer.owner, &decl.typeParams, bounds, ifaces)
    return Generics{owner: outer.owner.clone(), fnParams: decl.typeParams.clone(), bounds,
                    ifaces, aliasArgs: []}
}

/**
 * The checker's state and results.
 */
pub struct Checker {
    /** The resolver, with the declarations, the scopes and the tables. */
    pub r: Resolver
    /** Every type of the program. */
    pub types: TypeTable
    /** What is known of each declaration, by `DefId`. */
    pub info: List<DefInfo>
    /** The `DefId` of each item of each module, or 0. */
    pub itemDefs: List<List<int>>
    /** The type of each expression and pattern, by module and `NodeId`. */
    pub nodeTypes: List<List<int>>
    /** The types of the locals of each function, by module and the `NodeId` of the function. */
    pub localTypesOf: List<Map<int, List<int>>>
    /** The implicit dereferences of an expression's value, by module and `NodeId`: the
     * type before each one (a `&T` or a `Box<T>`), in order (stage 0 inserts `*e`). */
    pub derefs: List<Map<int, List<int>>>
    /** The type of an expression's value after its implicit dereferences. */
    pub adjusted: List<Map<int, int>>
    /** By module and `NodeId`: the field of `a.f` and `a.0`, the variant of a variant
     * expression or pattern, the method (`DefId`) of a method call's callee, or -1. */
    pub members: List<List<int>>
    /** The type arguments of each generic call, as a tuple type, by module and `NodeId`. */
    pub callTypeArgs: List<Map<int, int>>
    /** The values converted from `List<T>` to `&[T]` (`list.asSlice()`), by module:
     * `NodeId` to the element type. */
    pub sliceCoercions: List<Map<int, int>>
    /** The values converted to `&dyn I`, `*dyn I` or `Box<dyn I>`, by module: `NodeId` to
     * the type before the conversion. */
    pub dynCoercions: List<Map<int, int>>
    /** What the move analysis found, by module and `NodeId`: `moves.MOVES`, `moves.CONSUMED`. */
    pub moveFlags: List<Map<int, int>>
    /** The std functions checked with the root whose move analysis waits for the lowering. */
    pub movesPending: Map<int, bool>
    /** The functions whose body was checked, by `DefId`. */
    pub bodyChecked: Map<int, bool>
    /** What the move analysis found of each function, by `DefId`. */
    pub fnMoves: Map<int, FnMoves>
    /** The type parameters in scope. */
    pub generics: Generics
    /** The locals of the function being checked. */
    pub locals: List<Local>
    /** Their types. */
    pub localTypes: List<int>
    /** The function's return type. */
    pub ret: int
    /** The type declaring the method, or `ERROR`. */
    pub selfType: int
    /** Per open loop: whether a `break` leaves it. */
    pub loops: List<bool>
    /** Above 0 inside an `unsafe` block or function. */
    pub unsafeDepth: int
    /** The `NodeId` of the function being checked, or -1. */
    pub fnNode: int
    /** Its `DefId`, or 0. */
    pub fnDef: int
    /** The struct literal being checked: where its shorthand fields `P\{x\}` are. */
    pub shorthandSpan: Span
    /** The closures being checked, innermost last: their `NodeId`s. */
    pub closures: List<int>
    /** Whether each of them is a `move` closure. */
    pub closureMoves: List<bool>
    /** Per module, per closure `NodeId`: the captured locals it modifies,
     * captured by `&mut` (spec 10.3). */
    pub capturesMut: List<Map<int, List<int>>>

    /**
     * Reports an error.
     *
     * @param code its code
     * @param span where
     * @param message what
     */
    pub fn error(mut self, code: str, span: Span, message: move str) {
        self.r.diags.error(code, span, message)
    }

    /**
     * Reports a construct the checker does not implement (E0901).
     *
     * @param span where
     * @param what what is not supported, ending with its verb (`"... are"`)
     * @returns the error type
     */
    pub fn unsupported(mut self, span: Span, what: str) int {
        self.error("E0901", span, "{what} not supported yet")
        return ERROR
    }

    /**
     * The text of a name.
     *
     * @param name the name
     * @returns its text
     */
    pub fn text(self, name: Symbol) str {
        return self.r.names.name(name)
    }

    /**
     * The name of a type parameter as written: an anonymous one
     * (`Shape 1`, ADR 0029) prints as its interface.
     *
     * @param name the parameter's name
     * @returns the text
     */
    pub fn paramText(self, name: Symbol) str {
        let text = self.r.names.name(name)
        if let Option.Some(at) = text.find(" ") {
            return text.slice(0, at)
        }
        return text
    }

    /**
     * A declaration.
     *
     * @param id its `DefId`
     * @returns it
     */
    pub fn def(self, id: int) &Def {
        return &self.r.defs[id]
    }

    /**
     * Where a declaration is.
     *
     * @param id its `DefId`
     * @returns its location
     */
    pub fn loc(self, id: int) Loc {
        let def = &self.r.defs[id]
        return Loc{module: def.module, item: def.item, member: def.member}
    }

    /**
     * The module being checked.
     *
     * @returns its index
     */
    pub fn module(self) int {
        return self.r.current
    }

    /**
     * Makes module `m` the current one.
     *
     * @param m a module
     * @returns the previous one
     */
    pub fn enter(mut self, m: int) int {
        let previous = self.r.current
        self.r.current = m
        self.r.moduleName = self.r.moduleNames[m].clone()
        self.r.scope.useModule(m)
        return previous
    }

    /**
     * What a node's name resolves to, in the current module.
     *
     * @param id the node's number
     * @returns the resolution
     */
    pub fn res(self, id: int) Res {
        return self.r.tables[self.r.current].res[id]
    }

    /**
     * The local a node declares, in the current module.
     *
     * @param id the node's number
     * @returns its index, or -1
     */
    pub fn localAt(self, id: int) int {
        return self.r.tables[self.r.current].locals[id]
    }

    /**
     * The type found for a node of the current module.
     *
     * @param id the node's number
     * @returns its type
     */
    pub fn typeOf(self, id: int) int {
        return self.nodeTypes[self.r.current][id]
    }

    /**
     * Records the type of a node of the current module.
     *
     * @param id the node's number
     * @param ty its type
     */
    pub fn setType(mut self, id: int, ty: int) {
        self.nodeTypes[self.r.current][id] = ty
    }

    /**
     * Records the field, variant or method of a node of the current module.
     *
     * @param id the node's number
     * @param member its index or `DefId`
     */
    pub fn setMember(mut self, id: int, member: int) {
        self.members[self.r.current][id] = member
    }

    /**
     * Makes `generics` the type parameters in scope.
     *
     * @param generics the new ones
     * @returns the previous ones
     */
    pub fn enterGenerics(mut self, generics: move Generics) Generics {
        return mem.replace(self.generics, generics)
    }

    /**
     * The spelling of a type for messages: `&mut List<int>`.
     *
     * @param ty the type
     * @returns its text
     */
    pub fn typeName(self, ty: int) str {
        var out = ""
        self.appendType(out, ty, false)
        return out
    }

    /**
     * The spelling of a type with the structs and enums of modules other
     * than the root qualified by their module: `Pair<int, geo.Point>`, as
     * in the names of instances in LLVM IR.
     *
     * @param ty the type
     * @returns its text
     */
    pub fn qualifiedTypeName(self, ty: int) str {
        var out = ""
        self.appendType(out, ty, true)
        return out
    }

    fn appendList(self, out: mut str, args: &List<int>, qualified: bool) {
        for i in 0..args.len() {
            if i > 0 {
                out.push(", ")
            }
            self.appendType(out, args[i], qualified)
        }
    }

    fn appendType(self, out: mut str, ty: int, qualified: bool) {
        let t = self.types.get(ty)
        match t.kind {
            TyKind.Error => out.push("\{error\}")
            TyKind.Unit => out.push("()")
            TyKind.Never => out.push("!")
            TyKind.Bool => out.push("bool")
            TyKind.Int => out.push(intName(t.data))
            TyKind.Float => out.push(if t.data == 64 { "float" } else { "f32" })
            TyKind.Str => out.push("str")
            TyKind.Ref | TyKind.Ptr => {
                out.push(if t.kind == TyKind.Ref { "&" } else { "*" })
                out.push(if t.data != 0 { "mut " } else { "" })
                self.appendType(out, t.inner, qualified)
            }
            TyKind.Slice | TyKind.Array => {
                out.push("[")
                self.appendType(out, t.inner, qualified)
                if t.kind == TyKind.Array {
                    out.push("; {t.data}")
                }
                out.push("]")
            }
            TyKind.Tuple => {
                out.push("(")
                self.appendList(out, &t.args, qualified)
                out.push(if t.args.len() == 1 { ",)" } else { ")" })
            }
            TyKind.Fn => {
                out.push("fn(")
                self.appendList(out, &t.args, qualified)
                out.push(")")
                if t.inner != UNIT {
                    out.push(" ")
                    self.appendType(out, t.inner, qualified)
                }
            }
            TyKind.Adt | TyKind.Dyn => {
                if t.kind == TyKind.Dyn {
                    out.push("dyn ")
                }
                let module = self.r.defs[t.data].module
                if qualified && module != 0 {
                    out.push(self.r.moduleNames[module])
                    out.push(".")
                }
                out.push(self.text(self.r.defs[t.data].name))
                if t.args.len() > 0 {
                    out.push("<")
                    self.appendList(out, &t.args, qualified)
                    out.push(">")
                }
            }
            TyKind.Param => out.push(self.paramText(Symbol(t.inner)))
        }
    }
}

// The 64-bit types are printed with their usual alias names.
fn intName(kind: int) str {
    let names = ["i8", "i16", "i32", "int", "u8", "u16", "u32", "uint"]
    return names[kind].sliceFrom(0)
}

/**
 * Where a declaration is: its module, item and member.
 */
pub copy struct Loc {
    /** The module. */
    pub module: int
    /** The item in it. */
    pub item: int
    /** The method, `extern` function or variant in the item, or -1. */
    pub member: int
}

/**
 * The item a declaration comes from.
 *
 * @param p the program
 * @param def the declaration
 * @returns its item
 */
pub fn itemOf(p: Program, def: Loc) &Item {
    return &p.modules[def.module].module.items[def.item]
}

/**
 * The type parameters of a struct or enum; none for other items.
 *
 * @param item the item
 * @returns their names
 */
pub fn itemTypeParams(item: &Item) List<Symbol> {
    return match item.kind {
        ItemKind.Struct(_, _, _, typeParams, _, _) => typeParams.clone()
        ItemKind.Enum(_, typeParams, _, _) => typeParams.clone()
        ItemKind.Interface(typeParams, _, _) => typeParams.clone()   // `Self` first
        _ => []
    }
}

/**
 * The function a function declaration comes from: an item, a method or a
 * function of an `extern` block.
 *
 * @param p the program
 * @param def a declaration of kind `Fn`
 * @returns the function
 */
pub fn fnOf(p: Program, def: Loc) &FnDecl {
    let item = &p.modules[def.module].module.items[def.item]
    return match item.kind {
        ItemKind.Fn(decl) => &*decl
        ItemKind.Struct(_, _, _, _, _, methods) => &methods[def.member]
        ItemKind.Enum(_, _, _, methods) => &methods[def.member]
        ItemKind.Extern(_, fns) => &fns[def.member]
        ItemKind.Interface(_, _, methods) => &methods[def.member]
        _ => {
            panic("fnOf: not a function")
        }
    }
}

fn emptyInfo() DefInfo {
    return DefInfo{ty: ERROR, typed: false, checking: false, fields: Option.None,
                   variants: Option.None,
                   value: Option.None, returnsBorrow: false, borrowSource: -1, sourceByRef: false}
}

/**
 * A checker for a resolved program.
 *
 * @param p the program
 * @param r the resolver, with its results
 * @returns the checker
 */
pub fn newChecker(p: Program, r: move Resolver) Checker {
    var info: List<DefInfo> = []
    var itemDefs: List<List<int>> = []
    var nodeTypes: List<List<int>> = []
    var localTypesOf: List<Map<int, List<int>>> = []
    var derefs: List<Map<int, List<int>>> = []
    var adjusted: List<Map<int, int>> = []
    var members: List<List<int>> = []
    var callTypeArgs: List<Map<int, int>> = []
    var sliceCoercions: List<Map<int, int>> = []
    var dynCoercions: List<Map<int, int>> = []
    var moveFlags: List<Map<int, int>> = []
    var capturesMut: List<Map<int, List<int>>> = []
    for m in 0..p.modules.len() {
        itemDefs.push(List.filled(0, p.modules[m].module.items.len()))
        nodeTypes.push(List.filled(ERROR, p.modules[m].module.nodeCount))
        localTypesOf.push(Map.new())
        derefs.push(Map.new())
        adjusted.push(Map.new())
        members.push(List.filled(-1, p.modules[m].module.nodeCount))
        callTypeArgs.push(Map.new())
        sliceCoercions.push(Map.new())
        dynCoercions.push(Map.new())
        moveFlags.push(Map.new())
        capturesMut.push(Map.new())
    }
    for id in 0..r.defs.len() {
        info.push(emptyInfo())
        let def = &r.defs[id]
        let named = def.kind != DefKind.Module && def.kind != DefKind.Variant && def.member < 0
        if id > 0 && named && def.item >= 0 && itemDefs[def.module][def.item] == 0 {
            itemDefs[def.module][def.item] = id
        }
    }
    return Checker{r, types: TypeTable.new(), info, itemDefs, nodeTypes, localTypesOf, derefs,
                   adjusted,
                   members, callTypeArgs, sliceCoercions, dynCoercions, moveFlags,
                   fnMoves: Map.new(),
                   bodyChecked: Map.new(), movesPending: Map.new(),
                   generics: noGenerics(), locals: [], localTypes: [], ret: UNIT,
                   selfType: ERROR, loops: [], unsafeDepth: 0, fnNode: -1, fnDef: 0,
                   shorthandSpan: noSpan(), closures: [], closureMoves: [], capturesMut}
}

// ---------------------------------------------------------------------------
// Functions

/**
 * Checks a function's signature and, unless it is a std function outside
 * the root, its body.
 *
 * @param c the checker
 * @param p the program
 * @param id the function's `DefId`
 * @param selfType the type declaring the method, or `ERROR`
 */
pub fn checkFn(c: mut Checker, p: Program, id: int, selfType: int) {
    let decl = fnOf(p, c.loc(id))
    let inner = fnGenericsIn(c, &c.generics, decl)
    let outer = c.enterGenerics(inner)
    checkDeclBounds(c, &decl.bounds)
    let sig = fnSignature(c, p, id)
    checkBorrowSource(c, p, id, sig, selfType)   // what callers need, now
    c.enterGenerics(outer)
    if decl.body.isSome() && c.module() != 0 && moduleInStd(p, c.module()) {
        return   // a program uses few std functions: the lowering checks them
    }
    checkBody(c, p, id, selfType, false)
}

/**
 * Checks the body of a std function the lowering reached (stage 0:
 * `sema_check_late`), then runs its move analysis; once per function.
 *
 * @param c the checker
 * @param p the program
 * @param id the function's `DefId`
 */
pub fn checkLate(c: mut Checker, p: Program, id: int) {
    if c.movesPending.get(id).isSome() {   // checked with the root, analyzed now
        let _ = c.movesPending.remove(id)
        lateMoves(c, p, id)
        return
    }
    if c.bodyChecked.get(id).isSome() || fnOf(p, c.loc(id)).body.isNone() {
        return
    }
    let module = c.def(id).module
    let member = c.def(id).member
    let previous = c.enter(module)
    var selfType = ERROR
    var owner = noGenerics()
    if member >= 0 {
        let item = itemOf(p, c.loc(id))
        let isType = match item.kind {
            ItemKind.Struct(_, _, _, _, _, _) | ItemKind.Enum(_, _, _, _) |
            ItemKind.Interface(_, _, _) => true
            _ => false
        }
        if isType {
            selfType = ownerTypeOf(c, p, module, c.def(id).item)
            owner = typeGenerics(c, itemOf(p, c.loc(id)))
        }
    }
    let outer = c.enterGenerics(owner)
    checkBody(c, p, id, selfType, true)
    c.enterGenerics(outer)
    c.enter(previous)
}

// The move analysis of a std function checked with the root module (stage
// 0: `sema_moves_late`), with the function's locals and their types.
fn lateMoves(c: mut Checker, p: Program, id: int) {
    let decl = fnOf(p, c.loc(id))
    let module = c.def(id).module
    let previous = c.enter(module)
    c.locals = match c.r.tables[module].fnLocals.get(decl.id.0) {
        Option.Some(list) => list.clone()
        Option.None => []
    }
    c.localTypes = match c.localTypesOf[module].get(decl.id.0) {
        Option.Some(list) => list.clone()
        Option.None => []
    }
    c.fnNode = decl.id.0
    c.fnDef = id
    checkMoves(c, p, id)
    c.enter(previous)
}

fn checkBody(c: mut Checker, p: Program, id: int, selfType: int, late: bool) {
    c.bodyChecked.insert(id, true)
    let decl = fnOf(p, c.loc(id))
    let inner = fnGenericsIn(c, &c.generics, decl)
    let outer = c.enterGenerics(inner)
    let sig = fnSignature(c, p, id)
    let locals = c.r.tables[c.module()].fnLocals.get(decl.id.0)
    c.locals = match locals {
        Option.Some(list) => list.clone()
        Option.None => []
    }
    c.localTypes = List.filled(ERROR, c.locals.len())
    c.ret = c.types.get(sig).inner
    c.selfType = selfType
    c.fnNode = decl.id.0
    c.fnDef = id
    if decl.hasSelf && c.localTypes.len() > 0 {
        c.localTypes[0] = selfType
    }
    for i in 0..decl.params.len() {
        let local = c.localAt(decl.params[i].id.0)
        if local >= 0 {
            c.localTypes[local] = c.types.get(sig).args[i]
        }
    }
    if decl.body.isNone() {
        c.enterGenerics(outer)
        return
    }
    c.unsafeDepth = if decl.isUnsafe { 1 } else { 0 }
    let errors = c.r.diags.errorCount()
    var found = UNIT
    if let Option.Some(body) = decl.body {
        found = checkBlock(c, p, &body, ERROR, false)
    }
    c.unsafeDepth = 0
    if c.ret != UNIT && c.ret != ERROR && found != NEVER {
        c.error("E0303", decl.span,
                "function may reach its end without returning a value".toOwned())
    }
    // No cascade after type errors; std functions wait until the lowering reaches them.
    if c.r.diags.errorCount() == errors {
        if late || !moduleInStd(p, c.module()) {
            checkMoves(c, p, id)
        } else {
            c.movesPending.insert(id, true)
        }
    }
    let types = mem.replace(c.localTypes, [])
    c.localTypesOf[c.module()].insert(decl.id.0, types)
    c.enterGenerics(outer)
}

// ---------------------------------------------------------------------------
// Items

fn checkMethods(c: mut Checker, p: Program, index: int, methods: &List<FnDecl>) {
    let item = &p.modules[c.module()].module.items[index]
    let selfType = ownerTypeOf(c, p, c.module(), index)
    let outer = c.enterGenerics(typeGenerics(c, item))
    for i in 0..methods.len() {
        let def = c.r.tables[c.module()].fnDefs[methods[i].id.0]
        if def != 0 {
            checkFn(c, p, def, selfType)
        }
    }
    c.enterGenerics(outer)
}

// `extern "C"` blocks cross the C boundary; `extern "intrinsic"` blocks,
// reserved to std, declare operations the compiler generates.
fn checkExtern(c: mut Checker, p: Program, item: &Item, abi: str, fns: &List<FnDecl>) {
    if abi == "intrinsic" {
        if !c.r.moduleName.startsWith("std") {
            c.error("E0805", item.span,
                    "intrinsics are reserved to the standard library".toOwned())
        }
        for i in 0..fns.len() {
            fnSignature(c, p, c.r.tables[c.module()].fnDefs[fns[i].id.0])
        }
        return
    }
    if abi != "C" {
        c.error("E0804", item.span, "unknown ABI: only `extern \"C\"` is supported".toOwned())
    }
    for i in 0..fns.len() {
        checkCSignature(c, p, c.r.tables[c.module()].fnDefs[fns[i].id.0])
    }
}

/**
 * Reports the bounds that name no type parameter in scope (E0334) or no
 * interface (E0333).
 *
 * @param c the checker, with the declaration's parameters in scope
 * @param preds the bounds
 */
pub fn checkDeclBounds(c: mut Checker, preds: &List<WherePred>) {
    for i in 0..preds.len() {
        let pred = &preds[i]
        if boundedParam(&pred.ty, &c.generics.owner, &c.generics.fnParams) < 0 {
            c.error("E0334", pred.ty.span, "`{typeText(&pred.ty, c.r.names)}` is not a type "
                    + "parameter of this declaration: only type parameters take bounds")
        }
        for j in 0..pred.bounds.len() {
            if boundBit(c, &pred.bounds[j]) == 0 && interfaceOf(c, &pred.bounds[j]) == 0 {
                c.error("E0333", pred.bounds[j].span, "`{typeText(&pred.bounds[j], c.r.names)}` "
                        + "is not an interface")
            }
        }
    }
}

fn checkTypeBounds(c: mut Checker, item: &Item) {
    let outer = c.enterGenerics(typeGenerics(c, item))
    checkDeclBounds(c, &item.bounds)
    c.enterGenerics(outer)
}

fn checkItem(c: mut Checker, p: Program, index: int) {
    let item = &p.modules[c.module()].module.items[index]
    let id = c.itemDefs[c.module()][index]
    match item.kind {
        ItemKind.Fn(decl) => {
            let def = c.r.tables[c.module()].fnDefs[decl.id.0]
            if def == 0 {
                return
            }
            if decl.abi.len() > 0 {   // `extern "C" fn` with a body, called from C
                checkCSignature(c, p, def)
            }
            checkFn(c, p, def, ERROR)
        }
        ItemKind.Extern(abi, fns) => checkExtern(c, p, item, abi, &fns)
        ItemKind.Struct(_, _, _, _, _, methods) => {
            checkTypeBounds(c, item)
            if id != 0 {
                structFields(c, p, id)
                checkStructLayouts(c, p, id)
            }
            checkMethods(c, p, index, &methods)
            checkAsserts(c, p, index)
        }
        ItemKind.Enum(_, _, _, methods) => {
            checkTypeBounds(c, item)
            if id != 0 {
                enumVariants(c, p, id)
                checkEnumLayouts(c, p, id)
            }
            checkMethods(c, p, index, &methods)
            checkAsserts(c, p, index)
        }
        ItemKind.Const(_, _) | ItemKind.Global(_, _) => {
            if id != 0 {
                checkConst(c, p, id)
            }
        }
        ItemKind.Interface(_, _, methods) => checkInterface(c, p, index, &methods)
        ItemKind.TypeAlias(_, _) | ItemKind.Import(_, _) => {}
    }
}

// An interface: not generic beyond `Self`, embedding only interfaces, with
// its default methods checked once, generically over `Self`.
fn checkInterface(c: mut Checker, p: Program, index: int, methods: &List<FnDecl>) {
    let item = &p.modules[c.module()].module.items[index]
    if itemTypeParams(item).len() > 1 {
        c.unsupported(item.span, "generic interfaces are")
        return
    }
    match item.kind {
        ItemKind.Interface(_, embeds, _) => notInterfaces(c, &embeds)
        _ => {}
    }
    checkMethods(c, p, index, methods)
}

// E0333 for each type named where only interfaces go.
fn notInterfaces(c: mut Checker, list: &List<TypeExpr>) {
    for i in 0..list.len() {
        if interfaceOf(c, &list[i]) == 0 {
            c.error("E0333", list[i].span, "`{typeText(&list[i], c.r.names)}` is not an "
                    + "interface")
        }
    }
}

// `struct C: Shape`: E0335 unless the type satisfies each interface it
// asserts (spec 9.2).
fn checkAsserts(c: mut Checker, p: Program, index: int) {
    let item = &p.modules[c.module()].module.items[index]
    if item.asserts.len() == 0 || c.itemDefs[c.module()][index] == 0 {
        return
    }
    notInterfaces(c, &item.asserts)
    let ty = ownerTypeOf(c, p, c.module(), index)
    for i in 0..item.asserts.len() {
        let iface = interfaceOf(c, &item.asserts[i])
        if iface == 0 {
            continue
        }
        let why = unsatisfied(c, p, ty, iface)
        if why.len() > 0 {
            c.error("E0335", item.asserts[i].span, "the type `{c.typeName(ty)}` does not "
                    + "satisfy `{c.text(c.def(iface).name)}`: {why}")
        }
    }
}

/**
 * A `@test` function that this build does not check (spec 12.2).
 *
 * @param c the checker
 * @param p the program
 * @param item an item of the current module
 * @returns true to skip it
 */
pub fn skippedTest(c: Checker, p: Program, item: &Item) bool {
    let isFn = match item.kind {
        ItemKind.Fn(_) => true
        _ => false
    }
    if !isFn || findAttribute(c.r, item.attributes, "test").isNone() {
        return false
    }
    let tested = c.module() == 0 || !moduleInStd(p, c.module())
    return !c.r.testing || !tested
}

/**
 * Checks every module of a program.
 *
 * @param p the program
 * @param r the resolver, with its results
 * @returns the checker, with its results
 */
pub fn checkProgram(p: Program, r: move Resolver) Checker {
    var c = newChecker(p, r)
    for m in 0..p.modules.len() {
        c.enter(m)
        for i in 0..p.modules[m].module.items.len() {
            if !skippedTest(c, p, &p.modules[m].module.items[i]) {
                checkItem(c, p, i)
            }
        }
    }
    c.enter(0)
    warnUnusedImports(c, p)
    return c
}

fn warnUnusedImports(c: mut Checker, p: Program) {
    for i in 0..c.r.imports.len() {
        let use = &c.r.imports[i]
        // std modules other than the root are checked in part: they are
        // checked whole as roots.
        let partlyChecked = use.module != 0 && moduleInStd(p, use.module)
        let preludeRoot = c.r.moduleNames[use.module] == "std.core"
        if !use.used && !preludeRoot && !partlyChecked {
            let span = use.span
            let name = c.text(use.name).toOwned()
            c.r.diags.warning("W0002", span, "unused import `{name}`")
        }
    }
}
