/**
 * @module
 * Dereferencing boxes and references (stage 0:
 * bootstrap/src/sema/check_box.c). `*b` reads the value of a `Box<T>`, and
 * the fields and methods of the value are reached through the box, as
 * through a reference `&T`: `r.x` is `(*r).x`. Stage 0 rewrites these uses
 * into dereferences; stage 1 records them in `Checker.derefs`, by the node
 * whose value is dereferenced. Inside the module that declares `Box`, its
 * own fields are reached as usual.
 */

import sema.check.Checker
import sema.check_methods.hasMethod
import sema.program.Program
import sema.structs.structFieldType
import sema.structs.structFields
import base.intern.Symbol
import sema.types.TyKind
import syntax.ast.Expr

/**
 * The content type of a `Box<T>`.
 *
 * @param c the checker
 * @param ty a type
 * @returns T, if `ty` is a box
 */
pub fn boxInner(c: Checker, ty: int) Option<int> {
    const t = c.types.get(ty)
    if c.r.langItems[0] == 0 || t.kind != TyKind.Adt || t.data != c.r.langItems[0] {
        return Option.None
    }
    return Option.Some(t.args[0])
}

/**
 * The type `*b` reads for a box `b` of type `box`: the target of its
 * pointer field.
 *
 * @param c the checker
 * @param p the program
 * @param box a `Box<T>` type
 * @returns T
 */
pub fn boxTarget(c: mut Checker, p: Program, box: int) int {
    structFields(c, p, c.r.langItems[0])
    const ptr = structFieldType(c, p, box, 0)
    return c.types.get(ptr).inner
}

fn ownBox(c: Checker) bool {
    const box = c.r.langItems[0]
    return box != 0 && c.def(box).module == c.module()
}

// The type after one implicit dereference of a value of type `ty`, or `ty`.
fn derefStep(c: mut Checker, p: Program, ty: int) int {
    if !ownBox(c) && boxInner(c, ty).isSome() {
        return boxTarget(c, p, ty)
    }
    if c.types.kind(ty) == TyKind.Ref {
        return c.types.get(ty).inner
    }
    return ty
}

fn record(c: mut Checker, e: &Expr, steps: move List<int>, result: int) {
    if steps.len() > 0 {
        c.derefs[c.module()].insert(e.id.0, steps)
        c.adjusted[c.module()].insert(e.id.0, result)
    }
}

/**
 * Dereferences the value of `e`, of type `ty`, while it is a box (except in
 * the module declaring `Box`) or a reference: `Box<Box<T>>`, `&Box<T>`.
 *
 * @param c the checker
 * @param p the program
 * @param e the expression
 * @param ty its type
 * @returns the type of the dereferenced value
 */
pub fn autoDeref(c: mut Checker, p: Program, e: &Expr, ty: int) int {
    var steps: List<int> = []
    var current = ty
    for {
        const next = derefStep(c, p, current)
        if next == current {
            break
        }
        steps.push(current)
        current = next
    }
    record(c, e, steps, current)
    return current
}

/**
 * The receiver of `e.name()`: through references, and through boxes unless
 * `Box` itself has the method.
 *
 * @param c the checker
 * @param p the program
 * @param e the receiver expression
 * @param ty its type
 * @param name the method
 * @returns the type of the receiver
 */
pub fn methodReceiver(c: mut Checker, p: Program, e: &Expr, ty: int, name: Symbol) int {
    var steps: List<int> = []
    var current = ty
    for {
        const viaBox = boxInner(c, current).isSome() && !hasMethod(c, p, c.r.langItems[0], name)
        const through = c.types.kind(current) == TyKind.Ref || viaBox
        const next = if through { derefStep(c, p, current) } else { current }
        if next == current {
            break
        }
        steps.push(current)
        current = next
    }
    record(c, e, steps, current)
    return current
}

/**
 * The implicit dereferences recorded for `e`.
 *
 * @param c the checker
 * @param e an expression of the current module
 * @returns the type before each one
 */
pub fn derefsOf(c: Checker, e: &Expr) List<int> {
    return match c.derefs[c.module()].get(e.id.0) {
        Option.Some(steps) => steps.clone()
        Option.None => []
    }
}

/**
 * The type of the value of `e` once its implicit dereferences are done.
 *
 * @param c the checker
 * @param e an expression of the current module
 * @returns its type
 */
pub fn adjustedType(c: Checker, e: &Expr) int {
    return match c.adjusted[c.module()].get(e.id.0) {
        Option.Some(ty) => *ty
        Option.None => c.typeOf(e.id.0)
    }
}
