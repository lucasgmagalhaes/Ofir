/**
 * @module
 * The modules of a program, as the loader gives them to the resolver.
 */

import base.intern.Symbol
import diag.index.noSpan
import syntax.ast.Item
import syntax.ast.ItemKind
import syntax.ast.Module

/**
 * A module of the program.
 */
pub struct ProgramModule {
    /** Its dotted name: `syntax.parser`, `std.core`; the root's is named
     * after its file (spec 7.1). */
    pub name: str
    /** Its tree. */
    pub module: Module
}

/**
 * The modules of a program: the root first, then `std.core` and the
 * imported ones in the order they were found.
 */
pub struct Program {
    /** The modules. */
    pub modules: List<ProgramModule>
    /** The declaration of the types the checker makes, union types (spec 17.6): an enum
     * without variants, attributes or type parameters. */
    pub synthetic: Item
}

/**
 * A program of the modules given.
 *
 * @param modules the modules, the root first
 * @returns the program
 */
pub fn newProgram(modules: move List<ProgramModule>) Program {
    let synthetic = Item{kind: ItemKind.Enum(false, [], [], []), span: noSpan(), name: Symbol(0),
                         attributes: [], isPub: true, bounds: [], asserts: []}
    return Program{modules, synthetic}
}
