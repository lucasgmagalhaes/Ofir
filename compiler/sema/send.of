/**
 * @module
 * The marker interfaces `Send` and `Sync` (spec 14.3), derived from a
 * type's structure: a value is `Send` when it may move to another task,
 * `Sync` when shared references to it may be used from several tasks.
 * Numbers, `bool`, `str` and `()` are both; raw pointers are neither; a
 * struct, enum, tuple or array is when all its parts are. A struct or enum
 * marked `@threadsafe` (`List`, `Map`, `Box`) is when its type arguments
 * are: its raw pointers are not checked. `UnsafeCell` is never `Sync`.
 */

import sema.check.BOUND_SEND
import sema.check.BOUND_SYNC
import sema.check.Checker
import sema.check.itemOf
import sema.check_generic.paramBounds
import sema.def.DefKind
import sema.enums.enumOf
import sema.enums.variantsOf
import sema.program.Program
import sema.resolve.findAttribute
import sema.structs.fieldsOf
import sema.structs.structFieldType
import sema.structs.structFields
import sema.structs.variantFieldType
import sema.types.FN_SEND
import sema.types.TyKind

/**
 * Whether values of a type may move to another task (`Send`).
 *
 * @param c the checker
 * @param p the program
 * @param ty the type
 * @returns true if they may
 */
pub fn isSend(c: mut Checker, p: Program, ty: int) bool {
    var seen: List<int> = []
    return markedIn(c, p, ty, false, &mut seen)
}

/**
 * Whether shared references to a type may be used from several tasks
 * (`Sync`).
 *
 * @param c the checker
 * @param p the program
 * @param ty the type
 * @returns true if they may
 */
pub fn isSync(c: mut Checker, p: Program, ty: int) bool {
    var seen: List<int> = []
    return markedIn(c, p, ty, true, &mut seen)
}

// `sync`: decides `Sync`, else `Send`. `seen`: the structs and enums being
// decided, which a recursive type reaches again; they count as marked there.
fn markedIn(c: mut Checker, p: Program, ty: int, sync: bool, seen: &mut List<int>) bool {
    const kind = c.types.kind(ty)
    if kind == TyKind.Int || kind == TyKind.Float || kind == TyKind.Bool ||
       kind == TyKind.Str || kind == TyKind.Unit || kind == TyKind.Never ||
       kind == TyKind.Error || kind == TyKind.Key {
        return true
    }
    if kind == TyKind.Ref {   // `&T` is `Send` when `T` is `Sync`; `&mut T` when `T` is `Send`
        const inner = c.types.get(ty).inner
        const mutable = c.types.get(ty).data != 0
        return markedIn(c, p, inner, sync || !mutable, seen)
    }
    if kind == TyKind.Slice || kind == TyKind.Array {
        return markedIn(c, p, c.types.get(ty).inner, sync, seen)
    }
    if kind == TyKind.Fn {   // only `move fn() R + Send` may move; no function is `Sync`
        return !sync && c.types.get(ty).data & FN_SEND != 0
    }
    if kind == TyKind.Param {
        const bit = if sync { BOUND_SYNC } else { BOUND_SEND }
        return paramBounds(c, ty) & bit != 0
    }
    if kind != TyKind.Tuple && kind != TyKind.Adt {
        return false   // raw pointers, `dyn I`
    }
    for i in 0..seen.len() {
        if seen[i] == ty {
            return true
        }
    }
    seen.push(ty)
    if sync && kind == TyKind.Adt && c.types.get(ty).data == c.r.langItems[6] {
        return false   // `UnsafeCell<T>` (and so `Cell<T>`) is never `Sync`
    }
    const args = c.types.get(ty).args.clone()
    if kind == TyKind.Tuple || threadsafe(c, p, c.types.get(ty).data) {
        for i in 0..args.len() {
            if !markedIn(c, p, args[i], sync, seen) {
                return false
            }
        }
        return true
    }
    const id = c.types.get(ty).data
    if c.def(id).kind == DefKind.Struct {
        if !structFields(c, p, id) {
            return false
        }
        const count = fieldsOf(c, id).types.len()
        for i in 0..count {
            if !markedIn(c, p, structFieldType(c, p, ty, i), sync, seen) {
                return false
            }
        }
        return true
    }
    if enumOf(c, p, ty).isNone() {
        return false
    }
    const count = variantsOf(c, id).variants.len()
    for v in 0..count {
        const fields = variantsOf(c, id).variants[v].types.len()
        for i in 0..fields {
            if !markedIn(c, p, variantFieldType(c, p, ty, v, i), sync, seen) {
                return false
            }
        }
    }
    return true
}

// Whether a struct or enum is marked `@threadsafe`.
fn threadsafe(c: Checker, p: Program, id: int) bool {
    if c.def(id).item < 0 {
        return false
    }
    return findAttribute(c.r, itemOf(p, c.loc(id)).attributes, "threadsafe").isSome()
}
