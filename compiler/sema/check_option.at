/**
 * @module
 * `Option<T>` and `Result<T, E>` in the checker (spec 6; stage 0:
 * bootstrap/src/sema/check_option.c): the `?` and `??` operators and unused
 * results. The types themselves are in std/core/option.at and result.at.
 */

import sema.check.Checker
import sema.expr_check.checkExpr
import sema.expr_check.requireType
import sema.check_types.compatible
import sema.program.Program
import sema.types.ERROR
import syntax.ast.Expr

fn instanceOf(c: Checker, ty: int, id: int, count: int) bool {
    let t = c.types.get(ty)
    return id != 0 && t.kind == .Adt && t.data == id && t.args.len() == count
}

/**
 * The content type of an `Option<T>`.
 *
 * @param c the checker
 * @param ty a type
 * @returns T, if `ty` is an Option
 */
pub fn optionInner(c: Checker, ty: int) Option<int> {
    if !instanceOf(c, ty, c.r.langItems[2], 1) {
        return .None
    }
    return .Some(c.types.get(ty).args[0])
}

/**
 * The value and error types of a `Result<T, E>`.
 *
 * @param c the checker
 * @param ty a type
 * @returns (T, E), if `ty` is a Result
 */
pub fn resultParts(c: Checker, ty: int) Option<(int, int)> {
    if !instanceOf(c, ty, c.r.langItems[3], 2) {
        return .None
    }
    return .Some((c.types.get(ty).args[0], c.types.get(ty).args[1]))
}

// `?` on a Result: the function returns a Result with the same error type.
fn tryResult(c: mut Checker, e: &Expr, error: int) {
    let Some(parts) = resultParts(c, c.ret) else {
        if c.ret != ERROR {
            c.error("E0300", e.span, "`?` on a Result needs the function to return a Result, "
                    + "not `{c.typeName(c.ret)}`")
        }
        return
    }
    if !compatible(error, parts.1) {
        c.error("E0300", e.span, "mismatched types: `?` returns the error `{c.typeName(error)}`, "
                + "but the function returns errors of type `{c.typeName(parts.1)}`")
    }
}

/**
 * `value?`: the content of `Some` or `Ok`; `None` or `Err(e)` is returned.
 *
 * @param c the checker
 * @param p the program
 * @param e the `?` expression
 * @param inner its operand
 * @returns its type
 */
pub fn checkTry(c: mut Checker, p: Program, e: &Expr, inner: &Expr) int {
    let ty = checkExpr(c, p, inner, ERROR)
    if let .Some(value) = optionInner(c, ty) {
        if optionInner(c, c.ret).isNone() && c.ret != ERROR {
            c.error("E0300", e.span, "`?` on an Option needs the function to return an Option, "
                    + "not `{c.typeName(c.ret)}`")
        }
        return value
    }
    if let .Some(parts) = resultParts(c, ty) {
        tryResult(c, e, parts.1)
        return parts.0
    }
    if ty != ERROR {
        c.error("E0313", e.span, "`?` needs an Option or a Result, not `{c.typeName(ty)}`")
    }
    return ERROR
}

/**
 * `a ?? b`: the content of `a`, else `b`, of the content's type; when `b` is
 * an Option too, the result is an Option.
 *
 * @param c the checker
 * @param p the program
 * @param lhs `a`
 * @param rhs `b`
 * @param expected the type the context expects
 * @returns the type of the expression
 */
pub fn checkCoalesce(c: mut Checker, p: Program, lhs: &Expr, rhs: &Expr, expected: int) int {
    var hint = ERROR
    if expected != ERROR && c.r.langItems[2] != 0 {
        hint = c.types.adt(c.r.langItems[2], [expected])
    }
    let wanted = if optionInner(c, expected).isSome() { expected } else { hint }
    let ty = checkExpr(c, p, lhs, wanted)
    let Some(value) = optionInner(c, ty) else {
        if ty != ERROR {
            c.error("E0313", lhs.span, "`??` needs an Option on its left, not `{c.typeName(ty)}`")
        }
        checkExpr(c, p, rhs, ERROR)
        return ERROR
    }
    let other = checkExpr(c, p, rhs, value)
    if other == ty {
        return ty   // `a ?? b ?? c` where `b` is an Option
    }
    requireType(c, rhs, other, value)
    return value
}

/**
 * Reports E0305 for a `Result` computed as a statement and dropped.
 *
 * @param c the checker
 * @param e the expression statement
 */
pub fn checkUnusedResult(c: mut Checker, e: &Expr) {
    if resultParts(c, c.typeOf(e.id.0)).isSome() {
        c.error("E0305", e.span, "unused `Result` that must be used: handle the error, or "
                + "ignore it explicitly with `let _ = ...`")
    }
}
