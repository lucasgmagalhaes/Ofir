/**
 * @module
 * Places and their mutability (spec 4.2; stage 0: place_root and
 * require_mutable in bootstrap/src/sema/check_method.c).
 */

import sema.check.Checker
import sema.check_box.adjustedType
import sema.check_box.boxInner
import sema.check_box.derefsOf
import sema.expr_check.isModuleMember
import sema.program.Program
import sema.types.ERROR
import sema.types.STR
import syntax.ast.Expr
import syntax.ast.ExprKind

/**
 * The root of a place: the variable of `p.pos.x`, an explicit `*p`, or a
 * value reached through implicit dereferences.
 *
 * @param c the checker
 * @param p the program
 * @param e the place
 * @returns the root and the number of implicit dereferences of its value
 *     (0 for a variable or an explicit `*p`), or `None` for a temporary
 */
pub fn placeRoot(c: mut Checker, p: Program, e: &Expr) Option<(&Expr, int)> {
    var at = e
    for {
        if isModuleMember(c, at) {
            return .Some((at, 0))   // `m.global`
        }
        let base = match at.kind {
            .Field(base, _, _) => &*base
            .TupleField(base, _) => &*base
            .Index(base, _) => {
                if adjustedType(c, p, &*base) == STR {
                    return .None
                }
                &*base   // an element of a list
            }
            .Ident(_) | .SelfValue => {
                return .Some((at, 0))
            }
            .Unary(op, _) => {
                return if op == .Deref { .Some((at, 0)) } else { .None }
            }
            _ => {
                return .None
            }
        }
        let steps = derefsOf(c, base).len()
        if steps > 0 {
            return .Some((base, steps))
        }
        at = base
    }
}

// Whether the place goes through an element of a `&[T]`, which is read-only.
fn throughSlice(c: mut Checker, p: Program, e: &Expr) bool {
    var at = e
    for {
        let base = match at.kind {
            .Field(base, _, _) => &*base
            .TupleField(base, _) => &*base
            .Index(base, _) => {
                let ty = adjustedType(c, p, &*base)
                let slice = c.r.langItems[4]
                if slice != 0 && c.types.kind(ty) == .Adt && c.types.get(ty).data == slice {
                    return true
                }
                &*base
            }
            _ => {
                return false
            }
        }
        at = base
    }
}

/**
 * Reports E0315 unless `place` may be modified.
 *
 * @param c the checker
 * @param p the program
 * @param place the place
 */
pub fn requireMutable(c: mut Checker, p: Program, place: &Expr) {
    if throughSlice(c, p, place) {
        c.error("E0315", place.span, "this value cannot be modified: the elements of a `&[T]` "
                + "are read-only")
        return
    }
    let Some(root) = placeRoot(c, p, place) else {
        if c.typeOf(place.id.0) != ERROR {
            c.error("E0315", place.span,
                    "only variables and their fields can be modified".toOwned())
        }
        return
    }
    requireRoot(c, p, root.0, root.1)
}

// `e` after `level` of its implicit dereferences.
fn requireRoot(c: mut Checker, p: Program, e: &Expr, level: int) {
    if level > 0 {
        let ty = derefsOf(c, e)[level - 1]
        if boxInner(c, ty).isSome() {   // through a box: the box is modified
            if level == 1 {
                requireMutable(c, p, e)
            } else {
                requireRoot(c, p, e, level - 1)
            }
            return
        }
        if c.types.get(ty).data == 0 {
            c.error("E0315", e.span, "this value cannot be modified: it is reached through a "
                    + "`&T`, not a `&mut T`")
        }
        return
    }
    match e.kind {
        .Unary(_, operand) => {   // `*p`: writable through a `*mut T` or a `&mut T`
            let ty = c.typeOf(operand.id.0)
            if boxInner(c, ty).isSome() {
                requireMutable(c, p, &*operand)
                return
            }
            let kind = c.types.kind(ty)
            let ok = ((kind == .Ptr || kind == .Ref) && c.types.get(ty).data != 0) ||
                     c.typeOf(e.id.0) == ERROR
            if !ok {
                let isRef = kind == .Ref
                c.error("E0315", e.span, "this value cannot be modified: it is reached through "
                        + "a `{if isRef { "&T" } else { "*T" }}`, not a "
                        + "`{if isRef { "&mut T" } else { "*mut T" }}`")
            }
        }
        _ => {
            let ok = match c.res(e.id.0) {
                .Local(id) => c.locals[id].mutable
                .Def(id) => c.def(id).kind == .Global
                _ => c.typeOf(e.id.0) == ERROR
            }
            if !ok {
                c.error("E0315", e.span,
                        "this value cannot be modified: declare it with `var`".toOwned())
            }
        }
    }
}
