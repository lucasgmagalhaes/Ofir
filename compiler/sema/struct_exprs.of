/**
 * @module
 * Struct literals, tuple struct constructors and field access (spec 3.4;
 * stage 0: bootstrap/src/sema/structs.c).
 */

import base.intern.Symbol
import base.span.Span
import sema.check.Checker
import sema.check.Generics
import sema.check.itemOf
import sema.check.itemTypeParams
import sema.check_box.autoDeref
import sema.check_generic.Infer
import sema.check_generic.checkGenericArgs
import sema.check_generic.inferApply
import sema.check_generic.inferExplicit
import sema.check_generic.inferFinish
import sema.check_generic.inferFrom
import sema.check_generic.inferHint
import sema.check_generic.inferNew
import sema.check_methods.checkVisible
import sema.check_types.ownerType
import sema.def.Res
import sema.expr_check.checkArgs
import sema.expr_check.checkExpr
import sema.expr_check.checkName
import sema.expr_check.coerce
import sema.expr_check.requireType
import sema.program.Program
import sema.structs.fieldIndex
import sema.structs.fieldsOf
import sema.structs.structFieldType
import sema.structs.structFields
import sema.types.ERROR
import syntax.ast.Arg
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.FieldInit
import syntax.ast.ItemKind
import syntax.ast.TypeExpr

/**
 * The struct declaration of a type (the `@lang` declaration of a primitive).
 *
 * @param c the checker
 * @param ty a type
 * @returns its `DefId`, or 0
 */
pub fn structDef(c: Checker, ty: int) int {
    if c.types.kind(ty) != .Adt {
        return if ty < c.r.lang.len() { c.r.lang[ty] } else { 0 }
    }
    let id = c.types.get(ty).data
    return if c.def(id).kind == .Struct { id } else { 0 }
}

fn fieldIsPub(c: Checker, p: Program, id: int, index: int) bool {
    return match itemOf(p, c.loc(id)).kind {
        .Struct(_, _, _, _, fields, _) => fields[index].isPub
        _ => true
    }
}

/**
 * `a.f` on a struct value of type `base`.
 *
 * @param c the checker
 * @param p the program
 * @param e the field expression
 * @param name the field
 * @param base the type of the dereferenced value
 * @returns the field's type
 */
pub fn checkStructField(c: mut Checker, p: Program, e: &Expr, name: Symbol, base: int) int {
    let id = structDef(c, base)
    let known = id != 0 && structFields(c, p, id)
    let index = if known { fieldIndex(fieldsOf(c, id), name) } else { -1 }
    if index < 0 {
        if base != ERROR && (id == 0 || known) {
            c.error("E0316", e.span, "no field `{c.text(name)}` on type `{c.typeName(base)}`")
        }
        return ERROR
    }
    c.setMember(e.id.0, index)
    checkVisible(c, c.def(id).module, fieldIsPub(c, p, id, index), name, e.span)
    return structFieldType(c, p, base, index)
}

/**
 * `a.0` on a tuple or a tuple struct.
 *
 * @param c the checker
 * @param p the program
 * @param e the expression
 * @param baseExpr `a`
 * @param index the field number
 * @returns the field's type
 */
pub fn checkTupleField(c: mut Checker, p: Program, e: &Expr, baseExpr: &Expr, index: int) int {
    let found = checkExpr(c, p, baseExpr, ERROR)
    let base = autoDeref(c, p, baseExpr, found)
    let t = c.types.get(base)
    if t.kind == .Tuple && index < t.args.len() {
        return t.args[index]
    }
    let id = structDef(c, base)
    let known = id != 0 && structFields(c, p, id)
    if !known || !fieldsOf(c, id).isTuple || index >= fieldsOf(c, id).types.len() {
        if base != ERROR {
            c.error("E0316", e.span, "no field `{index}` on type `{c.typeName(base)}`")
        }
        return ERROR
    }
    return structFieldType(c, p, base, index)
}

/**
 * `Name(a, b)` or `Name<T>(a, b)` for a tuple struct.
 *
 * @param c the checker
 * @param p the program
 * @param call the call
 * @param id the struct
 * @param explicit the written type arguments
 * @param args the arguments
 * @param expected the type the context expects
 * @returns the struct type
 */
pub fn checkConstructor(c: mut Checker, p: Program, call: &Expr, id: int,
                        explicit: &List<TypeExpr>, args: &List<Arg>, expected: int) int {
    let known = structFields(c, p, id)
    let ty = ownerType(c, p, id)
    if !known || !fieldsOf(c, id).isTuple {
        c.error("E0310", call.span, "expected a value, found type `{c.text(c.def(id).name)}`; "
                + "build a struct with `Name\{field: value\}`")
        return ERROR
    }
    let params = fieldsOf(c, id).types.clone()
    let owner = itemTypeParams(itemOf(p, c.loc(id)))
    if owner.len() == 0 && explicit.len() == 0 {
        return checkArgs(c, p, call.span, args, &params, ty)
    }
    var inf = inferNew(Generics{owner, fnParams: []})
    if explicit.len() > 0 {
        let callee = match call.kind {
            .Call(callee, _) => callee.span
            _ => call.span
        }
        inferExplicit(c, p, inf, true, explicit, callee)
    }
    return checkGenericArgs(c, p, call.id.0, call.span, args, &params, ty, inf, expected)
}

// The field values; with `inf`, a generic struct's parameters are bound from
// their types, which `requireFields` checks after.
fn checkLiteralFields(c: mut Checker, p: Program, id: int, fields: &List<FieldInit>,
                      given: mut List<bool>, inf: mut Infer, generic: bool) {
    let types = fieldsOf(c, id).types.clone()
    for i in 0..fields.len() {
        let init = &fields[i]
        let span = valueSpan(c, init)
        let index = fieldIndex(fieldsOf(c, id), init.name)
        if index < 0 {
            c.error("E0316", span, "no field `{c.text(init.name)}` on this struct")
            checkInit(c, p, init, ERROR)
            continue
        }
        checkVisible(c, c.def(id).module, fieldIsPub(c, p, id, index), init.name, span)
        if given[index] {
            c.error("E0201", span, "field `{c.text(init.name)}` is given twice")
        }
        given[index] = true
        if generic {
            let hint = inferHint(c, &inf, types[index])
            let found = checkInit(c, p, init, hint)
            inferFrom(c, inf, types[index], found)
        } else {
            coerceInit(c, p, init, types[index])
        }
    }
}

// The span of a field's value: the shorthand `x` reads the name at the
// literal (stage 0 gives it the literal's span).
fn valueSpan(c: Checker, init: &FieldInit) Span {
    return match init.value {
        .Some(value) => value.span
        .None => c.shorthandSpan
    }
}

// The value of a field, or the variable of the shorthand `x`.
fn checkInit(c: mut Checker, p: Program, init: &FieldInit, expected: int) int {
    if let .Some(value) = init.value {
        return checkExpr(c, p, &value, expected)
    }
    let ty = checkName(c, p, c.res(init.id.0), c.shorthandSpan)
    c.setType(init.id.0, ty)
    return ty
}

fn coerceInit(c: mut Checker, p: Program, init: &FieldInit, expected: int) {
    if let .Some(value) = init.value {
        coerce(c, p, &value, expected)
        return
    }
    let ty = checkInit(c, p, init, expected)
    if ty != expected && ty != ERROR && expected != ERROR {
        c.error("E0300", c.shorthandSpan, "mismatched types: expected {c.typeName(expected)}, "
                + "found {c.typeName(ty)}")
    }
}

/**
 * `Point{x: 1, y}`, `Config{}`, `User{age: 31, ..u}`, `Pair<int, str>{...}`.
 *
 * @param c the checker
 * @param p the program
 * @param e the literal
 * @param expected the type the context expects
 * @returns its type
 */
pub fn checkStructLiteral(c: mut Checker, p: Program, e: &Expr, expected: int) int {
    match e.kind {
        .Struct(name, fields, base) => {
            let Res.Def(id) = c.res(name.id.0) else {
                return c.unsupported(name.span, "this struct literal is")
            }
            let known = c.def(id).kind == .Struct && structFields(c, p, id)
            if !known || fieldsOf(c, id).isTuple {
                c.error("E0310", name.span, "`{c.text(c.def(id).name)}` is not a struct with named "
                        + "fields")
                return ERROR
            }
            c.shorthandSpan = e.span
            let count = fieldsOf(c, id).types.len()
            var given = List.filled(false, count)
            let owner = itemTypeParams(itemOf(p, c.loc(id)))
            var explicit: Option<List<TypeExpr>> = .None
            if let ExprKind.Generic(_, args) = name.kind {
                explicit = .Some(args.clone())
            }
            var ty = ERROR
            if owner.len() > 0 || explicit.isSome() {
                var inf = inferNew(Generics{owner, fnParams: []})
                if let .Some(args) = explicit {
                    inferExplicit(c, p, inf, true, &args, name.span)
                }
                let selfType = ownerType(c, p, id)
                inferFrom(c, inf, selfType, expected)
                checkLiteralFields(c, p, id, &fields, given, inf, true)
                var finished = inf
                inferFinish(c, finished, name.span)
                let types = fieldsOf(c, id).types.clone()
                for i in 0..fields.len() {
                    let index = fieldIndex(fieldsOf(c, id), fields[i].name)
                    if index >= 0 {
                        let wanted = inferApply(c, &finished, types[index])
                        let found = c.typeOf(fields[i].id.0)
                        if let .Some(value) = fields[i].value {
                            requireType(c, &value, c.typeOf(value.id.0), wanted)
                        } else if found != wanted && found != ERROR && wanted != ERROR {
                            c.error("E0300", e.span, "mismatched types: expected "
                                    + "{c.typeName(wanted)}, found {c.typeName(found)}")
                        }
                    }
                }
                ty = inferApply(c, &finished, selfType)
            } else {
                ty = c.types.adt(id, [])
                var none = inferNew(Generics{owner: [], fnParams: []})
                checkLiteralFields(c, p, id, &fields, given, none, false)
            }
            c.setType(name.id.0, ty)
            if let .Some(rest) = base {
                coerce(c, p, &*rest, ty)
                return ty
            }
            let defaults = fieldsOf(c, id).defaults.clone()
            let names = fieldsOf(c, id).names.clone()
            for i in 0..count {
                if !given[i] && !defaults[i] {
                    c.error("E0308", e.span, "missing field `{c.text(names[i])}` in "
                            + "`{c.text(c.def(id).name)}`")
                }
            }
            return ty
        }
        _ => {
            return ERROR
        }
    }
}
