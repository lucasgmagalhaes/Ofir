/**
 * @module
 * Type checking of patterns (spec appendix A.7; stage 0:
 * bootstrap/src/sema/check_pattern.c), for `let`, `match` and `if let`.
 * A pattern that the resolver found to name a prelude variant (`None`,
 * `Some(x)`) is checked as a variant pattern.
 */

import base.intern.Symbol
import base.span.Span
import sema.check.Checker
import sema.check_types.moduleType
import sema.def.Res
import sema.enums.enumOf
import sema.enums.variantIndex
import sema.enums.variantsOf
import sema.expr_check.coerce
import sema.program.Program
import sema.structs.fieldsOf
import sema.structs.structFieldType
import sema.structs.structFields
import sema.structs.variantFieldType
import sema.types.ERROR
import sema.types.UNIT
import syntax.ast.Pattern
import syntax.ast.PatternKind

fn mismatch(c: mut Checker, span: Span, what: str, ty: int) {
    if ty != ERROR {
        c.error("E0300", span, "mismatched types: {what} pattern for a value of type "
                + "{c.typeName(ty)}")
    }
}

fn checkList(c: mut Checker, p: Program, list: &List<Pattern>, types: &List<int>, span: Span) {
    if list.len() != types.len() {
        c.error("E0302", span, "wrong number of fields in the pattern: expected "
                + "{types.len()}, found {list.len()}")
    }
    for i in 0..list.len() {
        checkPattern(c, p, &list[i], if i < types.len() { types[i] } else { ERROR })
    }
}

// The declaration a path of a pattern names, or 0.
fn pathDef(c: mut Checker, path: &List<Symbol>, span: Span) int {
    if path.len() == 2 {   // `module.Type`
        let module = c.r.scope.module(path[0])
        c.r.noteImportUse(path[0])
        if module != 0 && c.def(module).kind == .Module {
            return moduleType(c, c.def(module).target, path[1], span)
        }
    }
    if path.len() != 1 {
        c.unsupported(span, "nested module paths in patterns are")
        return 0
    }
    let id = c.r.scope.module(path[0])
    c.r.noteImportUse(path[0])
    if id == 0 {
        c.error("E0200", span, "cannot find `{c.text(path[0])}` in this scope")
    }
    return id
}

fn sameAdt(c: Checker, ty: int, id: int) bool {
    return ty != ERROR && c.types.kind(ty) == .Adt && c.types.get(ty).data == id
}

fn fieldTypes(c: mut Checker, p: Program, ty: int, v: int, count: int) List<int> {
    var out: List<int> = []
    for i in 0..count {
        out.push(if v < 0 { structFieldType(c, p, ty, i) } else {
            variantFieldType(c, p, ty, v, i)
        })
    }
    return out
}

fn variantPattern(c: mut Checker, p: Program, pat: &Pattern, path: &List<Symbol>, name: Symbol,
                  args: &List<Pattern>, hasArgs: bool, ty: int) {
    let found = enumOf(c, p, ty)
    if path.len() > 0 {
        let named = pathDef(c, path, pat.span)
        if named != 0 && found.isSome() && named != (found ?? 0) {
            c.error("E0300", pat.span, "mismatched types: the pattern is a variant of "
                    + "`{c.text(c.def(named).name)}`, the value has type {c.typeName(ty)}")
            return
        }
    }
    let Some(id) = found else {
        mismatch(c, pat.span, "an enum variant", ty)
        return
    }
    let index = variantIndex(variantsOf(c, id), name)
    if index < 0 {
        c.error("E0320", pat.span, "no variant `{c.text(name)}` in `{c.typeName(ty)}`")
        return
    }
    c.setMember(pat.id.0, index)
    let count = variantsOf(c, id).variants[index].types.len()
    if hasArgs || count > 0 {
        checkList(c, p, args, &fieldTypes(c, p, ty, index, count), pat.span)
    }
}

fn structPattern(c: mut Checker, p: Program, pat: &Pattern, path: &List<Symbol>, ty: int) {
    let id = pathDef(c, path, pat.span)
    if id == 0 {
        return
    }
    let isStruct = c.def(id).kind == .Struct && structFields(c, p, id)
    if !isStruct || fieldsOf(c, id).isTuple || !sameAdt(c, ty, id) {
        mismatch(c, pat.span, "a struct", ty)
        return
    }
    let PatternKind.Struct(_, fields, rest) = pat.kind else {
        return
    }
    let names = fieldsOf(c, id).names.clone()
    var listed = 0
    for i in 0..fields.len() {
        var index = 0
        for index < names.len() && names[index].0 != fields[i].name.0 {
            index += 1
        }
        if index == names.len() {
            c.error("E0316", pat.span, "no field `{c.text(fields[i].name)}` on type "
                    + "`{c.typeName(ty)}`")
            continue
        }
        listed += 1
        let fieldType = structFieldType(c, p, ty, index)
        if let .Some(inner) = fields[i].pattern {
            checkPattern(c, p, &inner, fieldType)
        } else {
            shorthand(c, fields[i].id.0, fieldType)
        }
    }
    if !rest && listed < names.len() {
        c.error("E0308", pat.span, "the pattern does not list every field: add `..` to "
                + "ignore the others")
    }
}

// The shorthand field `Point{x}` binds `x`.
fn shorthand(c: mut Checker, id: int, ty: int) {
    c.setType(id, ty)
    let local = c.localAt(id)
    if local >= 0 {
        c.localTypes[local] = ty
    }
}

fn tupleStructPattern(c: mut Checker, p: Program, pat: &Pattern, path: &List<Symbol>,
                      args: &List<Pattern>, ty: int) {
    let id = pathDef(c, path, pat.span)
    if id == 0 {
        return
    }
    if c.def(id).kind == .Enum {   // `Shape(...)` is not a variant
        mismatch(c, pat.span, "a tuple struct", ty)
        return
    }
    let isStruct = c.def(id).kind == .Struct && structFields(c, p, id)
    if !isStruct || !fieldsOf(c, id).isTuple || !sameAdt(c, ty, id) {
        mismatch(c, pat.span, "a tuple struct", ty)
        return
    }
    let count = fieldsOf(c, id).types.len()
    checkList(c, p, args, &fieldTypes(c, p, ty, -1, count), pat.span)
}

/**
 * Checks a pattern against the type of the matched value, and types its
 * bindings.
 *
 * @param c the checker
 * @param p the program
 * @param pat the pattern
 * @param ty the value's type
 */
pub fn checkPattern(c: mut Checker, p: Program, pat: &Pattern, ty: int) {
    c.setType(pat.id.0, ty)
    if let Res.Def(variant) = c.res(pat.id.0) {   // `None`, `Some(x)`
        let none: List<Pattern> = []
        let path: List<Symbol> = []
        let name = c.def(variant).name
        match pat.kind {
            .TupleStruct(_, args) => variantPattern(c, p, pat, &path, name, &args, true, ty)
            _ => variantPattern(c, p, pat, &path, name, &none, false, ty)
        }
        return
    }
    match pat.kind {
        .Wildcard => {}
        .Binding(_, _) => {
            let local = c.localAt(pat.id.0)
            if local >= 0 {
                c.localTypes[local] = ty
            }
        }
        .Literal(value) => {
            let kind = c.types.kind(ty)
            if kind != .Int && kind != .Bool && kind != .Str && kind != .Error {
                mismatch(c, pat.span, "a literal", ty)
            } else {
                coerce(c, p, &*value, ty)
            }
        }
        .Range(lo, hi, _) => {
            if !c.types.isInteger(ty) {
                mismatch(c, pat.span, "a range", ty)
            } else {
                coerce(c, p, &*lo, ty)
                coerce(c, p, &*hi, ty)
            }
        }
        .Variant(path, name, args, hasArgs) => {
            variantPattern(c, p, pat, &path, name, &args, hasArgs, ty)
        }
        .Struct(path, _, _) => structPattern(c, p, pat, &path, ty)
        .TupleStruct(path, args) => tupleStructPattern(c, p, pat, &path, &args, ty)
        .Tuple(items) => {
            if c.types.kind(ty) == .Tuple || (ty == UNIT && items.len() == 0) {   // `()`
                let types = c.types.get(ty).args.clone()
                checkList(c, p, &items, &types, pat.span)
            } else {
                mismatch(c, pat.span, "a tuple", ty)
            }
        }
        .Or(alternatives) => {
            for i in 0..alternatives.len() {
                checkPattern(c, p, &alternatives[i], ty)
            }
        }
    }
}

fn allIrrefutable(c: Checker, list: &List<Pattern>) bool {
    for i in 0..list.len() {
        if !irrefutable(c, &list[i]) {
            return false
        }
    }
    return true
}

/**
 * Whether a pattern matches every value of its type, as `let` needs.
 *
 * @param c the checker
 * @param pat the pattern
 * @returns true if it cannot fail
 */
pub fn irrefutable(c: Checker, pat: &Pattern) bool {
    if let Res.Def(_) = c.res(pat.id.0) {
        return false   // a prelude variant
    }
    return match pat.kind {
        .Wildcard | .Binding(_, _) => true
        .Tuple(items) => allIrrefutable(c, &items)
        .TupleStruct(_, args) => allIrrefutable(c, &args)
        .Struct(_, fields, _) => {
            for i in 0..fields.len() {
                if let .Some(inner) = fields[i].pattern {
                    if !irrefutable(c, &inner) {
                        return false
                    }
                } else if let Res.Def(_) = c.res(fields[i].id.0) {
                    return false
                }
            }
            true
        }
        _ => false
    }
}
