/**
 * @module
 * Building enum variants (spec 2.5 and 3.5; stage 0:
 * bootstrap/src/sema/enums.c): `.Circle(1.0)` where the enum is known from
 * the context, `Shape.Circle(1.0)`, `Shape.Empty`, and the prelude's
 * `Some(x)`, `None`, `Ok(v)`, `Err(e)`.
 */

import base.intern.Symbol
import base.span.Span
import sema.check.Checker
import sema.check.Generics
import sema.check.itemOf
import sema.check.itemTypeParams
import sema.check_generic.checkGenericArgs
import sema.check_generic.inferFromSelf
import sema.check_generic.inferNew
import sema.check_types.ownerType
import sema.enums.enumOf
import sema.enums.enumVariants
import sema.enums.variantIndex
import sema.enums.variantsOf
import sema.expr_check.checkArgs
import sema.program.Program
import sema.types.ERROR
import syntax.ast.Arg
import syntax.ast.Expr
import syntax.ast.ExprKind

// Checks the payload of variant `index` of enum `id`, built at `at`.
fn build(c: mut Checker, p: Program, at: &Expr, args: Option<&List<Arg>>, id: int, index: int,
         selfType: int, expected: int) int {
    enumVariants(c, p, id)
    let name = variantsOf(c, id).variants[index].name
    let types = variantsOf(c, id).variants[index].types.clone()
    let count = types.len()
    if args.isNone() && count > 0 {
        c.error("E0302", at.span, "the variant `{c.text(name)}` takes {count} values")
    }
    if args.isSome() && count == 0 {
        c.error("E0302", at.span, "the variant `{c.text(name)}` takes no values: write it "
                + "without parentheses")
    }
    let none: List<Arg> = []
    let given = args ?? &none
    let owner = itemTypeParams(itemOf(p, c.loc(id)))
    if owner.len() > 0 {   // the arguments come from `self`, the expected type or the payload
        var inf = inferNew(Generics{owner: owner.clone(), fnParams: []})
        inferFromSelf(c, inf, selfType, owner.len())
        let selfType = ownerType(c, p, id)
        var params: List<int> = []
        if args.isSome() && count > 0 {
            params = types
        }
        let used = if args.isSome() && count > 0 { given } else { &none }
        return checkGenericArgs(c, p, at.id.0, at.span, used, &params, selfType, inf,
                                expected)
    }
    let ty = c.types.adt(id, [])
    if args.isNone() || count == 0 {
        return ty
    }
    return checkArgs(c, p, at.span, given, &types, ty)
}

/**
 * `Some(x)`, `None`, `Ok(v)`, `Err(e)`: the variants the prelude names.
 *
 * @param c the checker
 * @param p the program
 * @param e the name or the call
 * @param def the variant's `DefId`
 * @param args the arguments of a call
 * @param expected the type the context expects
 * @returns its type
 */
pub fn checkPreludeVariant(c: mut Checker, p: Program, e: &Expr, def: int,
                           args: Option<&List<Arg>>, expected: int) int {
    let id = c.def(def).target
    let index = c.def(def).member
    c.setMember(e.id.0, index)
    return build(c, p, e, args, id, index, ERROR, expected)
}

fn noVariant(c: mut Checker, span: Span, name: Symbol, ty: int) int {
    c.error("E0320", span, "no variant `{c.text(name)}` in `{c.typeName(ty)}`")
    return ERROR
}

/**
 * `.Circle(1.0)`: the enum comes from the expected type.
 *
 * @param c the checker
 * @param p the program
 * @param e the variant expression
 * @param expected the type the context expects
 * @returns its type
 */
pub fn checkVariantShorthand(c: mut Checker, p: Program, e: &Expr, expected: int) int {
    match e.kind {
        .Variant(name, args, hasArgs) => {
            let Some(id) = enumOf(c, p, expected) else {
                let text = c.text(name).toOwned()
                c.error("E0320", e.span, "cannot tell which enum `.{text}` belongs to: write "
                        + "`Enum.{text}`")
                return ERROR
            }
            let index = variantIndex(variantsOf(c, id), name)
            if index < 0 {
                return noVariant(c, e.span, name, expected)
            }
            c.setMember(e.id.0, index)
            var given: Option<&List<Arg>> = .None
            if hasArgs {
                given = .Some(&args)
            }
            return build(c, p, e, given, id, index, expected, expected)
        }
        _ => {
            return ERROR
        }
    }
}

/**
 * `Shape.Circle(1.0)` (a call) or `Shape.Empty` (a field).
 *
 * @param c the checker
 * @param p the program
 * @param e the call or the field
 * @param field the `Shape.Circle` part
 * @param name the variant's name
 * @param args the call's arguments
 * @param id the enum
 * @param selfType the instance named, `Opt<int>` in `Opt<int>.None`, or `ERROR`
 * @param expected the type the context expects
 * @returns its type, `None` when `name` is not a variant (maybe a method)
 */
pub fn checkQualifiedVariant(c: mut Checker, p: Program, e: &Expr, field: &Expr,
                             name: Symbol, args: Option<&List<Arg>>, id: int,
                             selfType: int, expected: int) Option<int> {
    let index = if enumVariants(c, p, id) { variantIndex(variantsOf(c, id), name) } else { -1 }
    if index < 0 {
        return .None
    }
    c.setMember(field.id.0, index)
    return .Some(build(c, p, e, args, id, index, selfType, expected))
}
