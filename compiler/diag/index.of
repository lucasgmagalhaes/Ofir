/**
 * @module
 * Diagnostics: errors and warnings collected during compilation and
 * rendered at the end, sorted by position, in the format of stage 0
 * (bootstrap/src/diag/diag.c). Codes come from docs/errors/README.md.
 */

import base.span.FileId
import base.span.SourceMap
import base.span.Span

/**
 * How serious a diagnostic is.
 */
pub copy enum Severity {
    /** The compilation fails. */
    Error
    /** The compilation goes on; `--deny-warnings` makes it an error. */
    Warning
}

/**
 * How diagnostics are written.
 */
pub copy enum Format {
    /** A source excerpt with a caret under the span. */
    Human
    /** One line each: `file:line:col: error[E0001]: message`. */
    Short
    /** One JSON object per line (docs/design/toolchain.md). */
    Json
}

/**
 * One error or warning.
 */
pub struct Diagnostic {
    /** How serious it is. */
    pub severity: Severity
    /** Its code, as `E0001` or `W0002`. */
    pub code: str
    /** What it points to. */
    pub span: Span
    /** What went wrong. */
    pub message: str
}

/**
 * The diagnostics of a compilation.
 *
 * @example
 * ```ofir
 * var diags = Diagnostics.new()
 * diags.error("E0001", span, "unexpected character")
 * assert(diags.hasErrors())
 * ```
 */
pub struct Diagnostics {
    items: List<Diagnostic>
    errors: int
    // The spans where a warning code is silenced (`@allow`, spec 12.1).
    allowedCodes: List<str>
    allowedSpans: List<Span>
    /** `--deny-warnings`: warnings are reported as errors. */
    pub denyWarnings: bool

    /**
     * No diagnostics yet.
     *
     * @returns the collection
     */
    pub fn new() Diagnostics {
        return Diagnostics{items: [], errors: 0, allowedCodes: [], allowedSpans: [],
                           denyWarnings: false}
    }

    /**
     * Records an error.
     *
     * @param code its code, as `E0300`
     * @param span what it points to
     * @param message what went wrong
     */
    pub fn error(mut self, code: str, span: Span, message: move str) {
        self.add(Severity.Error, code, span, message)
    }

    /**
     * Records a warning, or an error under `denyWarnings`.
     *
     * @param code its code, as `W0001`
     * @param span what it points to
     * @param message what is suspicious
     */
    pub fn warning(mut self, code: str, span: Span, message: move str) {
        if self.isAllowed(code, span) {
            return
        }
        self.add(if self.denyWarnings { Severity.Error } else { Severity.Warning }, code, span,
                 message)
    }

    /**
     * Silences a warning code inside a span: `@allow(unused)` on a
     * declaration.
     *
     * @param code the warning's code, as `W0001`
     * @param span the declaration
     */
    pub fn allow(mut self, code: str, span: Span) {
        self.allowedCodes.push(code.toOwned())
        self.allowedSpans.push(span)
    }

    /**
     * Whether an error was recorded.
     *
     * @returns true after the first error
     */
    pub fn hasErrors(self) bool {
        return self.errors > 0
    }

    /**
     * The number of errors.
     *
     * @returns the count
     */
    pub fn errorCount(self) int {
        return self.errors
    }

    /**
     * The number of diagnostics, errors and warnings.
     *
     * @returns the count
     */
    pub fn len(self) int {
        return self.items.len()
    }

    /**
     * The text of every diagnostic, sorted by file, offset and code, with
     * exact duplicates left out.
     *
     * @param map the files the spans point into
     * @param format how to write them
     * @returns the text, as stage 0 writes it to standard error
     */
    pub fn render(self, map: SourceMap, format: Format) str {
        var out = ""
        let order = self.sortedOrder()
        for k in 0..order.len() {
            let d = &self.items[order[k]]
            if k > 0 && same(d, &self.items[order[k - 1]]) {
                continue
            }
            if format == Format.Short {
                out.push(shortLine(d, map))
            } else if format == Format.Json {
                out.push(jsonLine(d, map))
            } else {
                out.push(excerpt(d, map))
            }
        }
        return out
    }

    fn isAllowed(self, code: str, span: Span) bool {
        for i in 0..self.allowedCodes.len() {
            let a = self.allowedSpans[i]
            if self.allowedCodes[i] == code && a.file.0 == span.file.0 && a.start <= span.start &&
                span.end <= a.end {
                return true
            }
        }
        return false
    }

    fn add(mut self, severity: Severity, code: str, span: Span, message: move str) {
        if severity == Severity.Error {
            self.errors += 1
        }
        self.items.push(Diagnostic{severity, code: code.toOwned(), span, message})
    }

    // The indices of the diagnostics by (file, start, code), stable: an
    // insertion sort, as a compilation reports few diagnostics.
    fn sortedOrder(self) List<int> {
        var order: List<int> = []
        for i in 0..self.items.len() {
            order.push(i)
            var k = order.len() - 1
            for k > 0 && before(&self.items[order[k]], &self.items[order[k - 1]]) {
                let previous = order[k - 1]
                order[k - 1] = order[k]
                order[k] = previous
                k -= 1
            }
        }
        return order
    }
}

// Whether `a` sorts before `b`: by file, then offset, then code.
fn before(a: &Diagnostic, b: &Diagnostic) bool {
    if a.span.file.0 != b.span.file.0 {
        return a.span.file.0 < b.span.file.0
    }
    if a.span.start != b.span.start {
        return a.span.start < b.span.start
    }
    return a.code < b.code
}

fn same(a: &Diagnostic, b: &Diagnostic) bool {
    return a.span.file.0 == b.span.file.0 && a.span.start == b.span.start &&
        a.code == b.code && a.message == b.message
}

fn severityName(s: Severity) str {
    return if s == Severity.Error { "error" } else { "warning" }
}

fn shortLine(d: &Diagnostic, map: SourceMap) str {
    let file = map.file(d.span.file)
    let at = file.lineCol(d.span.start)
    return "{file.path}:{at.line}:{at.column}: {severityName(d.severity)}[{d.code}]: {d.message}\n"
}

/**
 * A string as a JSON string literal, quotes included.
 *
 * @param text the string
 * @returns the literal
 */
pub fn jsonString(text: str) str {
    var out = "\""
    var copied = 0   // text before it is in `out`
    for i in 0..text.len() {
        let escape = jsonEscape(text[i])
        if escape.len() > 0 {
            out.push(text.slice(copied, i))
            out.push(escape)
            copied = i + 1
        }
    }
    out.push(text.sliceFrom(copied))
    out.push("\"")
    return out
}

// The JSON escape of a byte, "" for one copied as it is.
fn jsonEscape(b: u8) str {
    if b == b'"' {
        return "\\\"".toOwned()
    } else if b == b'\\' {
        return "\\\\".toOwned()
    } else if b == b'\n' {
        return "\\n".toOwned()
    } else if b == b'\t' {
        return "\\t".toOwned()
    } else if b < 32 {
        let digits = "0123456789abcdef"
        let high = b as int / 16
        let low = b as int % 16
        return "\\u00{digits.slice(high, high + 1)}{digits.slice(low, low + 1)}"
    }
    return "".toOwned()
}

/**
 * A diagnostic that points at no source, as a JSON line.
 *
 * @param severity its severity
 * @param code its code
 * @param message what went wrong
 * @returns the line, with its `\n`
 */
pub fn jsonNoSource(severity: Severity, code: str, message: str) str {
    return "{jsonFields(severity, code, message)}\}\n"
}

// The opening `{` and the fields every JSON diagnostic has.
fn jsonFields(severity: Severity, code: str, message: str) str {
    let head = "\{\"severity\":\"{severityName(severity)}\",\"code\":{jsonString(code)}"
    return "{head},\"message\":{jsonString(message)}"
}

fn jsonLine(d: &Diagnostic, map: SourceMap) str {
    let file = map.file(d.span.file)
    let at = file.lineCol(d.span.start)
    let end = file.lineCol(if d.span.end > d.span.start { d.span.end } else { d.span.start })
    var out = jsonFields(d.severity, d.code, d.message)
    out.push(",\"file\":{jsonString(file.path)},\"line\":{at.line},\"column\":{at.column},")
    out.push("\"endLine\":{end.line},\"endColumn\":{end.column}\}\n")
    return out
}

// The message, the location, the line and a caret line under the span.
fn excerpt(d: &Diagnostic, map: SourceMap) str {
    let file = map.file(d.span.file)
    let at = file.lineCol(d.span.start)
    let line = file.lineText(at.line)
    let number = "{at.line}"
    let pad = " ".repeat(number.len())
    var out = "{severityName(d.severity)}[{d.code}]: {d.message}\n"
    out.push("{pad}--> {file.path}:{at.line}:{at.column}\n")
    out.push("{pad} |\n")
    out.push("{number} | {line}\n")
    out.push("{pad} | ")
    for i in 0..at.column - 1 {   // tabs are kept so the caret stays under the text
        out.push(if line[i] == b'\t' { "\t" } else { " " })
    }
    var len = if d.span.end > d.span.start { d.span.end - d.span.start } else { 1 }
    if at.column - 1 + len > line.len() + 1 {   // a span running past the line is clipped
        len = line.len() + 1 - (at.column - 1)
    }
    out.push("^".repeat(len))
    out.push("\n\n")
    return out
}

/**
 * A span for tests and diagnostics that have no source: offset 0 of file 0.
 *
 * @returns the span
 */
pub fn noSpan() Span {
    return Span{file: FileId(0), start: 0, end: 0}
}
