/**
 * @module
 * Types (spec appendix A.4), type parameters and parameter modes
 * (stage 0: bootstrap/src/syntax/parse_types.c).
 */

import base.intern.Symbol
import base.span.Span
import syntax.ast.Mode
import syntax.ast.Op
import syntax.ast.TypeExpr
import syntax.ast.TypeKind
import syntax.ast.WherePred
import syntax.parse_exprs.parseExpr
import syntax.parser.Parser
import syntax.token.TokenKind
import syntax.token.TokenValue

fn newType(p: Parser, kind: move TypeKind, start: Span) TypeExpr {
    return TypeExpr{kind, span: p.spanSince(start)}
}

/**
 * Whether the current token can start a type.
 *
 * @param p the parser
 * @returns true for a name, `&`, `*`, `[`, `(`, `fn`, `dyn`, `!` or `Self`
 */
pub fn canStartType(p: Parser) bool {
    return match p.peek() {
        TokenKind.Ident | TokenKind.Amp | TokenKind.Star | TokenKind.LBracket | TokenKind.LParen |
        TokenKind.Fn | TokenKind.Dyn | TokenKind.Bang | TokenKind.SelfType => true
        _ => false
    }
}

/**
 * An optional parameter mode: `mut` or `move`.
 *
 * @param p the parser
 * @returns the mode, `Borrow` when there is none
 */
pub fn parseMode(p: mut Parser) Mode {
    if p.accept(TokenKind.Mut) {
        return Mode.Mut
    }
    if p.atWord(p.words.move) && p.peekAt(1) != TokenKind.Colon {
        p.advance()
        return Mode.Move
    }
    return Mode.Borrow
}

/**
 * Type arguments after `<`: `T, U>`.
 *
 * @param p the parser
 * @returns the types
 */
pub fn parseTypeArgs(p: mut Parser) List<TypeExpr> {
    var args: List<TypeExpr> = []
    p.skipNewlines()
    for !p.at(TokenKind.Gt) && !p.at(TokenKind.Eof) {
        args.push(parseType(p))
        p.skipNewlines()
        if !p.accept(TokenKind.Comma) {
            break
        }
        p.skipNewlines()
    }
    p.expect(TokenKind.Gt, "`>` to close the type arguments")
    return args
}

/**
 * The bounds after `:`: `Eq + Hash`.
 *
 * @param p the parser
 * @returns them
 */
pub fn parseBounds(p: mut Parser) List<TypeExpr> {
    var bounds = [parseType(p)]
    for p.accept(TokenKind.Plus) {
        bounds.push(parseType(p))
    }
    return bounds
}

/**
 * Optional type parameters: `<T, U: Eq>`.
 *
 * @param p the parser
 * @param preds where the inline bounds go
 * @returns their names
 */
pub fn parseTypeParams(p: mut Parser, preds: mut List<WherePred>) List<Symbol> {
    var params: List<Symbol> = []
    if p.accept(TokenKind.Lt) {
        for p.at(TokenKind.Ident) {
            let start = p.here()
            let name = p.takeName()
            params.push(name)
            if p.accept(TokenKind.Colon) {
                let ty = newType(p, TypeKind.Path([name], []), start)
                let bounds = parseBounds(p)
                preds.push(WherePred{ty, bounds, span: p.spanSince(start)})
            }
            if !p.accept(TokenKind.Comma) {
                break
            }
        }
        p.expect(TokenKind.Gt, "`>` to close the type parameters")
    }
    return params
}

fn pathType(p: mut Parser) TypeExpr {
    let start = p.here()
    var segments = [p.takeName()]
    for p.at(TokenKind.Dot) && p.peekAt(1) == TokenKind.Ident {
        p.advance()
        segments.push(p.takeName())
    }
    var args: List<TypeExpr> = []
    if p.accept(TokenKind.Lt) {
        args = parseTypeArgs(p)
    }
    return newType(p, TypeKind.Path(segments, args), start)
}

// `fn(A, mut B) R` or `move fn(A) R`; the `fn` keyword is next.
fn fnType(p: mut Parser, start: Span, owned: bool) TypeExpr {
    p.advance()
    p.expect(TokenKind.LParen, "`(` after `fn`")
    var params: List<TypeExpr> = []
    var modes: List<Mode> = []
    for !p.at(TokenKind.RParen) && !p.at(TokenKind.Eof) {
        modes.push(parseMode(p))
        params.push(parseType(p))
        if !p.accept(TokenKind.Comma) {
            break
        }
    }
    p.expect(TokenKind.RParen, "`)` to close the parameter types")
    var ret: Option<Box<TypeExpr>> = Option.None
    if canStartType(p) {
        ret = Option.Some(Box.new(parseType(p)))
    }
    return newType(p, TypeKind.Fn(params, modes, ret, owned), start)
}

// `[T]` or `[T; N]`; the `[` is next.
fn bracketType(p: mut Parser, start: Span) TypeExpr {
    p.advance()
    let elem = Box.new(parseType(p))
    if p.accept(TokenKind.Semicolon) {
        let len = Box.new(parseExpr(p))
        p.expect(TokenKind.RBracket, "`]`")
        return newType(p, TypeKind.Array(elem, len), start)
    }
    p.expect(TokenKind.RBracket, "`]`")
    return newType(p, TypeKind.Slice(elem), start)
}

// `()`, `(T,)`, `(A, B)`; the `(` is next.
fn tupleType(p: mut Parser, start: Span) TypeExpr {
    p.advance()
    var elems: List<TypeExpr> = []
    for !p.at(TokenKind.RParen) && !p.at(TokenKind.Eof) {
        elems.push(parseType(p))
        if !p.accept(TokenKind.Comma) {
            break
        }
    }
    p.expect(TokenKind.RParen, "`)` to close the tuple type")
    return newType(p, TypeKind.Tuple(elems), start)
}

fn pointerType(p: mut Parser, start: Span, reference: bool, ops: bool) TypeExpr {
    p.advance()
    let mutable = p.accept(TokenKind.Mut)
    let inner = Box.new(typeIn(p, ops))
    let kind: TypeKind = if reference {
        TypeKind.Ref(mutable, inner)
    } else {
        TypeKind.Ptr(mutable, inner)
    }
    return newType(p, kind, start)
}

// Whether `keyof` starts the type here: it is a keyword only before a type.
fn atKeyOf(p: Parser) bool {
    if !p.atWord(p.words.keyof) {
        return false
    }
    let next = p.peekAt(1)
    return next == TokenKind.Ident || next == TokenKind.LParen || next == TokenKind.SelfType
}

// `.x` or `.0`; the `.` is next.
fn keyLiteral(p: mut Parser, start: Span) TypeExpr {
    p.advance()
    var name = Symbol(0)
    if p.at(TokenKind.Int) {
        let index: u64 = match p.token(0).value {
            TokenValue.Int(value) => value
            _ => 0
        }
        p.advance()
        name = p.names.intern("{index}")
    } else {
        name = p.expectName("a field name or index after `.`") ?? Symbol(0)
    }
    return newType(p, TypeKind.Key(name), start)
}

// `{ [K in Keys if Cond]?: F }`; the `{` is next.
fn mappedType(p: mut Parser, start: Span) TypeExpr {
    p.advance()
    p.skipNewlines()
    p.expect(TokenKind.LBracket, "`[` to start the mapped field")
    let param = p.expectName("the key parameter of the mapped type") ?? Symbol(0)
    p.expect(TokenKind.In, "`in` after the key parameter")
    let keys = Box.new(parseType(p))
    var filter: Option<Box<TypeExpr>> = Option.None
    if p.accept(TokenKind.If) {
        filter = Option.Some(Box.new(condition(p)))
    }
    p.expect(TokenKind.RBracket, "`]` to close the mapped keys")
    let optional = p.accept(TokenKind.Question)
    p.expect(TokenKind.Colon, "`:` before the field type")
    let field = Box.new(parseType(p))
    p.skipNewlines()
    p.expect(TokenKind.RBrace, "`\}` to close the mapped type")
    return newType(p, TypeKind.Mapped(param, keys, filter, optional, field), start)
}

// A condition: `A is B`, or a type that is `true` or `false`.
fn condition(p: mut Parser) TypeExpr {
    let left = typeIn(p, true)
    if !p.atWord(p.words.is) {
        return left
    }
    let start = left.span
    p.advance()
    let pattern = Box.new(typeIn(p, true))
    return newType(p, TypeKind.Is(Box.new(left), pattern), start)
}

// `{ X }`, a branch of a conditional type.
fn branchType(p: mut Parser) TypeExpr {
    p.expect(TokenKind.LBrace, "`\{` before the branch type")
    p.skipNewlines()
    let t = parseType(p)
    p.skipNewlines()
    p.expect(TokenKind.RBrace, "`\}` after the branch type")
    return t
}

// `if A is B { X } else { Y }`, with `else if`; the `if` is next.
fn condType(p: mut Parser, start: Span) TypeExpr {
    p.advance()
    let test = Box.new(condition(p))
    let then = Box.new(branchType(p))
    p.expect(TokenKind.Else, "`else`: a conditional type has both branches")
    let otherwise = if p.at(TokenKind.If) {
        let elseStart = p.here()
        Box.new(condType(p, elseStart))
    } else {
        Box.new(branchType(p))
    }
    return newType(p, TypeKind.Cond(test, then, otherwise), start)
}

// A mapped type, a conditional type, `true` or `false`.
fn typeOperator(p: mut Parser, start: Span) TypeExpr {
    if p.at(TokenKind.LBrace) {
        return mappedType(p, start)
    }
    if p.at(TokenKind.If) {
        return condType(p, start)
    }
    let value = p.at(TokenKind.True)
    p.advance()
    return newType(p, TypeKind.Bool(value), start)
}

fn baseType(p: mut Parser, ops: bool) TypeExpr {
    let start = p.here()
    return match p.peek() {
        TokenKind.Ident => if p.atWord(p.words.move) && p.peekAt(1) == TokenKind.Fn {
            p.advance()
            fnType(p, start, true)
        } else if ops && atKeyOf(p) {
            p.advance()
            let inner = Box.new(postfixType(p, true))
            newType(p, TypeKind.KeyOf(inner), start)
        } else if ops && p.atWord(p.words.infer) && p.peekAt(1) == TokenKind.Ident {
            p.advance()
            let name = p.takeName()
            newType(p, TypeKind.Infer(name), start)
        } else {
            pathType(p)
        }
        TokenKind.SelfType => {
            p.advance()
            newType(p, TypeKind.SelfType, start)
        }
        TokenKind.Amp => pointerType(p, start, true, ops)
        TokenKind.Star => pointerType(p, start, false, ops)
        TokenKind.Dot => if ops {
            keyLiteral(p, start)
        } else {
            p.unexpected("a type")
            newType(p, TypeKind.Never, start)
        }
        TokenKind.LBrace | TokenKind.If | TokenKind.True | TokenKind.False => if ops {
            typeOperator(p, start)
        } else {
            p.unexpected("a type")
            newType(p, TypeKind.Never, start)
        }
        TokenKind.LBracket => bracketType(p, start)
        TokenKind.LParen => tupleType(p, start)
        TokenKind.Fn => fnType(p, start, false)
        TokenKind.Bang => {
            p.advance()
            newType(p, TypeKind.Never, start)
        }
        TokenKind.Dyn => {
            p.advance()
            let inner = Box.new(typeIn(p, ops))
            newType(p, TypeKind.Dyn(inner), start)
        }
        _ => {
            p.unexpected("a type")
            newType(p, TypeKind.Never, start)
        }
    }
}

// A type with its postfix `?` and, with `ops`, `[K]` (spec 16.3).
fn postfixType(p: mut Parser, ops: bool) TypeExpr {
    var t = baseType(p, ops)
    for {
        let start = t.span
        if p.accept(TokenKind.Question) {
            t = newType(p, TypeKind.Optional(Box.new(t)), start)
        } else if ops && p.accept(TokenKind.LBracket) {
            let key = Box.new(parseType(p))
            p.expect(TokenKind.RBracket, "`]` to close the key")
            t = newType(p, TypeKind.Index(Box.new(t), key), start)
        } else {
            return t
        }
    }
}

// `&` and `-` on key types, left-associative and tighter than `|`.
fn keyTerm(p: mut Parser) TypeExpr {
    var t = postfixType(p, true)
    for p.at(TokenKind.Amp) || p.at(TokenKind.Minus) {
        let start = t.span
        let op = if p.at(TokenKind.Amp) { Op.And } else { Op.Sub }
        p.advance()
        let right = Box.new(postfixType(p, true))
        t = newType(p, TypeKind.KeyOp(op, Box.new(t), right), start)
    }
    return t
}

fn typeIn(p: mut Parser, ops: bool) TypeExpr {
    if !ops {
        return postfixType(p, false)
    }
    var t = keyTerm(p)
    for p.accept(TokenKind.Pipe) {
        let start = t.span
        let right = Box.new(keyTerm(p))
        t = newType(p, TypeKind.KeyOp(Op.Or, Box.new(t), right), start)
    }
    return t
}

/**
 * A type; `T?` is `Option<T>`. Key types (spec 16.1-16.3) are included:
 * `keyof T`, `.x`, `A | B`, `A & B`, `A - B` and `T[K]`.
 *
 * @param p the parser
 * @returns the type
 */
pub fn parseType(p: mut Parser) TypeExpr {
    return typeIn(p, true)
}

/**
 * A type without key operators or indexed access: the target of `as` and
 * of a type test, where `|`, `&`, `-` and `[` belong to the expression or
 * the pattern around it.
 *
 * @param p the parser
 * @returns the type
 */
pub fn parseSimpleType(p: mut Parser) TypeExpr {
    return typeIn(p, false)
}
