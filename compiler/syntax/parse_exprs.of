/**
 * @module
 * Operator expressions: precedence climbing over the table of spec 4.8
 * (stage 0: bootstrap/src/syntax/parse_exprs.c). Primary and postfix
 * expressions are in `syntax.parse_primary`.
 */

import base.span.Span
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.Op
import syntax.parse_primary.parsePostfix
import syntax.parse_primary.parsePrimary
import syntax.parse_types.parseSimpleType
import syntax.parser.Parser
import syntax.token.TokenKind

/**
 * An expression node from `start` to the previous token.
 *
 * @param p the parser
 * @param kind what it is
 * @param start where it began
 * @returns the node
 */
pub fn newExpr(p: mut Parser, kind: move ExprKind, start: Span) Expr {
    return Expr{id: p.newId(), kind, span: p.spanSince(start)}
}

fn binary(p: mut Parser, op: Op, lhs: move Expr, rhs: move Expr) Expr {
    let start = lhs.span
    return newExpr(p, ExprKind.Binary(op, Box.new(lhs), Box.new(rhs)), start)
}

// Two tokens with no space between them, such as the `>` `>` of a shift.
fn adjacent(p: Parser, ahead: int) bool {
    return p.token(ahead).span.end == p.token(ahead + 1).span.start
}

// The lexer emits `>` alone (spec 1.6): `>>`, `>=` and `>>=` are joined
// here. The operator and how many tokens it spans (0: none).
fn gtOperator(p: Parser) (Op, int) {
    if p.peekAt(1) == TokenKind.Gt && adjacent(p, 0) {
        let assign = p.peekAt(2) == TokenKind.Eq && adjacent(p, 1)
        return (Op.Shr, if assign { 0 } else { 2 })   // `>>=` is an assignment
    }
    if p.peekAt(1) == TokenKind.Eq && adjacent(p, 0) {
        let equality = p.peekAt(2) == TokenKind.Eq && adjacent(p, 1)
        return (Op.Ge, if equality { 0 } else { 2 })   // `>==` is not an operator
    }
    return (Op.Gt, 1)
}

// The levels of spec 4.8: || 2, && 3, comparisons 4, + - | ^ 5,
// * / % << >> & 6; 0 for no operator.
fn operatorAt(p: Parser) (int, Op, int) {
    return match p.peek() {
        TokenKind.OrOr => (2, Op.LogicalOr, 1)
        TokenKind.AndAnd => (3, Op.LogicalAnd, 1)
        TokenKind.EqEq => (4, Op.Eq, 1)
        TokenKind.Ne => (4, Op.Ne, 1)
        TokenKind.Lt => (4, Op.Lt, 1)
        TokenKind.Le => (4, Op.Le, 1)
        TokenKind.Plus => (5, Op.Add, 1)
        TokenKind.Minus => (5, Op.Sub, 1)
        TokenKind.Pipe => (5, Op.Or, 1)
        TokenKind.Caret => (5, Op.Xor, 1)
        TokenKind.Star => (6, Op.Mul, 1)
        TokenKind.Slash => (6, Op.Div, 1)
        TokenKind.Percent => (6, Op.Rem, 1)
        TokenKind.Shl => (6, Op.Shl, 1)
        TokenKind.Amp => (6, Op.And, 1)
        TokenKind.Gt => gtLevel(p)
        _ => (0, Op.Add, 0)
    }
}

fn gtLevel(p: Parser) (int, Op, int) {
    let gt = gtOperator(p)
    if gt.1 == 0 {
        return (0, gt.0, 0)
    }
    return (if gt.0 == Op.Shr { 6 } else { 4 }, gt.0, gt.1)
}

fn castExpr(p: mut Parser) Expr {
    var e = unary(p)
    for p.accept(TokenKind.As) {
        let start = e.span
        let to = parseSimpleType(p)
        e = newExpr(p, ExprKind.Cast(Box.new(e), to), start)
    }
    return e
}

// Precedence climbing: the operators of level `min` and above.
fn binaryExpr(p: mut Parser, min: int) Expr {
    var lhs = castExpr(p)
    for {
        let found = operatorAt(p)
        if found.0 == 0 || found.0 < min {
            return lhs
        }
        p.pos += found.2
        p.skipNewlines()   // an operator at the end of a line continues it
        let rhs = binaryExpr(p, found.0 + 1)
        lhs = binary(p, found.1, lhs, rhs)
        if found.0 == 4 && operatorAt(p).0 == 4 {
            p.syntaxError(p.here(), "comparison operators cannot be chained; use `&&`".toOwned())
        }
    }
}

fn coalesce(p: mut Parser) Expr {
    let lhs = binaryExpr(p, 2)
    if !p.accept(TokenKind.QuestionQuestion) {
        return lhs
    }
    p.skipNewlines()
    let rhs = coalesce(p)   // right-associative
    return binary(p, Op.Coalesce, lhs, rhs)
}

fn canEndRange(p: Parser) bool {
    return match p.peek() {
        TokenKind.Newline | TokenKind.Eof | TokenKind.RParen | TokenKind.RBracket |
        TokenKind.RBrace | TokenKind.Comma | TokenKind.LBrace => true
        _ => false
    }
}

/**
 * An expression, a range included.
 *
 * @param p the parser
 * @returns the expression
 */
pub fn parseExpr(p: mut Parser) Expr {
    let start = p.here()
    let atRange = p.at(TokenKind.DotDot) || p.at(TokenKind.DotDotEq)
    var lo: Option<Box<Expr>> = Option.None
    if !atRange {
        let first = coalesce(p)
        if !p.at(TokenKind.DotDot) && !p.at(TokenKind.DotDotEq) {
            return first
        }
        lo = Option.Some(Box.new(first))
    }
    let inclusive = p.peek() == TokenKind.DotDotEq
    p.advance()
    var hi: Option<Box<Expr>> = Option.None
    if !canEndRange(p) {
        hi = Option.Some(Box.new(coalesce(p)))
    }
    return newExpr(p, ExprKind.Range(lo, hi, inclusive), start)
}

/**
 * An expression where a struct literal cannot start: the header of `if`,
 * `match` and `for` (spec A.6).
 *
 * @param p the parser
 * @returns the expression
 */
pub fn parseExprNoStruct(p: mut Parser) Expr {
    let saved = p.noStructLiteral
    p.noStructLiteral = true
    let e = parseExpr(p)
    p.noStructLiteral = saved
    return e
}

fn unary(p: mut Parser) Expr {
    let start = p.here()
    let op: Op = match p.peek() {
        TokenKind.Minus => Op.Neg
        TokenKind.Bang => Op.Not
        TokenKind.Star => Op.Deref
        TokenKind.Amp => if p.peekAt(1) == TokenKind.Mut { Op.RefMut } else { Op.Ref }
        _ => Op.Assign   // no unary operator
    }
    if op == Op.Assign {
        let base = parsePrimary(p)
        return parsePostfix(p, base)
    }
    p.advance()
    if op == Op.RefMut {
        p.advance()   // mut
    }
    let operand = unary(p)
    return newExpr(p, ExprKind.Unary(op, Box.new(operand)), start)
}
