/**
 * @module
 * Statements (spec appendix A.5; stage 0: bootstrap/src/syntax/parse_stmts.c).
 */

import base.intern.Symbol
import base.span.Span
import syntax.ast.Block
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.ForKind
import syntax.ast.Op
import syntax.ast.Stmt
import syntax.ast.StmtKind
import syntax.ast.TypeExpr
import syntax.parse_control.parseBlock
import syntax.parse_exprs.parseExpr
import syntax.parse_exprs.parseExprNoStruct
import syntax.parse_patterns.parsePattern
import syntax.parse_types.parseType
import syntax.parser.Parser
import syntax.token.TokenKind

fn newStmt(p: mut Parser, kind: move StmtKind, start: Span) Stmt {
    return Stmt{id: p.newId(), kind, span: p.spanSince(start)}
}

fn optionalType(p: mut Parser) Option<TypeExpr> {
    if p.accept(TokenKind.Colon) {
        return Option.Some(parseType(p))
    }
    return Option.None
}

// The value of `let` when `=` is missing: an empty tuple, as nothing else.
fn missingValue(p: mut Parser) Expr {
    return Expr{id: p.newId(), kind: ExprKind.Tuple([]), span: p.here()}
}

// `let pattern: T = value` and `let pattern = value else { ... }`.
fn letStmt(p: mut Parser, start: Span) Stmt {
    let pattern = parsePattern(p)
    let ty = optionalType(p)
    var value = missingValue(p)
    if p.expect(TokenKind.Eq, "`=` in `let`") {
        p.skipNewlines()
        value = parseExpr(p)
    }
    var otherwise: Option<Block> = Option.None
    if p.accept(TokenKind.Else) {
        otherwise = Option.Some(parseBlock(p))
    }
    return newStmt(p, StmtKind.Let(pattern, ty, value, otherwise), start)
}

fn varStmt(p: mut Parser, start: Span) Stmt {
    let name = p.expectName("a variable name after `var`") ?? Symbol(0)
    let ty = optionalType(p)
    var value: Option<Expr> = Option.None
    if p.accept(TokenKind.Eq) {
        p.skipNewlines()
        value = Option.Some(parseExpr(p))
    }
    return newStmt(p, StmtKind.Var(name, ty, value), start)
}

// Whether the tokens after `for` are `[mut] name [, name] in`.
fn atForIn(p: Parser) bool {
    let i = if p.at(TokenKind.Mut) { 1 } else { 0 }
    if p.peekAt(i) != TokenKind.Ident {
        return false
    }
    if p.peekAt(i + 1) == TokenKind.Comma {
        return p.peekAt(i + 2) == TokenKind.Ident && p.peekAt(i + 3) == TokenKind.In
    }
    return p.peekAt(i + 1) == TokenKind.In
}

fn forStmt(p: mut Parser, start: Span) Stmt {
    var kind: ForKind = ForKind.Cond
    var mutable = false
    var first: Option<Symbol> = Option.None
    var second: Option<Symbol> = Option.None
    var expr: Option<Expr> = Option.None
    if p.at(TokenKind.LBrace) {
        kind = ForKind.Infinite
    } else if atForIn(p) {
        kind = ForKind.In
        mutable = p.accept(TokenKind.Mut)
        first = Option.Some(p.takeName())
        if p.accept(TokenKind.Comma) {
            second = Option.Some(p.takeName())
        }
        p.advance()   // in
        expr = Option.Some(parseExprNoStruct(p))
    } else {
        expr = Option.Some(parseExprNoStruct(p))
    }
    let body = parseBlock(p)
    return newStmt(p, StmtKind.For(kind, mutable, first, second, expr, body), start)
}

fn atStatementEnd(p: Parser) bool {
    return p.at(TokenKind.Newline) || p.at(TokenKind.RBrace) || p.at(TokenKind.Eof)
}

// The assignment operator at the cursor, joining `>` `>` `=` into `>>=`,
// and how many tokens it spans (0: none).
fn assignOp(p: Parser) (Op, int) {
    return match p.peek() {
        TokenKind.Eq => (Op.Assign, 1)
        TokenKind.PlusEq => (Op.Add, 1)
        TokenKind.MinusEq => (Op.Sub, 1)
        TokenKind.StarEq => (Op.Mul, 1)
        TokenKind.SlashEq => (Op.Div, 1)
        TokenKind.PercentEq => (Op.Rem, 1)
        TokenKind.AmpEq => (Op.And, 1)
        TokenKind.PipeEq => (Op.Or, 1)
        TokenKind.CaretEq => (Op.Xor, 1)
        TokenKind.ShlEq => (Op.Shl, 1)
        TokenKind.Gt => (Op.Shr, if shiftAssign(p) { 3 } else { 0 })
        _ => (Op.Assign, 0)
    }
}

fn shiftAssign(p: Parser) bool {
    let a = p.token(0)
    let b = p.token(1)
    let c = p.token(2)
    return b.kind == TokenKind.Gt && c.kind == TokenKind.Eq && a.span.end == b.span.start &&
        b.span.end == c.span.start
}

// An expression statement, or an assignment if an assignment operator follows.
fn exprStmt(p: mut Parser, start: Span) Stmt {
    let target = parseExpr(p)
    let op = assignOp(p)
    if op.1 == 0 {
        return newStmt(p, StmtKind.ExprStmt(target), start)
    }
    p.pos += op.1
    p.skipNewlines()
    let value = parseExpr(p)
    return newStmt(p, StmtKind.Assign(op.0, target, value), start)
}

/**
 * A statement.
 *
 * @param p the parser
 * @returns the statement
 */
pub fn parseStmt(p: mut Parser) Stmt {
    let start = p.here()
    return match p.peek() {
        TokenKind.Let | TokenKind.Const => {
            p.advance()
            letStmt(p, start)
        }
        TokenKind.Var => {
            p.advance()
            varStmt(p, start)
        }
        TokenKind.For => {
            p.advance()
            forStmt(p, start)
        }
        TokenKind.Break => {
            p.advance()
            newStmt(p, StmtKind.Break, start)
        }
        TokenKind.Continue => {
            p.advance()
            newStmt(p, StmtKind.Continue, start)
        }
        TokenKind.Return => {
            p.advance()
            var value: Option<Expr> = Option.None
            if !atStatementEnd(p) {
                value = Option.Some(parseExpr(p))
            }
            newStmt(p, StmtKind.Return(value), start)
        }
        _ => exprStmt(p, start)
    }
}
