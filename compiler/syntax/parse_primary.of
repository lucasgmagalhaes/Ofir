/**
 * @module
 * Primary and postfix expressions: literals, names, aggregates, calls,
 * indexing and field access (stage 0: bootstrap/src/syntax/parse_primary.c).
 * Control flow expressions are in `syntax.parse_control`.
 */

import base.intern.Symbol
import syntax.ast.Arg
import syntax.ast.Expr
import syntax.ast.ExprKind
import syntax.ast.FieldInit
import syntax.ast.Mode
import syntax.ast.Op
import syntax.ast.Param
import syntax.ast.TypeExpr
import syntax.ast.TypeKind
import syntax.parse_control.parseControl
import syntax.parse_exprs.newExpr
import syntax.parse_exprs.parseExpr
import syntax.parse_types.parseMode
import syntax.parse_types.parseType
import syntax.parse_types.parseTypeArgs
import syntax.parser.Parser
import syntax.parser.symbolOf
import syntax.parser.textOf
import syntax.token.TokenKind
import syntax.token.TokenValue
import syntax.token.TokenValue

// ---------------------------------------------------------------------------
// Literals

/**
 * Whether a literal starts here: a number, a string, a byte, `true`,
 * `false`, or `-` before a number.
 *
 * @param p the parser
 * @returns true if one does
 */
pub fn atLiteral(p: Parser) bool {
    return match p.peek() {
        TokenKind.Int | TokenKind.Float | TokenKind.Byte | TokenKind.Str | TokenKind.ByteStr |
        TokenKind.True | TokenKind.False => true
        TokenKind.Minus => p.peekAt(1) == TokenKind.Int || p.peekAt(1) == TokenKind.Float
        _ => false
    }
}

fn literalToken(p: mut Parser) Expr {
    let t = p.token(0)
    let kind: ExprKind = match t.value {
        TokenValue.Int(v) => ExprKind.Int(v)
        TokenValue.Float(v) => ExprKind.Float(v)
        TokenValue.Byte(v) => ExprKind.Byte(v)
        TokenValue.Str(text) => if t.kind == TokenKind.ByteStr {
            ExprKind.ByteStr(text.toOwned())
        } else {
            ExprKind.Str(text.toOwned())
        }
        _ => ExprKind.Bool(t.kind == TokenKind.True)
    }
    let start = p.advance()
    return newExpr(p, kind, start)
}

/**
 * A literal, `-` before a number included. Call it where `atLiteral`
 * holds; elsewhere it consumes nothing and returns `()`.
 *
 * @param p the parser
 * @returns the literal
 */
pub fn parseLiteral(p: mut Parser) Expr {
    if !atLiteral(p) {
        return newExpr(p, ExprKind.Tuple([]), p.here())
    }
    if p.at(TokenKind.Minus) {
        let start = p.advance()
        let operand = literalToken(p)
        return newExpr(p, ExprKind.Unary(Op.Neg, Box.new(operand)), start)
    }
    return literalToken(p)
}

// "a {x} b": StrStart, the tokens of x, StrMid or StrEnd, ...
fn interpolation(p: mut Parser) Expr {
    let start = p.here()
    var parts: List<Expr> = []
    var specs: List<str> = []
    for {
        let kind = p.peek()
        let text = textOf(p.token(0)).toOwned()
        let span = p.advance()
        if text.len() > 0 {   // "{x}" has empty text around `x`
            parts.push(Expr{id: p.newId(), kind: ExprKind.Str(text), span})
            specs.push("")
        }
        if kind == TokenKind.StrEnd || kind == TokenKind.Eof {
            break
        }
        let saved = p.noStructLiteral
        p.noStructLiteral = false
        parts.push(parseExpr(p))
        p.noStructLiteral = saved
        if p.at(TokenKind.FormatSpec) {
            specs.push(textOf(p.token(0)).toOwned())
            let _ = p.advance()
        } else {
            specs.push("")
        }
        if !p.at(TokenKind.StrMid) && !p.at(TokenKind.StrEnd) {
            p.unexpected("`\}` to close the interpolation")
            break
        }
    }
    return newExpr(p, ExprKind.Interp(parts, specs), start)
}

// ---------------------------------------------------------------------------
// Names

// Whether `<` at `ahead` starts type arguments: the tokens up to the
// matching `>` look like types and the `>` is followed by `(`, `.` or `{`
// (spec 8.5). Pure lookahead.
fn looksLikeTypeArgs(p: Parser, ahead: int) bool {
    var depth = 0
    for i in ahead..ahead + 64 {
        let kind = p.peekAt(i)
        if kind == TokenKind.Lt {
            depth += 1
        } else if kind == TokenKind.Gt {
            depth -= 1
            if depth == 0 {
                let next = p.peekAt(i + 1)
                return next == TokenKind.LParen || next == TokenKind.Dot || next == TokenKind.LBrace
            }
        } else if !inTypeArgs(kind) {
            return false
        }
    }
    return false
}

fn inTypeArgs(kind: TokenKind) bool {
    return match kind {
        TokenKind.Ident | TokenKind.Comma | TokenKind.Amp | TokenKind.Mut | TokenKind.LBracket |
        TokenKind.RBracket | TokenKind.LParen | TokenKind.RParen => true
        TokenKind.Question | TokenKind.Star | TokenKind.Semicolon | TokenKind.Int | TokenKind.Fn |
        TokenKind.Dyn | TokenKind.SelfType | TokenKind.Bang | TokenKind.Dot | TokenKind.Pipe => true
        _ => false
    }
}

fn name(p: mut Parser) Expr {
    let start = p.here()
    let symbol = p.takeName()
    if p.at(TokenKind.Lt) && looksLikeTypeArgs(p, 0) {
        p.advance()
        let args = parseTypeArgs(p)
        return newExpr(p, ExprKind.Generic(symbol, args), start)
    }
    return newExpr(p, ExprKind.Ident(symbol), start)
}

// `.Name`, `.Name(args)` or the tuple key `.0`; the `.` is next.
fn variantShorthand(p: mut Parser) Expr {
    let start = p.advance()
    if p.at(TokenKind.Int) {
        let index: u64 = match p.token(0).value {
            TokenValue.Int(value) => value
            _ => 0
        }
        p.advance()
        let key = p.names.intern("{index}")
        return newExpr(p, ExprKind.Variant(key, [], false), start)
    }
    let variant = p.expectName("a variant name after `.`") ?? Symbol(0)
    var args: List<Arg> = []
    let hasArgs = p.accept(TokenKind.LParen)
    if hasArgs {
        args = parseCallArgs(p)
    }
    return newExpr(p, ExprKind.Variant(variant, args, hasArgs), start)
}

// ---------------------------------------------------------------------------
// Aggregates

// `()`, `(e)`, `(e,)` and `(a, b)`; the `(` is next.
fn parenthesized(p: mut Parser) Expr {
    let start = p.advance()
    let saved = p.noStructLiteral
    p.noStructLiteral = false
    var elems: List<Expr> = []
    var tuple = p.at(TokenKind.RParen)
    for !p.at(TokenKind.RParen) && !p.at(TokenKind.Eof) {
        elems.push(parseExpr(p))
        if !p.accept(TokenKind.Comma) {
            break
        }
        tuple = true
    }
    p.expect(TokenKind.RParen, "`)`")
    p.noStructLiteral = saved
    if !tuple && elems.len() == 1 {
        return elems.pop() ?? newExpr(p, ExprKind.Tuple([]), start)
    }
    return newExpr(p, ExprKind.Tuple(elems), start)
}

// `[a, b]` and `[value; count]`; the `[` is next.
fn array(p: mut Parser) Expr {
    let start = p.advance()
    let saved = p.noStructLiteral
    p.noStructLiteral = false
    var elems: List<Expr> = []
    var repeat: Option<(Expr, Expr)> = Option.None
    for !p.at(TokenKind.RBracket) && !p.at(TokenKind.Eof) {
        elems.push(parseExpr(p))
        if elems.len() == 1 && p.accept(TokenKind.Semicolon) {
            let value = elems.pop() ?? newExpr(p, ExprKind.Tuple([]), start)
            repeat = Option.Some((value, parseExpr(p)))
            break
        }
        if !p.accept(TokenKind.Comma) {
            break
        }
    }
    p.expect(TokenKind.RBracket, "`]` to close the array")
    p.noStructLiteral = saved
    return match repeat {
        Option.Some(parts) => newExpr(p, ExprKind.Repeat(Box.new(parts.0), Box.new(parts.1)), start)
        Option.None => newExpr(p, ExprKind.Array(elems), start)
    }
}

// A struct literal follows a type name: an identifier starting with an
// uppercase letter, possibly qualified or with type arguments.
fn isTypeName(p: Parser, e: &Expr) bool {
    return match e.kind {
        ExprKind.Ident(symbol) => startsUpper(p, symbol)
        ExprKind.Generic(_, _) => true
        ExprKind.Field(_, symbol, _) => startsUpper(p, symbol)
        ExprKind.SelfType => true
        _ => false
    }
}

fn startsUpper(p: Parser, symbol: Symbol) bool {
    return p.names.name(symbol)[0] <= b'Z'
}

fn structLiteral(p: mut Parser, typeName: move Expr) Expr {
    p.advance()   // {
    let saved = p.noStructLiteral
    p.noStructLiteral = false
    let start = typeName.span
    var fields: List<FieldInit> = []
    p.skipNewlines()
    for p.at(TokenKind.Ident) {
        let field = p.takeName()
        var value: Option<Expr> = Option.None
        if p.accept(TokenKind.Colon) {
            p.skipNewlines()
            value = Option.Some(parseExpr(p))
        }
        fields.push(FieldInit{id: p.newId(), name: field, value})
        let separated = p.acceptSeparator()
        p.skipNewlines()
        if !separated {
            break
        }
    }
    var base: Option<Box<Expr>> = Option.None
    if p.accept(TokenKind.DotDot) {
        base = Option.Some(Box.new(parseExpr(p)))
        p.accept(TokenKind.Comma)
        p.skipNewlines()
    }
    p.expect(TokenKind.RBrace, "`\}` to close the struct literal")
    p.noStructLiteral = saved
    return newExpr(p, ExprKind.Struct(Box.new(typeName), fields, base), start)
}

// ---------------------------------------------------------------------------
// Primary and postfix

/**
 * A primary expression: a literal, a name, an aggregate or a control flow
 * expression.
 *
 * @param p the parser
 * @returns the expression
 */
pub fn parsePrimary(p: mut Parser) Expr {
    let start = p.here()
    return match p.peek() {
        TokenKind.Int | TokenKind.Float | TokenKind.Byte | TokenKind.Str | TokenKind.ByteStr |
        TokenKind.True | TokenKind.False => literalToken(p)
        TokenKind.StrStart => interpolation(p)
        TokenKind.Ident => if closureAt(p) { closure(p) } else { name(p) }
        TokenKind.SelfValue => {
            p.advance()
            newExpr(p, ExprKind.SelfValue, start)
        }
        TokenKind.SelfType => {
            p.advance()
            newExpr(p, ExprKind.SelfType, start)
        }
        TokenKind.LParen => if closureAt(p) { closure(p) } else { parenthesized(p) }
        TokenKind.LBracket => array(p)
        TokenKind.Dot => variantShorthand(p)
        TokenKind.LBrace | TokenKind.If | TokenKind.Match | TokenKind.Unsafe => parseControl(p)
        _ => {
            p.unexpected("an expression")
            newExpr(p, ExprKind.Tuple([]), start)
        }
    }
}

/**
 * The arguments of a call after `(`, up to and including `)`.
 *
 * @param p the parser
 * @returns the arguments
 */
pub fn parseCallArgs(p: mut Parser) List<Arg> {
    let saved = p.noStructLiteral
    p.noStructLiteral = false
    var items: List<Arg> = []
    for !p.at(TokenKind.RParen) && !p.at(TokenKind.Eof) {
        var argName: Option<Symbol> = Option.None
        if p.at(TokenKind.Ident) && p.peekAt(1) == TokenKind.Colon {
            argName = Option.Some(p.takeName())
            p.advance()
        }
        items.push(Arg{name: argName, value: parseExpr(p)})
        if !p.accept(TokenKind.Comma) {
            break
        }
    }
    p.expect(TokenKind.RParen, "`)` to close the arguments")
    p.noStructLiteral = saved
    return items
}

fn tupleField(p: mut Parser, base: move Expr, index: u64) Expr {
    let start = base.span
    return newExpr(p, ExprKind.TupleField(Box.new(base), index), start)
}

// After `.`: a field name, a tuple index `0`, or a float token `0.1` that
// the lexer produced for `pair.0.1` (spec 1.7): two tuple indexes.
fn member(p: mut Parser, base: move Expr) Expr {
    let t = p.token(0)
    let kind = t.kind
    let span = t.span
    let index = match t.value {
        TokenValue.Int(v) => v
        _ => 0
    }
    let before = p.pos
    p.advance()
    if kind == TokenKind.Int {
        return tupleField(p, base, index)
    }
    if kind == TokenKind.Float {
        let digits = p.src.slice(span.start, span.end)
        let dot = digits.find(".") ?? digits.len()
        let first = leadingNumber(digits.slice(0, dot))
        let second = leadingNumber(digits.sliceFrom(if dot < digits.len() { dot + 1 } else { dot }))
        let inner = tupleField(p, base, first)
        return tupleField(p, inner, second)
    }
    if kind != TokenKind.Ident {
        p.pos -= 1
        p.unexpected("a field name after `.`")
        p.pos = before   // at the end of the file, `advance` stays there: no step back
        return base
    }
    let field = symbolOf(p.token(-1))
    var typeArgs: List<TypeExpr> = []
    if p.at(TokenKind.Lt) && looksLikeTypeArgs(p, 0) {   // x.wrappingCast<u8>()
        p.advance()
        typeArgs = parseTypeArgs(p)
    }
    let start = base.span
    return newExpr(p, ExprKind.Field(Box.new(base), field, typeArgs), start)
}

// The value of the digits at the start of `text`, as C's strtoul reads them.
fn leadingNumber(text: str) u64 {
    var value: u64 = 0
    for i in 0..text.len() {
        let c = text[i]
        if c < b'0' || c > b'9' {
            break
        }
        value = value.wrappingMul(10).wrappingAdd((c - b'0') as u64)
    }
    return value
}

// `[.name]` or `[.0]`: a single key literal as the index (spec 16.2).
fn atKeyIndex(p: Parser) bool {
    let key = p.peekAt(2)
    return p.peekAt(1) == TokenKind.Dot && (key == TokenKind.Ident || key == TokenKind.Int) &&
           p.peekAt(3) == TokenKind.RBracket
}

// `a[.name]` is the field `a.name`, and `a[.0]` is `a.0`.
fn keyIndex(p: mut Parser, base: move Expr) Expr {
    p.advance()
    p.advance()
    let e = member(p, base)
    p.advance()
    return e
}

fn postfixOnce(p: mut Parser, base: move Expr) (Expr, bool) {
    let start = base.span
    return match p.peek() {
        TokenKind.LParen => {
            p.advance()
            let args = parseCallArgs(p)
            (newExpr(p, ExprKind.Call(Box.new(base), args), start), true)
        }
        TokenKind.LBracket => {
            if atKeyIndex(p) {
                return (keyIndex(p, base), true)
            }
            p.advance()
            let index = parseExpr(p)
            p.expect(TokenKind.RBracket, "`]` after the index")
            (newExpr(p, ExprKind.Index(Box.new(base), Box.new(index)), start), true)
        }
        TokenKind.Dot => {
            p.advance()
            p.skipNewlines()
            let before = p.pos
            let e = member(p, base)
            (e, p.pos != before)
        }
        TokenKind.Question => {
            p.advance()
            (newExpr(p, ExprKind.Try(Box.new(base)), start), true)
        }
        _ => (base, false)
    }
}

/**
 * The postfix operations after a primary expression: calls, indexing,
 * fields, `?` and struct literals.
 *
 * @param p the parser
 * @param base the primary expression
 * @returns the whole expression
 */
pub fn parsePostfix(p: mut Parser, base: move Expr) Expr {
    var e = base
    for {
        if p.at(TokenKind.LBrace) && !p.noStructLiteral && isTypeName(p, &e) {
            e = structLiteral(p, e)
            continue
        }
        let step = postfixOnce(p, e)
        let more = step.1
        e = step.0
        if !more {
            return e
        }
    }
}

// ---------------------------------------------------------------------------
// Closures

// Whether a closure starts here (spec 10.1): `[move] x =>`, or `[move] (...)`
// followed by `=>` or by a type and `=>`. Not directly in a guard or a
// condition, where `=>` and `{` belong to the enclosing construct.
fn closureAt(p: Parser) bool {
    if p.noStructLiteral {
        return false
    }
    let start = if p.atWord(p.words.move) && p.peekAt(1) != TokenKind.FatArrow { 1 } else { 0 }
    if p.peekAt(start) == TokenKind.Ident {
        return p.peekAt(start + 1) == TokenKind.FatArrow
    }
    if p.peekAt(start) != TokenKind.LParen {
        return false
    }
    var i = start + 1
    var depth = 1
    for depth > 0 {
        let kind = p.peekAt(i)
        if kind == TokenKind.Eof || kind == TokenKind.LBrace || kind == TokenKind.RBrace {
            return false
        }
        if kind == TokenKind.LParen {
            depth += 1
        } else if kind == TokenKind.RParen {
            depth -= 1
        }
        i += 1
    }
    let next = p.peekAt(i)
    if next == TokenKind.FatArrow {
        return true
    }
    let typeStart = match next {
        TokenKind.Ident | TokenKind.SelfType | TokenKind.Amp | TokenKind.Star | TokenKind.LBracket |
        TokenKind.LParen | TokenKind.Fn | TokenKind.Bang | TokenKind.Dyn => true
        _ => false
    }
    if !typeStart {
        return false
    }
    for {
        let kind = p.peekAt(i)
        if kind == TokenKind.FatArrow {
            return true
        }
        if kind == TokenKind.Eof || kind == TokenKind.Newline || kind == TokenKind.LBrace ||
           kind == TokenKind.RBrace || kind == TokenKind.Eq {
            return false
        }
        i += 1
    }
}

// A closure; `closureAt` holds.
fn closure(p: mut Parser) Expr {
    let start = p.here()
    let isMove = p.atWord(p.words.move) && p.peekAt(1) != TokenKind.FatArrow
    if isMove {
        p.advance()
    }
    var params: List<Param> = []
    var ret: Option<TypeExpr> = Option.None
    if p.at(TokenKind.Ident) {
        params.push(closureParam(p))
    } else {
        p.advance()   // (
        for !p.at(TokenKind.RParen) && !p.at(TokenKind.Eof) {
            params.push(closureParam(p))
            if !p.accept(TokenKind.Comma) {
                break
            }
        }
        p.expect(TokenKind.RParen, "`)`")
        if !p.at(TokenKind.FatArrow) {
            ret = Option.Some(parseType(p))
        }
    }
    p.expect(TokenKind.FatArrow, "`=>`")
    p.skipNewlines()
    let body = parseExpr(p)
    return newExpr(p, ExprKind.Closure(params, ret, Box.new(body), isMove), start)
}

// `name` or `name: [mode] Type`; without a type, the type is an empty path.
fn closureParam(p: mut Parser) Param {
    let start = p.here()
    let name = p.expectName("a parameter name") ?? Symbol(0)
    var mode = Mode.Borrow
    var ty = TypeExpr{kind: TypeKind.Path([], []), span: p.here()}
    if p.accept(TokenKind.Colon) {
        mode = parseMode(p)
        ty = parseType(p)
    }
    return Param{id: p.newId(), name, mode, ty, defaultValue: Option.None, span: p.spanSince(start)}
}
