/**
 * @module
 * Lexer: turns source text into tokens (spec chapter 1).
 *
 * Written in the bootstrap subset (docs/bootstrap.md). It started as the
 * paper prototype of roadmap task 0.8 and is not compiled yet; findings are
 * recorded in docs/design/prototype-review.md. Literals are scanned in
 * `syntax.literals`, positions are tracked by `syntax.cursor`.
 */

import base.intern.Interner
import base.span.FileId
import diag.Diagnostics
import syntax.cursor.Cursor
import syntax.cursor.isDigit
import syntax.cursor.isLetter
import syntax.literals.scanByteLiteral
import syntax.literals.scanNumber
import syntax.literals.scanStringPart
import syntax.token.Token
import syntax.token.TokenKind

pub fn tokenize(src: str, file: FileId, names: mut Interner, diags: mut Diagnostics) List<Token> {
    var lx = Lexer.new(file)
    for !lx.cur.atEnd(src) {
        if !lx.skipTrivia(src, diags) {
            lx.tokenAt(src, names, diags)
        }
    }
    let end = lx.cur.token(.Eof, lx.cur.pos)
    lx.out.push(end)
    return lx.out
}

struct Lexer {
    cur: Cursor
    out: List<Token> = []
    brackets: List<u8> = []          // open `(`, `[` and `{`, innermost last
    interpolations: List<int> = []   // `brackets.len()` when each interpolation opened
    keywords: Map<str, TokenKind>

    fn new(file: FileId) Lexer {
        return Lexer{cur: Cursor.new(file), keywords: keywordTable()}
    }

    // Newlines are tokens except directly inside `(...)` and `[...]` (spec 1.3).
    fn newlinesMatter(self) bool {
        return match self.brackets.last() {
            .Some(open) => *open == b'{'
            .None => true
        }
    }

    // Handles whitespace or a comment at the current position. Returns false
    // if the current byte starts a token.
    fn skipTrivia(mut self, src: str, diags: mut Diagnostics) bool {
        let start = self.cur.pos
        let c = self.cur.peek(src, 0)
        let next = self.cur.peek(src, 1)
        if c == b' ' || c == b'\t' || c == b'\r' {
            self.cur.pos += 1
        } else if c == b'\n' {
            self.cur.pos += 1
            if self.newlinesMatter() {
                self.out.push(self.cur.token(.Newline, start))
            }
        } else if c == b'/' && next == b'/' {
            for !self.cur.atEnd(src) && src[self.cur.pos] != b'\n' {
                self.cur.pos += 1
            }
        } else if c == b'/' && next == b'*' {
            if self.blockComment(src, diags) && self.newlinesMatter() {
                self.out.push(self.cur.token(.Newline, start))
            }
        } else {
            return false
        }
        return true
    }

    fn tokenAt(mut self, src: str, names: mut Interner, diags: mut Diagnostics) {
        let start = self.cur.pos
        let c = self.cur.peek(src, 0)
        if c == b'b' && self.cur.peek(src, 1) == b'\'' {
            self.out.push(scanByteLiteral(self.cur, src, diags))
        } else if isLetter(c) {
            self.out.push(self.word(src, names))
        } else if isDigit(c) {
            self.out.push(scanNumber(self.cur, src, diags))
        } else if c == b'"' {
            self.cur.pos += 1
            self.stringPart(src, start, true, diags)
        } else {
            self.punct(src, diags)
        }
    }

    fn stringPart(mut self, src: str, start: int, opening: bool, diags: mut Diagnostics) {
        let token = scanStringPart(self.cur, src, start, opening, diags)
        if token.kind == .StrStart || token.kind == .StrMid {
            self.interpolations.push(self.brackets.len())
        }
        self.out.push(token)
    }

    // -----------------------------------------------------------------------
    // Comments

    // Skips `/* ... */`; `/** ... */` is a documentation comment. Returns
    // true if the comment contained a newline.
    fn blockComment(mut self, src: str, diags: mut Diagnostics) bool {
        let start = self.cur.pos
        let third = self.cur.peek(src, 3)
        let doc = self.cur.peek(src, 2) == b'*' && third != b'/' && third != b'*'
        self.cur.pos += 2
        var newline = false
        for {
            if self.cur.atEnd(src) {
                let message = "unterminated block comment".toOwned()
                diags.error("E0003", self.cur.spanFrom(start), message)
                return newline
            }
            if src[self.cur.pos] == b'*' && self.cur.peek(src, 1) == b'/' {
                self.cur.pos += 2
                if doc {
                    self.docComment(src, start)
                }
                return newline
            }
            if src[self.cur.pos] == b'\n' {
                newline = true
            }
            self.cur.pos += 1
        }
    }

    // `/** ... */` documents the next declaration, or the file when its text
    // starts with `@module` (spec 1.8); the tag is not part of the text.
    fn docComment(mut self, src: str, start: int) {
        let text = docText(src, start + 3, self.cur.pos - 2)
        let module = text.startsWith("@module")
        var from = 0
        if module {
            for from < text.len() && (text[from] == b'@' || text[from] > b' ') {
                from += 1
            }
            for from < text.len() && (text[from] == b'\n' || text[from] == b' ') {
                from += 1
            }
        }
        let kind: TokenKind = if module { .ModuleDoc } else { .DocComment }
        self.out.push(self.cur.tokenWith(kind, start, .Str(text.sliceFrom(from).toOwned())))
    }

    // -----------------------------------------------------------------------
    // Words and punctuation

    fn word(mut self, src: str, names: mut Interner) Token {
        let start = self.cur.pos
        for !self.cur.atEnd(src) && (isLetter(src[self.cur.pos]) || isDigit(src[self.cur.pos])) {
            self.cur.pos += 1
        }
        let text = src[start..self.cur.pos]
        if let .Some(kind) = self.keywords.get(text) {
            return self.cur.token(*kind, start)
        }
        return self.cur.tokenWith(.Ident, start, .Name(names.intern(text)))
    }

    fn punct(mut self, src: str, diags: mut Diagnostics) {
        let start = self.cur.pos
        let c = src[start]
        self.cur.pos += 1
        if c == b'}' && self.closesInterpolation() {
            self.stringPart(src, start, false, diags)
            return
        }
        let kind = self.punctKind(src, c, start, diags)
        self.out.push(self.cur.token(kind, start))
    }

    // `>` is always a single token: the parser joins adjacent ones (spec 1.6).
    // check-sizes: table
    fn punctKind(mut self, src: str, c: u8, start: int, diags: mut Diagnostics) TokenKind {
        return match c {
            b'(' => self.open(b'(', .LParen)
            b'[' => self.open(b'[', .LBracket)
            b'{' => self.open(b'{', .LBrace)
            b')' => self.close(.RParen)
            b']' => self.close(.RBracket)
            b'}' => self.close(.RBrace)
            b',' => .Comma
            b':' => .Colon
            b';' => .Semicolon
            b'@' => .At
            b'>' => .Gt
            b'?' => self.cur.pick(src, b'?', .QuestionQuestion, .Question)
            b'.' => if self.cur.eat(src, b'.') {
                self.cur.pick(src, b'=', .DotDotEq, .DotDot)
            } else {
                .Dot
            }
            b'=' => if self.cur.eat(src, b'>') {
                .FatArrow
            } else {
                self.cur.pick(src, b'=', .EqEq, .Eq)
            }
            b'+' => self.cur.pick(src, b'=', .PlusEq, .Plus)
            b'-' => self.cur.pick(src, b'=', .MinusEq, .Minus)
            b'*' => self.cur.pick(src, b'=', .StarEq, .Star)
            b'/' => self.cur.pick(src, b'=', .SlashEq, .Slash)
            b'%' => self.cur.pick(src, b'=', .PercentEq, .Percent)
            b'^' => self.cur.pick(src, b'=', .CaretEq, .Caret)
            b'!' => self.cur.pick(src, b'=', .Ne, .Bang)
            b'&' => if self.cur.eat(src, b'&') {
                .AndAnd
            } else {
                self.cur.pick(src, b'=', .AmpEq, .Amp)
            }
            b'|' => if self.cur.eat(src, b'|') {
                .OrOr
            } else {
                self.cur.pick(src, b'=', .PipeEq, .Pipe)
            }
            b'<' => if self.cur.eat(src, b'<') {
                self.cur.pick(src, b'=', .ShlEq, .Shl)
            } else {
                self.cur.pick(src, b'=', .Le, .Lt)
            }
            _ => self.invalidCharacter(src, start, diags)
        }
    }

    // Skips the rest of a multi-byte UTF-8 character so it is reported once.
    fn invalidCharacter(mut self, src: str, start: int, diags: mut Diagnostics) TokenKind {
        for !self.cur.atEnd(src) && src[self.cur.pos] & 0xC0 == 0x80 {
            self.cur.pos += 1
        }
        diags.error("E0001", self.cur.spanFrom(start), "unexpected character".toOwned())
        return .Invalid
    }

    fn open(mut self, bracket: u8, kind: TokenKind) TokenKind {
        self.brackets.push(bracket)
        return kind
    }

    // Mismatched brackets are reported by the parser; the lexer only keeps
    // its stack balanced.
    fn close(mut self, kind: TokenKind) TokenKind {
        let _ = self.brackets.pop()
        return kind
    }

    fn closesInterpolation(mut self) bool {
        let .Some(depth) = self.interpolations.last() else {
            return false
        }
        if *depth != self.brackets.len() {
            return false
        }
        self.interpolations.pop()
        return true
    }
}

// The text of a documentation comment (spec 1.8): each line without its
// indentation and leading `*`, blank lines at both ends removed.
fn docText(src: str, start: int, end: int) str {
    var text = ""
    var pos = start
    for pos < end {
        var lineEnd = pos
        for lineEnd < end && src[lineEnd] != b'\n' {
            lineEnd += 1
        }
        var from = pos
        for from < lineEnd && (src[from] == b' ' || src[from] == b'\t') {
            from += 1
        }
        if from < lineEnd && src[from] == b'*' {
            from += if from + 1 < lineEnd && src[from + 1] == b' ' { 2 } else { 1 }
        }
        let line = trimmed(src, from, lineEnd)
        if line.len() > 0 || text.len() > 0 {   // no blank lines at the start
            text.push(line)
            text.push("\n")
        }
        pos = lineEnd + 1
    }
    var keep = text.len()
    for keep > 0 && text[keep - 1] == b'\n' {   // nor at the end
        keep -= 1
    }
    return text.slice(0, keep).toOwned()
}

// `src[start..end]` without spaces and tabs before it, nor spaces and `\r` after.
fn trimmed(src: str, start: int, end: int) str {
    var lo = start
    for lo < end && (src[lo] == b' ' || src[lo] == b'\t') {
        lo += 1
    }
    var hi = end
    for hi > lo && (src[hi - 1] == b' ' || src[hi - 1] == b'\r') {
        hi -= 1
    }
    return src.slice(lo, hi)
}

fn keywordTable() Map<str, TokenKind> {
    var k = Map<str, TokenKind>.new()
    k.insert("as", .As)
    k.insert("break", .Break)
    k.insert("const", .Const)
    k.insert("continue", .Continue)
    k.insert("copy", .Copy)
    k.insert("dyn", .Dyn)
    k.insert("else", .Else)
    k.insert("enum", .Enum)
    k.insert("extern", .Extern)
    k.insert("false", .False)
    k.insert("fn", .Fn)
    k.insert("for", .For)
    k.insert("if", .If)
    k.insert("import", .Import)
    k.insert("in", .In)
    k.insert("interface", .Interface)
    k.insert("let", .Let)
    k.insert("match", .Match)
    k.insert("mut", .Mut)
    k.insert("pub", .Pub)
    k.insert("return", .Return)
    k.insert("self", .SelfValue)
    k.insert("Self", .SelfType)
    k.insert("struct", .Struct)
    k.insert("true", .True)
    k.insert("unsafe", .Unsafe)
    k.insert("var", .Var)
    return k
}
