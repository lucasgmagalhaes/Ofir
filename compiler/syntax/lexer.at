//! Lexer: turns source text into tokens (spec chapter 1).
//!
//! Written in the bootstrap subset (docs/bootstrap.md). It started as the
//! paper prototype of roadmap task 0.8 and is not compiled yet; findings are
//! recorded in docs/design/prototype-review.md. Literals are scanned in
//! `syntax.literals`, positions are tracked by `syntax.cursor`.

import base.intern.Interner
import base.span.FileId
import diag.Diagnostics
import syntax.cursor.Cursor
import syntax.cursor.isDigit
import syntax.cursor.isLetter
import syntax.literals.scanByteLiteral
import syntax.literals.scanNumber
import syntax.literals.scanStringPart
import syntax.token.Token
import syntax.token.TokenKind
import syntax.token.TokenValue

pub fn tokenize(src: str, file: FileId, names: mut Interner, diags: mut Diagnostics) List<Token> {
    var lx = Lexer.new(file)
    var tokens: List<Token> = []
    for {
        let token = lx.next(src, names, diags)
        let done = token.kind == .Eof
        tokens.push(token)
        if done {
            return tokens
        }
    }
}

struct Lexer {
    cur: Cursor
    brackets: List<u8> = []          // open `(`, `[` and `{`, innermost last
    interpolations: List<int> = []   // `brackets.len()` when each interpolation opened
    keywords: Map<str, TokenKind>

    fn new(file: FileId) Lexer {
        return Lexer{cur: Cursor.new(file), keywords: keywordTable()}
    }

    fn next(mut self, src: str, names: mut Interner, diags: mut Diagnostics) Token {
        for !self.cur.atEnd(src) {
            if let .Some(trivia) = self.skipTrivia(src, diags) {
                return trivia
            }
            if !self.atTrivia(src) {
                return self.tokenAt(src, names, diags)
            }
        }
        return self.cur.token(.Eof, self.cur.pos)
    }

    fn atTrivia(self, src: str) bool {
        let c = self.cur.peek(src, 0)
        let next = self.cur.peek(src, 1)
        let space = c == b' ' || c == b'\t' || c == b'\r' || c == b'\n'
        return space || c == b'/' && (next == b'/' || next == b'*')
    }

    // Skips one piece of whitespace or comment. Returns a token when the
    // piece produces one: a newline that matters or a doc comment.
    fn skipTrivia(mut self, src: str, diags: mut Diagnostics) Option<Token> {
        let start = self.cur.pos
        let c = self.cur.peek(src, 0)
        let next = self.cur.peek(src, 1)
        if c == b' ' || c == b'\t' || c == b'\r' {
            self.cur.pos += 1
        } else if c == b'\n' {
            self.cur.pos += 1
            return self.newlineToken(start)
        } else if c == b'/' && next == b'/' {
            return self.lineComment(src)
        } else if c == b'/' && next == b'*' && self.blockComment(src, diags) {
            return self.newlineToken(start)
        }
        return .None
    }

    // Newlines are tokens except directly inside `(...)` and `[...]` (spec 1.3).
    fn newlineToken(self, start: int) Option<Token> {
        let matters = match self.brackets.last() {
            .Some(open) => open == b'{'
            .None => true
        }
        if matters {
            return .Some(self.cur.token(.Newline, start))
        }
        return .None
    }

    fn tokenAt(mut self, src: str, names: mut Interner, diags: mut Diagnostics) Token {
        let start = self.cur.pos
        let c = self.cur.peek(src, 0)
        if c == b'b' && self.cur.peek(src, 1) == b'\'' {
            return scanByteLiteral(self.cur, src, diags)
        }
        if isLetter(c) {
            return self.word(src, names)
        }
        if isDigit(c) {
            return scanNumber(self.cur, src, diags)
        }
        if c == b'"' {
            self.cur.pos += 1
            return self.stringPart(src, start, true, diags)
        }
        return self.punct(src, diags)
    }

    fn stringPart(mut self, src: str, start: int, opening: bool, diags: mut Diagnostics) Token {
        let token = scanStringPart(self.cur, src, start, opening, diags)
        if token.kind == .StrStart || token.kind == .StrMid {
            self.interpolations.push(self.brackets.len())
        }
        return token
    }

    // -----------------------------------------------------------------------
    // Comments

    // Skips a `//` comment; `///` and `//!` become doc comment tokens.
    fn lineComment(mut self, src: str) Option<Token> {
        let start = self.cur.pos
        let kind: Option<TokenKind> = match (self.cur.peek(src, 2), self.cur.peek(src, 3)) {
            (b'/', b'/') => .None             // `////...` is an ordinary comment
            (b'/', _) => .Some(.DocComment)
            (b'!', _) => .Some(.ModuleDoc)
            _ => .None
        }
        for !self.cur.atEnd(src) && src[self.cur.pos] != b'\n' {
            self.cur.pos += 1
        }
        let .Some(k) = kind else { return .None }
        let text = src[start + 3..self.cur.pos].trim().toOwned()
        return .Some(self.cur.tokenWith(k, start, .Str(text)))
    }

    // Skips a `/* ... */` comment. Returns true if it contained a newline.
    fn blockComment(mut self, src: str, diags: mut Diagnostics) bool {
        let start = self.cur.pos
        self.cur.pos += 2
        var newline = false
        for {
            if self.cur.atEnd(src) {
                diags.error("E0003", self.cur.spanFrom(start), "unterminated block comment")
                return newline
            }
            if src[self.cur.pos] == b'*' && self.cur.peek(src, 1) == b'/' {
                self.cur.pos += 2
                return newline
            }
            if src[self.cur.pos] == b'\n' {
                newline = true
            }
            self.cur.pos += 1
        }
    }

    // -----------------------------------------------------------------------
    // Words and punctuation

    fn word(mut self, src: str, names: mut Interner) Token {
        let start = self.cur.pos
        for !self.cur.atEnd(src) && (isLetter(src[self.cur.pos]) || isDigit(src[self.cur.pos])) {
            self.cur.pos += 1
        }
        let text = src[start..self.cur.pos]
        if let .Some(kind) = self.keywords.get(text) {
            return self.cur.token(kind, start)
        }
        return self.cur.tokenWith(.Ident, start, .Name(names.intern(text)))
    }

    fn punct(mut self, src: str, diags: mut Diagnostics) Token {
        let start = self.cur.pos
        let c = src[start]
        self.cur.pos += 1
        if c == b'}' && self.closesInterpolation() {
            return self.stringPart(src, start, false, diags)
        }
        return self.cur.token(self.punctKind(src, c, diags), start)
    }

    // `>` is always a single token: the parser joins adjacent ones (spec 1.6).
    // check-sizes: table
    fn punctKind(mut self, src: str, c: u8, diags: mut Diagnostics) TokenKind {
        return match c {
            b'(' => self.open(b'(', .LParen)
            b'[' => self.open(b'[', .LBracket)
            b'{' => self.open(b'{', .LBrace)
            b')' => self.close(.RParen)
            b']' => self.close(.RBracket)
            b'}' => self.close(.RBrace)
            b',' => .Comma
            b':' => .Colon
            b';' => .Semicolon
            b'@' => .At
            b'>' => .Gt
            b'?' => self.cur.pick(src, b'?', .QuestionQuestion, .Question)
            b'.' => if self.cur.eat(src, b'.') {
                self.cur.pick(src, b'=', .DotDotEq, .DotDot)
            } else {
                .Dot
            }
            b'=' => if self.cur.eat(src, b'>') {
                .FatArrow
            } else {
                self.cur.pick(src, b'=', .EqEq, .Eq)
            }
            b'+' => self.cur.pick(src, b'=', .PlusEq, .Plus)
            b'-' => self.cur.pick(src, b'=', .MinusEq, .Minus)
            b'*' => self.cur.pick(src, b'=', .StarEq, .Star)
            b'/' => self.cur.pick(src, b'=', .SlashEq, .Slash)
            b'%' => self.cur.pick(src, b'=', .PercentEq, .Percent)
            b'^' => self.cur.pick(src, b'=', .CaretEq, .Caret)
            b'!' => self.cur.pick(src, b'=', .Ne, .Bang)
            b'&' => if self.cur.eat(src, b'&') {
                .AndAnd
            } else {
                self.cur.pick(src, b'=', .AmpEq, .Amp)
            }
            b'|' => if self.cur.eat(src, b'|') {
                .OrOr
            } else {
                self.cur.pick(src, b'=', .PipeEq, .Pipe)
            }
            b'<' => if self.cur.eat(src, b'<') {
                self.cur.pick(src, b'=', .ShlEq, .Shl)
            } else {
                self.cur.pick(src, b'=', .Le, .Lt)
            }
            _ => {
                diags.error("E0001", self.cur.spanAt(self.cur.pos - 1), "unexpected character")
                .Invalid
            }
        }
    }

    fn open(mut self, bracket: u8, kind: TokenKind) TokenKind {
        self.brackets.push(bracket)
        return kind
    }

    // Mismatched brackets are reported by the parser; the lexer only keeps
    // its stack balanced.
    fn close(mut self, kind: TokenKind) TokenKind {
        self.brackets.pop()
        return kind
    }

    fn closesInterpolation(mut self) bool {
        let .Some(depth) = self.interpolations.last() else { return false }
        if depth != self.brackets.len() {
            return false
        }
        self.interpolations.pop()
        return true
    }
}

fn keywordTable() Map<str, TokenKind> {
    var k = Map<str, TokenKind>.new()
    k.insert("as", .As)
    k.insert("break", .Break)
    k.insert("const", .Const)
    k.insert("continue", .Continue)
    k.insert("copy", .Copy)
    k.insert("dyn", .Dyn)
    k.insert("else", .Else)
    k.insert("enum", .Enum)
    k.insert("extern", .Extern)
    k.insert("false", .False)
    k.insert("fn", .Fn)
    k.insert("for", .For)
    k.insert("if", .If)
    k.insert("import", .Import)
    k.insert("in", .In)
    k.insert("interface", .Interface)
    k.insert("let", .Let)
    k.insert("match", .Match)
    k.insert("mut", .Mut)
    k.insert("pub", .Pub)
    k.insert("return", .Return)
    k.insert("self", .SelfValue)
    k.insert("Self", .SelfType)
    k.insert("struct", .Struct)
    k.insert("true", .True)
    k.insert("unsafe", .Unsafe)
    k.insert("var", .Var)
    return k
}

// ---------------------------------------------------------------------------
// Tests

fn expectKinds(src: str, expected: [TokenKind]) {
    var names = Interner.new()
    var diags = Diagnostics.new()
    let tokens = tokenize(src, FileId(0), names, diags)
    assert(!diags.hasErrors())
    assert(tokens.len() == expected.len())
    for i, token in tokens {
        assert(token.kind == expected[i])
    }
}

@test
fn genericsCloseWithSingleGtTokens() {
    expectKinds("var b: List<List<u8>>", [
        .Var, .Ident, .Colon, .Ident, .Lt, .Ident, .Lt, .Ident, .Gt, .Gt, .Eof,
    ])
}

@test
fn newlinesAreTokensExceptInParentheses() {
    expectKinds("f(a,\nb)\nx", [
        .Ident, .LParen, .Ident, .Comma, .Ident, .RParen, .Newline, .Ident, .Eof,
    ])
}

@test
fn newlinesCountInsideABlockNestedInParentheses() {
    expectKinds("f(fn() {\na\n})", [
        .Ident, .LParen, .Fn, .LParen, .RParen, .LBrace, .Newline,
        .Ident, .Newline, .RBrace, .RParen, .Eof,
    ])
}

@test
fn interpolationSplitsStrings() {
    expectKinds("\"a {x} b {f(y)} c\"", [
        .StrStart, .Ident, .StrMid, .Ident, .LParen, .Ident, .RParen, .StrEnd, .Eof,
    ])
}

@test
fn rangesAreNotFloats() {
    expectKinds("0..10 1.5 x.0", [
        .Int, .DotDot, .Int, .Float, .Ident, .Dot, .Int, .Eof,
    ])
}

@test
fn contextualKeywordsAreIdentifiers() {
    expectKinds("type move ref where", [.Ident, .Ident, .Ident, .Ident, .Eof])
}
