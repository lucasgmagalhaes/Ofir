//! A position in a source file, shared by the lexer and the literal scanners.

import base.span.FileId
import base.span.Span
import syntax.token.Token
import syntax.token.TokenKind
import syntax.token.TokenValue

// The source is not stored: a struct cannot hold a reference in the bootstrap
// subset (no `ref struct`), so every method borrows it as a parameter.
// Tokens store spans, not slices.
pub struct Cursor {
    pub file: FileId
    pub pos: int = 0

    pub fn new(file: FileId) Cursor {
        return Cursor{file}
    }

    pub fn atEnd(self, src: str) bool {
        return self.pos >= src.len()
    }

    // The byte `offset` positions ahead, or 0 past the end.
    pub fn peek(self, src: str, offset: int) u8 {
        let i = self.pos + offset
        if i < src.len() {
            return src[i]
        }
        return 0
    }

    // Consumes `expected` if it is the next byte.
    pub fn eat(mut self, src: str, expected: u8) bool {
        if self.peek(src, 0) == expected {
            self.pos += 1
            return true
        }
        return false
    }

    pub fn pick(mut self, src: str, expected: u8, long: TokenKind, short: TokenKind) TokenKind {
        if self.eat(src, expected) {
            return long
        }
        return short
    }

    pub fn spanFrom(self, start: int) Span {
        return Span{file: self.file, start, end: self.pos}
    }

    pub fn spanAt(self, offset: int) Span {
        return Span{file: self.file, start: offset, end: offset + 1}
    }

    pub fn token(self, kind: TokenKind, start: int) Token {
        return Token{kind, span: self.spanFrom(start), value: .None}
    }

    pub fn tokenWith(self, kind: TokenKind, start: int, value: move TokenValue) Token {
        return Token{kind, span: self.spanFrom(start), value}
    }
}

pub fn isLetter(c: u8) bool {
    return c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c == b'_'
}

pub fn isDigit(c: u8) bool {
    return c >= b'0' && c <= b'9'
}

// Value of a digit in any base up to 16, or 99 for any other byte.
pub fn digitValue(c: u8) int {
    return match c {
        b'0'..=b'9' => (c - b'0') as int
        b'a'..=b'f' => (c - b'a') as int + 10
        b'A'..=b'F' => (c - b'A') as int + 10
        _ => 99
    }
}
