// The tests of `base.span` (spec 12.2).

@test
fn spansJoinAndMeasure() {
    let a = Span{file: FileId(0), start: 4, end: 9}
    let b = Span{file: FileId(0), start: 12, end: 15}
    assert(a.len() == 5)
    let joined = a.to(b)
    assert(joined.start == 4 && joined.end == 15)
}

@test
fn lineColFindsTheLine() {
    let file = SourceFile.new("a.of".toOwned(), "ab\ncde\n\nf".toOwned())
    assert(file.lineCount() == 4)
    let first = file.lineCol(0)
    assert(first.line == 1 && first.column == 1)
    let d = file.lineCol(4)
    assert(d.line == 2 && d.column == 2)
    let f = file.lineCol(8)
    assert(f.line == 4 && f.column == 1)
    assert(file.lineText(2) == "cde" && file.lineText(3) == "" && file.lineText(4) == "f")
}

@test
fn sourceMapNumbersFiles() {
    var map = SourceMap.new()
    let a = map.add("a.of".toOwned(), "x".toOwned())
    let b = map.add("b.of".toOwned(), "yy\n".toOwned())
    assert(a.0 == 0 && b.0 == 1 && map.len() == 2)
    assert(map.file(b).path == "b.of" && map.file(b).lineCount() == 1)
}
