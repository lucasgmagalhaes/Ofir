/**
 * @module
 * The checks the language server runs: the phases of `ofir build
 * --stop-after=check` on a file, with the editor's unsaved buffers read in
 * place of their files.
 */

import base.intern.Interner
import base.span.SourceMap
import diag.Diagnostic
import diag.Diagnostics
import driver.cfg.CfgTarget
import driver.modules.Front
import driver.modules.loadProgram
import sema.check.checkProgram
import sema.interface_params.desugarInterfaceParams
import sema.resolve.resolveProgram
import sema.trace.Link
import std.mem
import std.os
import syntax.lexer.tokenize
import syntax.parser.parse

/**
 * What checking a file found.
 */
pub struct Checked {
    /** The files read: the spans of the diagnostics point into them. */
    pub map: SourceMap
    /** The diagnostics, sorted, without duplicates. */
    pub diags: List<Diagnostic>
    /** The names used in the root file and the declarations they refer to. */
    pub links: List<Link>
}

/**
 * Lexes, parses, resolves and type-checks the program whose root is `path`.
 *
 * @param path the root file
 * @param overlays the texts of the files an editor has open
 * @returns the files, the diagnostics and the links
 */
pub fn checkFile(path: str, overlays: &Map<str, str>) Checked {
    let front = Front{map: SourceMap.new(), names: Interner.new(), diags: Diagnostics.new(),
                      overlays: overlays.clone()}
    const Option.Some(file) = front.load(path) else {
        return Checked{map: front.map, diags: [], links: []}
    }
    const tokens = tokenize(front.map.file(file).text, file, front.names, front.diags)
    if front.diags.hasErrors() {
        return Checked{map: front.map, diags: front.diags.reported(), links: []}
    }
    const names = mem.replace(front.names, Interner.new())
    const diags = mem.replace(front.diags, Diagnostics.new())
    const parsed = parse(file, front.map.file(file).text, tokens, names, diags)
    front.names = parsed.names
    front.diags = parsed.diags
    if front.diags.hasErrors() {
        return Checked{map: front.map, diags: front.diags.reported(), links: []}
    }
    const target = CfgTarget{os: os.name(), arch: os.arch(), debug: true, test: false,
                             bench: false}
    let program = loadProgram(path, parsed.module, front, target)
    if front.diags.hasErrors() {
        return Checked{map: front.map, diags: front.diags.reported(), links: []}
    }
    let r = resolveProgram(program, front.names, front.diags, front.map, false, false, false, true)
    if r.diags.hasErrors() {
        const links = mem.replace(r.trace.links, [])
        return Checked{map: r.map, diags: r.diags.reported(), links}
    }
    desugarInterfaceParams(program, r)
    let c = checkProgram(program, r)
    const found = c.r.diags.reported()
    const links = mem.replace(c.r.trace.links, [])
    return Checked{map: mem.replace(c.r.map, SourceMap.new()), diags: found, links}
}
