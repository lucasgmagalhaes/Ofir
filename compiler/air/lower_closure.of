/**
 * @module
 * Lowering of closures (spec 10.3): the body of each one becomes a function
 * of its own, which reaches the variables it captures through the
 * environment of the closure's value. A closure that does not `move` has
 * its environment on the stack: a tuple of references to what it captures.
 * A `move` closure's is on the heap: a pointer to the function that drops
 * it, then a tuple of the captured values.
 */

import air.air.AirBody
import air.air.ClosureBody
import air.air.Operand
import air.air.OperandKind
import air.air.RvalueKind
import air.air.TermKind
import air.air.opCopy
import air.air.opUnit
import air.air.rvalue
import air.air.terminator
import air.lower.Lowerer
import air.lower.Place
import air.lower.dropScopeEnter
import air.lower.dropScopeLeave
import air.lower.dropTemps
import air.lower.emitDrop
import air.lower.emitTemp
import air.lower.localPlace
import air.lower.monoBody
import air.lower.noteMoved
import air.lower.placeOperand
import air.lower.terminate
import air.lower_expr.aggregate
import air.lower_expr.assignOperand
import air.lower_expr.lowerExpr
import sema.check.Checker
import sema.check.fnOf
import sema.program.Program
import sema.structs.isCopy
import sema.types.UNIT
import std.mem
import syntax.ast.Expr
import syntax.ast.Op
import syntax.ast.Param

/**
 * Lowers a closure: its body to a function of its own, and its value here.
 *
 * @param l the lowering
 * @param c the checker
 * @param p the program
 * @param e the closure
 * @param params its parameters
 * @param body its body
 * @param isMove `move`
 * @param ty its type
 * @returns its value
 */
pub fn lowerClosure(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, params: &List<Param>,
                    body: &Expr, isMove: bool, ty: int) Operand {
    let module = c.def(l.fnDef).module
    let captured: List<int> = match c.r.tables[module].captures.get(e.id.0) {
        Option.Some(list) => list.clone()
        Option.None => []
    }
    let written: List<int> = match c.capturesMut[module].get(e.id.0) {
        Option.Some(list) => list.clone()
        Option.None => []
    }
    var captures: List<int> = []   // AIR locals
    for i in 0..captured.len() {
        captures.push(captured[i] + 1)
    }
    // The environment: the captured values, or raw pointers to them (a `&str` is a view).
    var types: List<int> = []
    for i in 0..captures.len() {
        let local = captures[i]
        let captureType = l.body.locals[local].ty
        types.push(if isMove { captureType } else {
            c.types.ptr(captureType, contains(&written, captured[i]))
        })
    }
    let envType = if captures.len() > 0 { c.types.tuple(types.clone()) } else { 0 }
    lowerBody(l, c, p, e, params, body, captures.clone(), isMove, envType, ty)
    if isMove && envType != 0 {
        lowerEnvDrop(l, c, p, e, envType)
    }
    var rv = rvalue(RvalueKind.Closure, Op.Add, opUnit(UNIT), opUnit(UNIT))
    rv.flag = e.id.0
    if envType != 0 {
        var items: List<Operand> = []
        for i in 0..captures.len() {
            let local = captures[i]
            // A local passed by address holds the address of the value.
            let place = Place{local, fields: [], deref: l.body.locals[local].byRef}
            if !isMove {
                items.push(placeOperand(&place, OperandKind.Addr, types[i]))
            } else {
                items.push(placeOperand(&place, OperandKind.Copy, types[i]))
                if !isCopy(c, p, types[i]) {   // moved into the closure
                    let path: List<int> = []
                    noteMoved(l, local, &path)
                }
            }
        }
        let env = aggregate(l, envType, items)
        rv.a = if isMove { env } else {
            placeOperand(&localPlace(env.local), OperandKind.Addr, c.types.ptr(envType, false))
        }
    }
    return opCopy(emitTemp(l, ty, rv), ty)
}

// The function that drops a `move` closure's captured values; the caller
// then frees the environment.
fn lowerEnvDrop(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, envType: int) {
    let info = ClosureBody{id: e.id.0, params: [], captures: [], isMove: true, env: envType,
                           drop: true}
    var drop = AirBody{def: l.body.def, targs: l.body.targs, name: l.body.name,
                       isMain: false, paramCount: 0, locals: [], blocks: [],
                       closure: Option.Some(info)}
    drop.newLocal(UNIT, Option.None, e.span)
    drop.newLocal(c.types.ref(envType, true), Option.None, e.span)   // the captured values
    let outer = mem.replace(l.body, drop)
    let block = l.block
    l.block = l.body.newBlock()
    emitDrop(l, c, p, &Place{local: 1, fields: [], deref: true}, envType)
    terminate(l, terminator(TermKind.Return))
    monoBody(l, c, p)
    l.out.push(mem.replace(l.body, outer))
    l.block = block
}

// The body of a closure, a function of its own: the locals of the
// enclosing function, its parameters among them, the captured ones reached
// through the environment.
fn lowerBody(l: mut Lowerer, c: mut Checker, p: Program, e: &Expr, params: &List<Param>,
             body: &Expr, captures: List<int>, isMove: bool, env: int, ty: int) {
    let decl = fnOf(p, c.loc(l.fnDef))
    let count = match c.r.tables[c.def(l.fnDef).module].fnLocals.get(decl.id.0) {
        Option.Some(list) => list.len()
        Option.None => 0
    }
    var paramLocals: List<int> = []
    for i in 0..params.len() {
        paramLocals.push(c.localAt(params[i].id.0) + 1)
    }
    let info = ClosureBody{id: e.id.0, params: paramLocals, captures: captures.clone(), isMove,
                           env: if isMove { env } else { 0 }, drop: false}
    var closure = AirBody{def: l.body.def, targs: l.body.targs, name: l.body.name,
                          isMain: false, paramCount: 0, locals: [], blocks: [],
                          closure: Option.Some(info)}
    closure.newLocal(c.types.get(ty).inner, Option.None, e.span)   // the return value
    for i in 1..count + 1 {
        let local = &l.body.locals[i]
        closure.newLocal(local.ty, local.name, local.span)
    }
    for i in 0..captures.len() {
        closure.locals[captures[i]].byRef = true
    }
    let outer = mem.replace(l.body, closure)
    let block = l.block
    let loops = mem.replace(l.loops, [])
    let owned = mem.replace(l.owned, [])
    let scopes = mem.replace(l.scopes, [])
    let flags = mem.replace(l.flags, List.filled(0, count + 1))
    let partFlags = mem.replace(l.partFlags, [])
    let temps = mem.replace(l.temps, [])
    let tempScopes = mem.replace(l.tempScopes, [])
    let forward = l.forward
    l.forward = false
    l.block = l.body.newBlock()
    dropScopeEnter(l)
    let value = lowerExpr(l, c, p, body)
    assignOperand(l, 0, value)
    dropTemps(l, c, p, 0)
    dropScopeLeave(l, c, p)
    terminate(l, terminator(TermKind.Return))
    monoBody(l, c, p)
    l.out.push(mem.replace(l.body, outer))
    l.block = block
    l.loops = loops
    l.owned = owned
    l.scopes = scopes
    l.flags = flags
    l.partFlags = partFlags
    l.temps = temps
    l.tempScopes = tempScopes
    l.forward = forward
}

fn contains(list: &List<int>, value: int) bool {
    for i in 0..list.len() {
        if list[i] == value {
            return true
        }
    }
    return false
}
