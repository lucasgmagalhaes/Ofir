// The tests of `std.core.box` (spec 12.2): `astra test std/core/box.at` runs them.

@test
fn cloneCopiesTheValue() {
    let a = Box.new("text".toOwned())
    var b = a.clone()
    (*b).push("!")   // no automatic dereference inside std.core.box
    assert(*a == "text" && *b == "text!")
    assert(b.unbox() == "text!")
}
