//! `Box<T>`: an owned heap allocation (docs/std/collections.md).

extern "C" {
    fn astra_alloc(size: int) *mut u8
    fn astra_free(p: *mut u8)
}

extern "intrinsic" {
    /// The size in bytes of a value of type `T` (spec 7.5).
    pub fn sizeOf<T>() int
}

/// An owned heap allocation, which makes recursive types possible:
/// `enum Expr { Number(int), Add(Box<Expr>, Box<Expr>) }`. `*b` reads the
/// value, and the fields and methods of the value are reached through the
/// box: `b.x`, `b.area()`.
@lang("box")
pub struct Box<T> {
    ptr: *mut T

    pub fn new(value: move T) Box<T> {
        let ptr = unsafe { astra_alloc(sizeOf<T>()) as *mut T }
        unsafe {
            *ptr = value
        }
        return Box{ptr}
    }

    /// Moves the value out and frees the box.
    pub fn unbox(move self) T {
        let value = unsafe { *self.ptr }
        unsafe {
            astra_free(self.ptr as *mut u8)
        }
        return value
    }
}
