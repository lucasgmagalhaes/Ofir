// The tests of `std.core.map` (spec 12.2): `astra test std/core/map.at` runs them.

@test
fn insertReplacesAndReturnsTheOldValue() {
    var ages: Map<str, int> = Map.new()
    assert(ages.insert("ada".toOwned(), 36).isNone())
    assert(ages.insert("ada".toOwned(), 37).unwrapOr(0) == 36)
    assert(ages.len() == 1 && ages.contains("ada"))
    assert(*ages.get("ada").unwrap() == 37)
}

@test
fn removeKeepsTheOtherEntries() {
    var m: Map<int, int> = Map.new()
    for i in 0..100 {
        m.insert(i, i * i)
    }
    for i in 0..50 {
        assert(m.remove(i * 2).unwrapOr(-1) == i * i * 4)
    }
    assert(m.len() == 50 && !m.contains(10) && *m.get(11).unwrap() == 121)
    *m.getOrInsert(200, 0) += 5
    assert(*m.get(200).unwrap() == 5)
}
