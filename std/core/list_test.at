// The tests of `std.core.list` (spec 12.2): `astra test std/core/list.at` runs them.

@test
fn removeAndInsertShiftElements() {
    var l = [1, 2, 3, 4]
    assert(l.remove(1) == 2)
    l.insert(0, 9)
    assert(l.len() == 4 && l[0] == 9 && l[1] == 1 && l[3] == 4)
    assert(l.swapRemove(0) == 9 && l[0] == 4)
    l.sort()
    assert(l[0] == 1 && l[2] == 4)
}
