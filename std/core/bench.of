/**
 * @module
 * `Bencher`: what a `@bench` function receives (spec 12.3).
 *
 * Only `ofir bench` loads this module, into every program it builds, as part
 * of the prelude.
 */

// requires: stage1 (loaded by `ofir bench`, which stage 0 does not have)

extern "C" {
    fn ofir_now_ns() i64
}

// How long a benchmark runs before its time is reported, in nanoseconds.
const TARGET_NANOS: int = 500_000_000

/**
 * Times the code of a benchmark.
 *
 * @example
 * ```ofir
 * @bench
 * fn benchSum(b: mut Bencher) {
 *     var xs: List<int> = []
 *     for i in 0..1000 {
 *         xs.push(i)
 *     }
 *     b.run(() => sum(xs))
 * }
 * ```
 */
pub copy struct Bencher {
    // The iterations of the last measurement.
    iters: int
    // Their total time, in nanoseconds.
    nanos: int

    /**
     * Calls `f` repeatedly, doubling the count until the calls take about
     * half a second, then prints the time per call.
     *
     * @param f the code to time
     */
    pub fn run(mut self, f: fn()) {
        f()   // a warm-up call
        var n = 1
        for {
            const start = unsafe { ofir_now_ns() }
            for _ in 0..n {
                f()
            }
            const elapsed = unsafe { ofir_now_ns() } - start
            self.iters = n
            self.nanos = elapsed as int
            if elapsed as int >= TARGET_NANOS || n >= 1 << 40 {
                break
            }
            n *= 2
        }
        println("{self.nanos / self.iters} ns/iter ({self.iters} iterations)")
    }
}

// The `Bencher` that `ofir bench` passes to each `@bench` function.
fn startBench() Bencher {
    return Bencher{iters: 0, nanos: 0}
}
