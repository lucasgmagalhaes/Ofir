/**
 * @module
 * Printing to standard error (spec 7.5). `print` and `println` are built
 * into the compiler; standard error is not buffered.
 */

extern "C" {
    fn ofir_stdout_flush()
    fn ofir_write(fd: i32, ptr: *u8, len: int)
}

/**
 * Writes text to standard error. Standard output is flushed first, so the
 * two streams appear in the order the program wrote them.
 *
 * @param text the text to write
 * @example
 * ```ofir
 * eprint("warning: ")
 * ```
 */
pub fn eprint(text: str) {
    unsafe {
        ofir_stdout_flush()
        ofir_write(2, text.asPtr(), text.len())
    }
}

/**
 * Writes text and a newline to standard error.
 *
 * @param text the text to write
 * @example
 * ```ofir
 * eprintln("usage: tool <file>")
 * ```
 */
pub fn eprintln(text: str) {
    eprint(text)
    eprint("\n")
}
