/**
 * @module
 * `List<T>`: a growable array (docs/std/collections.md).
 *
 * The compiler builds list literals with `withCapacity` and `push`, `[]`
 * with `new` and `[x; n]` with `filled`, and reaches elements through
 * `ptr` and `len` (`@lang("list")` fixes this layout).
 */

extern "C" {
    fn astra_alloc(size: int) *mut u8
    fn astra_realloc(p: *mut u8, size: int) *mut u8
    fn astra_free(p: *mut u8)
    fn memmove(dst: *mut u8, src: *u8, n: u64) *mut u8
}

extern "intrinsic" {
    fn dropInPlace<T>(p: *mut T)   // drops the value at `p` (spec 5.2)
    fn forget<T>(value: move T)    // consumes a value without dropping it
    // `a < b` for the instance's type. Stage 0: int, float and str (the
    // checker restricts `sort`); bounds replace it (roadmap 5.2).
    fn lessThan<T>(a: T, b: T) bool
    fn cloneOf<T>(value: T) T     // what `value.clone()` does for any `T` (roadmap 3.3)
}

/**
 * A growable array of values of type `T`, stored contiguously on the heap.
 *
 * Literals: `[1, 2, 3]`, `[0; 16]` (16 zeros), `[]` (type from the
 * context). `l[i]` reads or writes element `i` and panics outside
 * `0..l.len()`; `for x in l` visits the elements in order (stage 0: they
 * must be Copy). Pushing doubles the capacity when it runs out, so it
 * takes amortized constant time.
 *
 * @typeParam T the type of the elements
 * @example
 * ```astra
 * var scores = [70, 95, 82]
 * scores.push(64)
 * scores.sort()
 * println("{scores[0]} {scores[scores.len() - 1]}")   // 64 95
 * ```
 */
@lang("list")
pub struct List<T> {
    ptr: *mut T
    len: int
    cap: int

    /**
     * An empty list; nothing is allocated until the first push.
     *
     * @returns a list of length 0
     */
    pub fn new() List<T> {
        return List{ptr: unsafe { 0 as *mut T }, len: 0, cap: 0}
    }

    /**
     * Takes over a buffer of `len` initialized elements: the list frees it
     * when it is dropped.
     *
     * @param ptr the first element
     * @param len the number of elements
     * @param cap the number of elements the buffer can hold
     * @returns the list
     * @safety `ptr` must come from `astra_alloc` with room for `cap`
     * elements (or be null with `cap == 0`), and nothing else may free it
     */
    pub unsafe fn fromParts(ptr: *mut T, len: int, cap: int) List<T> {
        return List{ptr, len, cap}
    }

    /**
     * An empty list with room for `n` elements, to avoid reallocations
     * when the final length is known.
     *
     * @param n the number of elements to make room for
     * @returns a list of length 0 and capacity at least `n`
     * @panics when the system is out of memory
     */
    pub fn withCapacity(n: int) List<T> {
        var list: List<T> = List.new()
        list.reserve(n)
        return list
    }

    /**
     * A list of copies of one value: the literal `[value; count]`, which
     * requires a Copy value.
     *
     * @param value the element to repeat
     * @param count the length of the list
     * @returns a list of `count` elements equal to `value`
     * @panics when the system is out of memory
     */
    pub fn filled(value: T, count: int) List<T> {
        var list: List<T> = List.withCapacity(count)
        for i in 0..count {
            unsafe {
                *list.ptr.add(i) = *(&value as *T)   // a copy: the literal needs Copy values
            }
        }
        list.len = count
        return list
    }

    /**
     * The number of elements.
     *
     * @returns the length
     */
    pub fn len(self) int {
        return self.len
    }

    /**
     * Whether the list has no elements.
     *
     * @returns true when the length is 0
     */
    pub fn isEmpty(self) bool {
        return self.len == 0
    }

    /**
     * How many elements fit before the next reallocation.
     *
     * @returns the capacity, at least the length
     */
    pub fn capacity(self) int {
        return self.cap
    }

    /**
     * Makes room for more elements. The capacity at least doubles, so
     * repeated pushes reallocate O(log n) times.
     *
     * @param extra how many more elements must fit
     * @panics when the system is out of memory
     */
    pub fn reserve(mut self, extra: int) {
        let needed = self.len + extra
        if needed <= self.cap {
            return
        }
        var cap = if self.cap == 0 { 4 } else { self.cap * 2 }
        if cap < needed {
            cap = needed
        }
        self.ptr = unsafe { astra_realloc(self.ptr as *mut u8, cap * sizeOf<T>()) as *mut T }
        self.cap = cap
    }

    /**
     * Appends an element at the end, in amortized constant time.
     *
     * @param x the element; the list takes ownership of it
     * @panics when the system is out of memory
     * @example
     * ```astra
     * var xs: List<int> = []
     * xs.push(1)   // [1]
     * ```
     */
    pub fn push(mut self, x: move T) {
        if self.len == self.cap {
            self.reserve(1)
        }
        unsafe {
            *self.ptr.add(self.len) = x
        }
        self.len += 1
    }

    /**
     * A borrow of an element, without panicking: the safe form of `l[i]`.
     *
     * @param i the position
     * @returns `Some` with a reference to element `i`, or `None` outside
     * `0..len()`
     * @example
     * ```astra
     * let xs = [10, 20]
     * if let Some(x) = xs.get(1) {
     *     println("{x}")   // 20
     * }
     * ```
     */
    pub fn get(self, i: int) Option<&T> {
        if i < 0 || i >= self.len {
            return None
        }
        return Some(unsafe { &*self.ptr.add(i) })
    }

    /**
     * A mutable borrow of an element, without panicking.
     *
     * @param i the position
     * @returns `Some` with a mutable reference to element `i`, or `None`
     * outside `0..len()`
     * @example
     * ```astra
     * var xs = [1, 2]
     * if let Some(x) = xs.getMut(0) {
     *     *x = 10   // xs is [10, 2]
     * }
     * ```
     */
    pub fn getMut(mut self, i: int) Option<&mut T> {
        if i < 0 || i >= self.len {
            return None
        }
        return Some(unsafe { &mut *self.ptr.add(i) })
    }

    /**
     * A borrow of the first element.
     *
     * @returns `Some` with a reference to it, or `None` for an empty list
     */
    pub fn first(self) Option<&T> {
        return self.get(0)
    }

    /**
     * A borrow of the last element.
     *
     * @returns `Some` with a reference to it, or `None` for an empty list
     */
    pub fn last(self) Option<&T> {
        return self.get(self.len - 1)
    }

    /**
     * A view of all the elements. A list is converted to a slice where
     * one is expected, so this is rarely written.
     *
     * @returns a slice of the whole list
     */
    pub fn asSlice(self) &[T] {
        return unsafe { Slice.fromRaw(self.ptr, self.len) }
    }

    /**
     * A view of part of the list: `l[lo..hi]`.
     *
     * @param lo the first position
     * @param hi the position after the last one
     * @returns the elements `lo` to `hi - 1`
     * @panics unless `0 <= lo <= hi <= len()`
     * @example
     * ```astra
     * let xs = [10, 20, 30, 40]
     * let middle = xs[1..3]   // [20, 30]
     * ```
     */
    pub fn slice(self, lo: int, hi: int) &[T] {
        checkRange(lo, hi, self.len)
        return unsafe { Slice.fromRaw(self.ptr.add(lo), hi - lo) }
    }

    /**
     * A view of the end of the list: `l[lo..]`.
     *
     * @param lo the first position
     * @returns the elements from `lo` to the end
     * @panics unless `0 <= lo <= len()`
     */
    pub fn sliceFrom(self, lo: int) &[T] {
        return self.slice(lo, self.len)
    }

    /**
     * Removes the last element, in constant time.
     *
     * @returns `Some` with the last element, or `None` for an empty list
     * @example
     * ```astra
     * var stack = [1, 2]
     * assert(stack.pop() ?? 0 == 2)
     * ```
     */
    pub fn pop(mut self) Option<T> {
        if self.len == 0 {
            return None
        }
        self.len -= 1
        return Some(unsafe { *self.ptr.add(self.len) })
    }

    /**
     * Inserts an element at a position, shifting the later ones: O(n).
     *
     * @param i the position of the new element, from 0 to `len()`
     * @param x the element; the list takes ownership of it
     * @panics when `i` is negative or greater than `len()`
     * @example
     * ```astra
     * var xs = ["b", "c"]
     * xs.insert(0, "a")   // ["a", "b", "c"]
     * ```
     */
    pub fn insert(mut self, i: int, x: move T) {
        if i < 0 || i > self.len {
            panic("insertion index {i} is out of bounds for a list of length {self.len}")
        }
        self.reserve(1)
        unsafe {
            shift(self.ptr.add(i + 1), self.ptr.add(i), self.len - i)
            *self.ptr.add(i) = x
        }
        self.len += 1
    }

    /**
     * Removes the element at a position, shifting the later ones to keep
     * the order: O(n). `swapRemove` is O(1).
     *
     * @param i the position, in `0..len()`
     * @returns the removed element
     * @panics when `i` is outside `0..len()`
     */
    pub fn remove(mut self, i: int) T {
        self.checkIndex(i)
        let x = unsafe { *self.ptr.add(i) }
        unsafe {
            shift(self.ptr.add(i), self.ptr.add(i + 1), self.len - i - 1)
        }
        self.len -= 1
        return x
    }

    /**
     * Removes the element at a position and moves the last element into
     * its place: O(1), but the order changes.
     *
     * @param i the position, in `0..len()`
     * @returns the removed element
     * @panics when `i` is outside `0..len()`
     */
    pub fn swapRemove(mut self, i: int) T {
        self.checkIndex(i)
        unsafe {
            let x = *self.ptr.add(i)
            *self.ptr.add(i) = *self.ptr.add(self.len - 1)
            self.len -= 1
            return x
        }
    }

    /**
     * Removes every element; the capacity is kept for reuse.
     */
    pub fn clear(mut self) {
        self.truncate(0)
    }

    /**
     * A new list with a clone of each element, in the same order.
     *
     * @returns a list of the same length, which owns its elements
     * @example
     * ```astra
     * let names = ["ada".toOwned(), "alan".toOwned()]
     * var copy = names.clone()
     * copy.push("grace".toOwned())   // names keeps 2 elements
     * ```
     */
    pub fn clone(self) List<T> {
        var out: List<T> = List.withCapacity(self.len)
        for i in 0..self.len {
            unsafe {
                out.push(cloneOf(*self.ptr.add(i)))
            }
        }
        return out
    }

    /**
     * Shortens the list to its first elements; a longer `n` changes
     * nothing.
     *
     * @param n the number of elements to keep
     */
    pub fn truncate(mut self, n: int) {
        for self.len > n && self.len > 0 {   // the dropped elements, last first
            self.len -= 1
            unsafe {
                dropInPlace(self.ptr.add(self.len))
            }
        }
    }

    /**
     * Moves all the elements of another list to the end of this one.
     *
     * @param other the list to empty into this one; it is consumed
     * @panics when the system is out of memory
     * @example
     * ```astra
     * var xs = [1, 2]
     * xs.extend([3, 4])   // [1, 2, 3, 4]
     * ```
     */
    pub fn extend(mut self, other: move List<T>) {
        self.reserve(other.len)
        unsafe {
            shift(self.ptr.add(self.len), other.ptr, other.len)
            if other.cap > 0 {
                astra_free(other.ptr as *mut u8)
            }
        }
        self.len += other.len
        forget(other)   // its elements were moved here
    }

    /**
     * Reverses the order of the elements, in place.
     */
    pub fn reverse(mut self) {
        var i = 0
        var j = self.len - 1
        for i < j {
            unsafe {
                let a = *self.ptr.add(i)
                *self.ptr.add(i) = *self.ptr.add(j)
                *self.ptr.add(j) = a
            }
            i += 1
            j -= 1
        }
    }

    /**
     * Sorts the elements in ascending order. The sort is stable (equal
     * elements keep their order) and takes O(n log n) time: a bottom-up
     * merge sort through one temporary buffer.
     *
     * Stage 0 sorts lists of int, float and str (E0313 otherwise), until
     * generic bounds (roadmap 5.2).
     *
     * @panics when the system is out of memory
     * @example
     * ```astra
     * var names = ["mia", "ana", "bob"]
     * names.sort()   // ["ana", "bob", "mia"]
     * ```
     */
    pub fn sort(mut self) {
        if self.len < 2 {
            return
        }
        var src = self.ptr
        var dst = unsafe { astra_alloc(self.len * sizeOf<T>()) as *mut T }
        var width = 1
        for width < self.len {
            var lo = 0
            for lo < self.len {
                let mid = (lo + width).min(self.len)
                let hi = (lo + 2 * width).min(self.len)
                mergeRuns(src, dst, lo, mid, hi)
                lo = hi
            }
            let done = src
            src = dst
            dst = done
            width *= 2
        }
        if src != self.ptr {   // the sorted run is in the buffer
            unsafe {
                shift(self.ptr, src, self.len)
            }
            dst = src
        }
        unsafe {
            astra_free(dst as *mut u8)
        }
    }

    // Drops the elements, then frees the buffer (spec 5.2).
    fn drop(mut self) {
        self.truncate(0)
        if self.cap > 0 {
            unsafe {
                astra_free(self.ptr as *mut u8)
            }
        }
    }

    fn checkIndex(self, i: int) {
        if i < 0 || i >= self.len {
            panic("index out of bounds: the length is {self.len} but the index is {i}")
        }
    }
}

// Moves `count` elements from `src` to `dst`; the ranges may overlap.
unsafe fn shift<T>(dst: *mut T, src: *T, count: int) {
    if count > 0 {
        memmove(dst as *mut u8, src as *u8, (count * sizeOf<T>()) as u64)
    }
}

// Merges the sorted runs src[lo..mid] and src[mid..hi] into dst[lo..hi];
// on ties the left run comes first, so the sort is stable.
fn mergeRuns<T>(src: *mut T, dst: *mut T, lo: int, mid: int, hi: int) {
    var i = lo
    var j = mid
    for k in lo..hi {
        unsafe {
            let takeLeft = i < mid && (j >= hi || !lessThan(*src.add(j), *src.add(i)))
            if takeLeft {
                *dst.add(k) = *src.add(i)
                i += 1
            } else {
                *dst.add(k) = *src.add(j)
                j += 1
            }
        }
    }
}
