/**
 * @module
 * `Option<T>`: a value that may be absent (spec 6.1, docs/std/core.md).
 *
 * `Some` and `None` are in scope everywhere, in expressions and patterns.
 */

/**
 * A value of type `T`, or nothing.
 *
 * Ofir has no null: a function that may find nothing returns an Option,
 * and the caller must look inside, with `match`, `if let`, `let ... else`,
 * `?` (which returns `None` from the caller) or `??` (a default).
 * `Option<T>` is Copy when `T` is.
 *
 * @typeParam T the type of the content
 * @example
 * ```ofir
 * fn find(names: List<str>, wanted: str) Option<int> {
 *     for i in 0..names.len() {
 *         if names[i] == wanted {
 *             return Some(i)
 *         }
 *     }
 *     return None
 * }
 *
 * let index = find(["ana", "bob"], "bob") ?? -1   // 1
 * ```
 */
@lang("option")
pub enum Option<T> {
    /** A value is present. */
    Some(value: T)
    /** No value. */
    None

    /**
     * Whether a value is present.
     *
     * @returns true for `Some`
     */
    pub fn isSome(self) bool {
        return match self {
            Option.Some(_) => true
            Option.None => false
        }
    }

    /**
     * Whether the value is absent.
     *
     * @returns true for `None`
     */
    pub fn isNone(self) bool {
        return !self.isSome()
    }

    /**
     * Takes the content out. Prefer `?`, `??` or `match` where `None` is
     * possible: `unwrap` is for when it would be a bug.
     *
     * @returns the content of `Some`
     * @panics on `None`, with "called `unwrap` on a `None` value"
     * @example
     * ```ofir
     * assert(Some(4).unwrap() == 4)
     * ```
     */
    pub fn unwrap(move self) T {
        return match self {
            Option.Some(value) => value
            Option.None => panic("called `unwrap` on a `None` value")
        }
    }

    /**
     * Takes the content out, with a message explaining why it must exist.
     *
     * @param message the panic message for `None`
     * @returns the content of `Some`
     * @panics on `None`, with `message`
     * @example
     * ```ofir
     * let port = config.get("port").expect("the config has a port")
     * ```
     */
    pub fn expect(move self, message: str) T {
        return match self {
            Option.Some(value) => value
            Option.None => panic(message)
        }
    }

    /**
     * Takes the content out, or a default. `a ?? b` does the same and
     * evaluates `b` only on `None`.
     *
     * @param fallback the value for `None`
     * @returns the content of `Some`, else `fallback`
     * @example
     * ```ofir
     * let none: Option<int> = None
     * assert(none.unwrapOr(8080) == 8080)
     * ```
     */
    pub fn unwrapOr(move self, fallback: move T) T {
        return match self {
            Option.Some(value) => value
            Option.None => fallback
        }
    }

    /**
     * Moves the content out, leaving `None` in its place.
     *
     * @returns the previous value: `Some` with the content, or `None`
     * @example
     * ```ofir
     * var slot = Some("token")
     * let taken = slot.take()   // Some("token"); slot is now None
     * ```
     */
    pub fn take(mut self) Option<T> {
        let taken = self
        self = Option.None
        return taken
    }

    /**
     * Turns an absent value into an error, to use `?` in a function that
     * returns a Result.
     *
     * @typeParam E the type of the error
     * @param error the error for `None`
     * @returns `Ok` with the content of `Some`, else `Err(error)`
     * @example
     * ```ofir
     * let user = findUser(id).okOr("no such user")?
     * ```
     */
    pub fn okOr<E>(move self, error: move E) Result<T, E> {
        return match self {
            Option.Some(value) => Result.Ok(value)
            Option.None => Result.Err(error)
        }
    }
}
