/**
 * @module
 * The methods of `str` (docs/std/strings.md).
 */

extern "C" {
    fn memcpy(dst: *mut u8, src: *u8, n: u64) *mut u8
    fn memcmp(a: *u8, b: *u8, n: u64) i32
    fn astra_alloc(size: int) *mut u8
    fn astra_realloc(p: *mut u8, size: int) *mut u8
}

/**
 * An owned, growable UTF-8 string (spec 2.3).
 *
 * A literal points to read-only memory and has `cap == 0`; it is copied
 * to the heap on its first modification, so literals cost nothing until
 * then. `s[i]` is the byte at offset `i`, bounds checked, and `+` and
 * interpolation (`"{x}"`) build new strings. The compiler and the runtime
 * share the layout of the fields: `ptr`, `len`, `cap`.
 *
 * @example
 * ```astra
 * var greeting = "hello"
 * greeting.push(", world")
 * println("{greeting.len()} {greeting.toUpper()}")   // 12 HELLO, WORLD
 * ```
 */
@lang("str")
pub struct str {
    ptr: *u8
    len: int
    cap: int

    /**
     * An empty string; nothing is allocated.
     *
     * @returns `""`
     */
    pub fn new() str {
        return ""
    }

    /**
     * The length in bytes, not in characters: `"é".len()` is 2.
     *
     * @returns the number of bytes
     */
    pub fn len(self) int {
        return self.len
    }

    /**
     * Whether the string has no bytes.
     *
     * @returns true for `""`
     */
    pub fn isEmpty(self) bool {
        return self.len == 0
    }

    /**
     * Appends a string at the end. The capacity doubles when it runs out,
     * so pushing in a loop takes amortized constant time per byte.
     *
     * @param t the string to append
     * @panics when the system is out of memory
     * @example
     * ```astra
     * var s = "a"
     * s.push("bc")   // "abc"
     * ```
     */
    pub fn push(mut self, t: str) {
        if t.len == 0 {
            return
        }
        self.reserve(t.len)
        unsafe {
            memcpy(self.ptr.add(self.len) as *mut u8, t.ptr, t.len as u64)
        }
        self.len += t.len
    }

    /**
     * Empties the string. A heap buffer keeps its capacity, for reuse.
     */
    pub fn clear(mut self) {
        if self.cap == 0 {
            self.ptr = "".ptr
        }
        self.len = 0
    }

    /**
     * Whether the string begins with `prefix`.
     *
     * @param prefix the bytes to look for at the start
     * @returns true if the first bytes equal `prefix`; always for `""`
     * @example
     * ```astra
     * assert("main.at".startsWith("main"))
     * ```
     */
    pub fn startsWith(self, prefix: str) bool {
        return prefix.len <= self.len && sameBytes(self.ptr, prefix.ptr, prefix.len)
    }

    /**
     * Whether the string ends with `suffix`.
     *
     * @param suffix the bytes to look for at the end
     * @returns true if the last bytes equal `suffix`; always for `""`
     * @example
     * ```astra
     * assert("main.at".endsWith(".at"))
     * ```
     */
    pub fn endsWith(self, suffix: str) bool {
        if suffix.len > self.len {
            return false
        }
        let start = unsafe { self.ptr.add(self.len - suffix.len) }
        return sameBytes(start, suffix.ptr, suffix.len)
    }

    /**
     * Whether `part` occurs in the string, by a direct search: O(n * m).
     *
     * @param part the bytes to look for
     * @returns true if some substring equals `part`; always for `""`
     * @example
     * ```astra
     * assert("hello".contains("ell"))
     * ```
     */
    pub fn contains(self, part: str) bool {
        for i in 0..=self.len - part.len {
            if sameBytes(unsafe { self.ptr.add(i) }, part.ptr, part.len) {
                return true
            }
        }
        return false
    }

    /**
     * The string repeated, in one allocation.
     *
     * @param n how many copies
     * @returns `n` copies one after the other; `""` when `n <= 0`
     * @example
     * ```astra
     * assert("ab".repeat(3) == "ababab")
     * ```
     */
    pub fn repeat(self, n: int) str {
        var out = ""
        if n > 0 && self.len > 0 {
            out.reserve(self.len * n)
        }
        for i in 0..n {
            out.push(self)
        }
        return out
    }

    /**
     * A copy with the ASCII letters in lower case; other bytes, including
     * non-ASCII letters, are unchanged.
     *
     * @returns the new string
     * @example
     * ```astra
     * assert("Astra 1.0".toLower() == "astra 1.0")
     * ```
     */
    pub fn toLower(self) str {
        return self.mapAscii(b'A', b'Z')
    }

    /**
     * A copy with the ASCII letters in upper case; other bytes are
     * unchanged.
     *
     * @returns the new string
     */
    pub fn toUpper(self) str {
        return self.mapAscii(b'a', b'z')
    }

    /**
     * A copy on the heap, owned by the caller, also for a literal.
     *
     * @returns the new string
     */
    pub fn toOwned(self) str {
        var out = ""
        out.push(self)
        return out
    }

    // Makes room for `extra` more bytes; a literal moves to the heap.
    fn reserve(mut self, extra: int) {
        let needed = self.len + extra
        if needed <= self.cap {
            return
        }
        var cap = if self.cap > 0 { self.cap * 2 } else { 16 }
        for cap < needed {
            cap *= 2
        }
        unsafe {
            if self.cap == 0 {
                let heap = astra_alloc(cap)
                if self.len > 0 {
                    memcpy(heap, self.ptr, self.len as u64)
                }
                self.ptr = heap
            } else {
                self.ptr = astra_realloc(self.ptr as *mut u8, cap)
            }
        }
        self.cap = cap
    }

    // A copy where the bytes in `from..=to` have their ASCII case flipped.
    fn mapAscii(self, from: u8, to: u8) str {
        var out = self.toOwned()
        for i in 0..out.len {
            unsafe {
                let at = out.ptr.add(i) as *mut u8
                if *at >= from && *at <= to {
                    *at = *at ^ 0x20
                }
            }
        }
        return out
    }
}

// Whether the `n` bytes at `a` and `b` are equal.
fn sameBytes(a: *u8, b: *u8, n: int) bool {
    return n == 0 || unsafe { memcmp(a, b, n as u64) } == 0
}
