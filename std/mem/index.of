/**
 * @module
 * `std.mem`: moving values in and out of places that cannot be left empty
 * (spec 5.1).
 */

/**
 * Puts a new value in a place and returns the old one: the way to take a
 * value out of a list element, a field of a borrowed struct or a `mut`
 * parameter, which cannot be moved out of directly (E0602).
 *
 * @typeParam T the type of the values
 * @param dest the place to update
 * @param value the new value
 * @returns the value `dest` held before
 * @example
 * ```ofir
 * import std.mem
 *
 * var names = ["ana", "bob"]
 * const old = mem.replace(names[0], "cy")   // old is "ana"; names is ["cy", "bob"]
 * ```
 */
pub fn replace<T>(dest: mut T, value: move T) T {
    unsafe {
        const place = &mut dest as *mut T
        const old = *place
        *place = value
        return old
    }
}

/**
 * Exchanges the values of two places.
 *
 * @typeParam T the type of the values
 * @param a the first place
 * @param b the second place
 */
pub fn swap<T>(a: mut T, b: mut T) {
    unsafe {
        const pa = &mut a as *mut T
        const pb = &mut b as *mut T
        const saved = *pa
        *pa = *pb
        *pb = saved
    }
}
