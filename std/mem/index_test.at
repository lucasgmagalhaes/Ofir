// The tests of `std.mem` (spec 12.2): `astra test std/mem/index.at` runs them.

@test
fn replaceReturnsTheOldValue() {
    var names = ["ana".toOwned(), "bob".toOwned()]
    let old = replace(names[0], "cy".toOwned())
    assert(old == "ana" && names[0] == "cy")
    swap(names[0], names[1])
    assert(names[0] == "bob" && names[1] == "cy")
}
