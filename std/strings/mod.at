/**
 * @module
 * `std.strings`: building strings from parts and from bytes
 * (docs/std/strings.md). The methods of `str` itself are in std/core/str.at.
 */

/**
 * The parts one after the other, with `sep` between each two.
 *
 * @param parts the strings to join
 * @param sep what goes between two parts
 * @returns the new string; `""` when there are no parts
 * @example
 * ```astra
 * import std.strings
 *
 * let csv = strings.join(["a", "b", "c"], ",")   // "a,b,c"
 * ```
 */
pub fn join(parts: [str], sep: str) str {
    var size = 0
    for i in 0..parts.len() {
        size += parts[i].len() + sep.len()
    }
    var out = str.withCapacity(size)
    for i in 0..parts.len() {
        if i > 0 {
            out.push(sep)
        }
        out.push(parts[i])
    }
    return out
}

/**
 * Why bytes are not UTF-8 text.
 */
pub struct Utf8Error {
    /** The offset of the first byte that does not start a valid sequence. */
    pub offset: int
}

/**
 * The text that the bytes encode as UTF-8, checked: no overlong encoding,
 * surrogate or value above `0x10FFFF`.
 *
 * @param bytes the encoded text
 * @returns the string, or `Utf8Error` with the offset of the first invalid
 * sequence
 * @example
 * ```astra
 * import std.strings
 *
 * let ok = strings.fromUtf8([0x68, 0x69])   // Ok("hi")
 * let bad = strings.fromUtf8([0xFF])        // Err(Utf8Error{offset: 0})
 * ```
 */
pub fn fromUtf8(bytes: move List<u8>) Result<str, Utf8Error> {
    var out = str.withCapacity(bytes.len())
    var i = 0
    for i < bytes.len() {
        let .Some(decoded) = decode(bytes, i) else {
            return .Err(Utf8Error{offset: i})
        }
        out.pushChar(decoded.0)
        i += decoded.1
    }
    return .Ok(out)
}

// The scalar value of the UTF-8 sequence at `i` and its length, or None.
fn decode(b: List<u8>, i: int) Option<(u32, int)> {
    let first = b[i] as u32
    if first < 0x80 {
        return .Some((first, 1))
    }
    let n = if first >= 0xC2 && first <= 0xDF { 2 } else if first >= 0xE0 && first <= 0xEF {
        3
    } else if first >= 0xF0 && first <= 0xF4 { 4 } else { 0 }
    if n == 0 || i + n > b.len() {
        return .None
    }
    let mask: u32 = 0x7F
    var c = first & (mask >> n as u32)
    for k in 1..n {
        let next = b[i + k] as u32
        if next & 0xC0 != 0x80 {
            return .None
        }
        c = (c << 6) | (next & 0x3F)
    }
    let min: u32 = if n == 2 { 0x80 } else if n == 3 { 0x800 } else { 0x10000 }
    if c < min || c > 0x10FFFF || (c >= 0xD800 && c <= 0xDFFF) {
        return .None
    }
    return .Some((c, n))
}

/**
 * Builds a string piece by piece; the same as pushing to a `str`, for
 * code that reads better with a builder.
 *
 * @example
 * ```astra
 * import std.strings
 *
 * var b = strings.Builder.new()
 * b.push("n = ")
 * b.pushChar(0x31)
 * let text = b.finish()   // "n = 1"
 * ```
 */
pub struct Builder {
    text: str

    /**
     * An empty builder; nothing is allocated.
     *
     * @returns the builder
     */
    pub fn new() Builder {
        return Builder{text: ""}
    }

    /**
     * Appends a string.
     *
     * @param t the string to append
     */
    pub fn push(mut self, t: str) {
        self.text.push(t)
    }

    /**
     * Appends a Unicode scalar value, encoded as UTF-8.
     *
     * @param c the scalar value
     * @panics when `c` is not a Unicode scalar value
     */
    pub fn pushChar(mut self, c: u32) {
        self.text.pushChar(c)
    }

    /**
     * The length of the text so far, in bytes.
     *
     * @returns the number of bytes
     */
    pub fn len(self) int {
        return self.text.len()
    }

    /**
     * The text built.
     *
     * @returns the string, which the builder no longer holds
     */
    pub fn finish(move self) str {
        return self.text
    }
}
