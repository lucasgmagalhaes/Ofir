// The binary-trees benchmark of the Computer Language Benchmarks Game:
// allocating and freeing many small boxes.

enum Tree {
    Leaf
    Node(Box<Tree>, Box<Tree>)
}

fn make(depth: int) Tree {
    if depth == 0 {
        return Tree.Node(Box.new(Tree.Leaf), Box.new(Tree.Leaf))
    }
    return Tree.Node(Box.new(make(depth - 1)), Box.new(make(depth - 1)))
}

fn check(t: Tree) int {
    return match t {
        Tree.Leaf => 0
        Tree.Node(l, r) => 1 + check(*l) + check(*r)
    }
}

fn main() {
    const maxDepth = 18
    // The stretch tree is a temporary: freed at the end of the statement.
    println("stretch tree of depth {maxDepth + 1}\t check: {check(make(maxDepth + 1))}")
    const longLived = make(maxDepth)
    var depth = 4
    for depth <= maxDepth {
        const iterations = 1 << (maxDepth - depth + 4)
        var sum = 0
        for _ in 0..iterations {
            const t = make(depth)
            sum += check(t)
        }
        println("{iterations}\t trees of depth {depth}\t check: {sum}")
        depth += 2
    }
    println("long lived tree of depth {maxDepth}\t check: {check(longLived)}")
}
