// The n-body simulation of the Computer Language Benchmarks Game: floating
// point arithmetic on a list of structs.

copy struct Body {
    x: float
    y: float
    z: float
    vx: float
    vy: float
    vz: float
    mass: float
}

fn body(x: float, y: float, z: float, vx: float, vy: float, vz: float, mass: float) Body {
    const days = 365.24
    const solar = 4.0 * 3.141592653589793 * 3.141592653589793
    return Body{x, y, z, vx: vx * days, vy: vy * days, vz: vz * days, mass: mass * solar}
}

fn system() List<Body> {
    const solar = 4.0 * 3.141592653589793 * 3.141592653589793
    return [
        Body{x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar},
        body(4.84143144246472090, -1.16032004402742839, -0.103622044471123109,
             0.00166007664274403694, 0.00769901118419740425, -0.0000690460016972063023,
             0.000954791938424326609),
        body(8.34336671824457987, 4.12479856412430479, -0.403523417114321381,
             -0.00276742510726862411, 0.00499852801234917238, 0.0000230417297573763929,
             0.000285885980666130812),
        body(12.8943695621391310, -15.1111514016986312, -0.223307578892655734,
             0.00296460137564761618, 0.00237847173959480950, -0.0000296589568540237556,
             0.0000436624404335156298),
        body(15.3796971148509165, -25.9193146099879641, 0.179258772950371181,
             0.00268067772490389322, 0.00162824170038242295, -0.0000951592254519715870,
             0.0000515138902046611451),
    ]
}

fn offsetMomentum(bodies: mut List<Body>) {
    let px = 0.0
    let py = 0.0
    let pz = 0.0
    for i in 0..bodies.len() {
        px += bodies[i].vx * bodies[i].mass
        py += bodies[i].vy * bodies[i].mass
        pz += bodies[i].vz * bodies[i].mass
    }
    const solar = bodies[0].mass
    bodies[0].vx = -px / solar
    bodies[0].vy = -py / solar
    bodies[0].vz = -pz / solar
}

fn energy(bodies: List<Body>) float {
    let e = 0.0
    for i in 0..bodies.len() {
        const b = bodies[i]
        e += 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        for j in i + 1..bodies.len() {
            const dx = b.x - bodies[j].x
            const dy = b.y - bodies[j].y
            const dz = b.z - bodies[j].z
            e -= b.mass * bodies[j].mass / (dx * dx + dy * dy + dz * dz).sqrt()
        }
    }
    return e
}

fn advance(bodies: mut List<Body>, dt: float) {
    const n = bodies.len()
    for i in 0..n {
        for j in i + 1..n {
            const dx = bodies[i].x - bodies[j].x
            const dy = bodies[i].y - bodies[j].y
            const dz = bodies[i].z - bodies[j].z
            const d2 = dx * dx + dy * dy + dz * dz
            const mag = dt / (d2 * d2.sqrt())
            const mi = bodies[i].mass * mag
            const mj = bodies[j].mass * mag
            bodies[i].vx -= dx * mj
            bodies[i].vy -= dy * mj
            bodies[i].vz -= dz * mj
            bodies[j].vx += dx * mi
            bodies[j].vy += dy * mi
            bodies[j].vz += dz * mi
        }
    }
    for i in 0..n {
        bodies[i].x += dt * bodies[i].vx
        bodies[i].y += dt * bodies[i].vy
        bodies[i].z += dt * bodies[i].vz
    }
}

fn main() {
    let bodies = system()
    offsetMomentum(bodies)
    println("{energy(bodies)}")
    for _ in 0..5000000 {
        advance(bodies, 0.01)
    }
    println("{energy(bodies)}")
}
