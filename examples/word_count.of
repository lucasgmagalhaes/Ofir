import std.fs
import std.os

fn countWords(text: str) Map<str, int> {
    var counts = Map<str, int>.new()
    for word in text.splitWhitespace() {
        const key = word.toLower()
        const current = match counts.get(key) {
            Option.Some(n) => *n
            Option.None => 0
        }
        counts.insert(key, current + 1)
    }
    return counts
}

fn main() {
    const args = os.args()
    if args.len() < 2 {
        eprintln("usage: word_count <file>")
        os.exit(2)
    }

    const text = match fs.readToString(args[1]) {
        Result.Ok(text) => text
        Result.Err(e) => {
            eprintln("word_count: {args[1]}: {e.message}")
            os.exit(1)
        }
    }
    const counts = countWords(text)

    for word, n in counts {
        println("{word}: {n}")
    }
}
