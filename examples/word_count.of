import std.fs
import std.os

fn countWords(text: str) Map<str, int> {
    var counts = Map<str, int>.new()
    for word in text.splitWhitespace() {
        let key = word.toLower()
        let current = match counts.get(key) {
            .Some(n) => *n
            .None => 0
        }
        counts.insert(key, current + 1)
    }
    return counts
}

fn main() {
    let args = os.args()
    if args.len() < 2 {
        eprintln("usage: word_count <file>")
        os.exit(2)
    }

    let text = match fs.readToString(args[1]) {
        .Ok(text) => text
        .Err(e) => {
            eprintln("word_count: {args[1]}: {e.message}")
            os.exit(1)
        }
    }
    let counts = countWords(text)

    for word, n in counts {
        println("{word}: {n}")
    }
}
