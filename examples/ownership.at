struct Inventory {
    items: List<str>
}

// Borrows the inventory to read it (the default).
fn (inv: Inventory) count() int {
    return inv.items.len()
}

// Modifies the caller's inventory and takes ownership of the item.
fn (inv: mut Inventory) add(item: move str) {
    inv.items.push(item)
}

// Takes ownership; the inventory is dropped when this function returns.
fn discard(inv: move Inventory) {
    println("discarding {inv.count()} items")
}

fn main() {
    var inv = Inventory{items: []}
    inv.add("sword")
    inv.add("shield")
    println("items: {inv.count()}")

    discard(inv)            // nothing marks the call: the signature says `move`
    // inv.add("potion")   // error: use of moved value `inv`
}
