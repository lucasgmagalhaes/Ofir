import std.fs
import std.os

fn count_words(text: &str) -> Map<str, int> {
    var counts = Map<str, int>.new()
    for word in text.split_whitespace() {
        let key = word.to_lower()
        let current = match counts.get(&key) {
            .Some(n) => n
            .None => 0
        }
        counts.insert(key, current + 1)
    }
    return counts
}

fn main() -> Result<(), str> {
    let args = os.args()
    if args.len() < 2 {
        return Err("usage: word_count <file>")
    }

    let text = fs.read_to_string(&args[1])?
    let counts = count_words(&text)

    for word, n in counts {
        println("{word}: {n}")
    }
    return Ok(())
}
