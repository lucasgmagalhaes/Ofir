interface Shape {
    fn area(self) float
    fn name(self) str

    fn describe(self) str {
        return "{self.name()} with area {self.area():.2}"
    }
}

struct Circle: Shape {
    radius: float

    fn area(self) float {
        return 3.14159 * self.radius * self.radius
    }

    fn name(self) str {
        return "circle"
    }
}

struct Square: Shape {
    side: float

    fn area(self) float {
        return self.side * self.side
    }

    fn name(self) str {
        return "square"
    }
}

// Static dispatch: one specialized copy per shape type.
fn printArea<S: Shape>(shape: S) {
    println(shape.describe())
}

fn main() {
    printArea(Circle{radius: 1.0})

    // Dynamic dispatch: a list of different shapes.
    let shapes: List<Box<dyn Shape>> = [
        Box.new(Circle{radius: 2.0}),
        Box.new(Square{side: 3.0}),
    ]
    for s in shapes {
        println(s.describe())
    }
}
