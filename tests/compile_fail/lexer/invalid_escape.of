fn main() {
    const a = "bad \q escape"          // error[E0004]: invalid escape sequence
}

fn second() {
    const b = "not ascii: \x80"        // error[E0004]: `\x` escapes in strings must be between
}

fn third() {
    const c = "surrogate: \u{d800}"    // error[E0004]: invalid unicode escape
}

fn fourth() {
    const d = b'ab'                    // error[E0004]: invalid byte literal
}
