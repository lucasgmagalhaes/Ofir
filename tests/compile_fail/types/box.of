struct Point {
    x: int

    fn shift(mut self) {
        self.x += 1
    }
}

fn main() {
    const b = Box.new(Point{x: 1})
    b.x = 2                      // error[E0315]: this value cannot be modified: declare it with `var`
    b.shift()                    // error[E0315]: this value cannot be modified: declare it with `var`
    *b = Point{x: 3}             // error[E0315]: this value cannot be modified: declare it with `var`
    const n: int = *Box.new("s")   // error[E0300]: mismatched types: expected int, found str
    const q = b.ptr                // error[E0316]: no field `ptr` on type `Point`
}
