fn takesStr(text: str) {}

fn returnsInt() int {
    return "seven"   // error[E0300]: mismatched types: expected int, found str
}

fn annotations() {
    const a: int = "x"      // error[E0300]: mismatched types: expected int, found str
    var b: bool = 1       // error[E0300]: mismatched types: expected bool, found int
    const c: str = true     // error[E0300]: mismatched types: expected str, found bool
}

fn arguments() {
    takesStr(42)          // error[E0300]: mismatched types: expected str, found int
    println(1)            // error[E0300]: mismatched types: expected str, found int
}

fn operands(n: int, small: u8) {
    const a = n + small     // error[E0300]: mismatched types: expected int, found u8
    const b = n + "1"       // error[E0300]: mismatched types: expected int, found str
}

fn conditions(n: int) {
    if n {                // error[E0300]: mismatched types: expected bool, found int
    }
    for n {               // error[E0300]: mismatched types: expected bool, found int
    }
}

fn branches(flag: bool) {
    const value = if flag { 1 } else { "one" }   // error[E0353]: the branches have different types, `int` and `str`: write the union type expected
    const typed: int = if flag { 1 } else { "one" }   // error[E0300]: mismatched types: expected int, found str
    const arm = match flag {
        true => 1
        false => true   // error[E0353]: the branches have different types, `int` and `bool`: write the union type expected
    }
}

fn emptyReturn() int {
    return   // error[E0300]: mismatched types: expected int, found ()
}

fn typed(x: nowhere.Thing) {   // error[E0200]: cannot find `nowhere` in this scope
}
