// requires: stage1
fn main() {
    let n = 42
    let x = 1.5
    let s = "a"
    let _a = "{n:.2}" // error[E0357]: the format specifier `.2` does not apply to a value of type `int`
    let _b = "{x:x}" // error[E0357]: the format specifier `x` does not apply to a value of type `float`
    let _c = "{s:05}" // error[E0357]: the format specifier `05` does not apply to a value of type `str`
    let _d = "{n:5q}" // error[E0357]: invalid format specifier `5q`
    let _e = "{n:<}" // error[E0357]: invalid format specifier `<`
    let _f = "{n:?}" // error[E0901]: the debug format `?` is not supported yet
}
