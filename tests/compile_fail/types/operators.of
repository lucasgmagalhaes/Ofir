fn arithmetic(flag: bool, text: str) {
    const a = flag + flag     // error[E0313]: operator cannot be applied to type `bool`
}

fn subtraction(text: str) {
    const b = text - text     // error[E0313]: operator cannot be applied to type `str`
}

fn negation(n: u32) {
    const c = -n              // error[E0313]: operator cannot be applied to type `u32`
}

fn logic(n: int) {
    const d = n && n          // error[E0313]: operator cannot be applied to type `int`
}

fn casts(text: str) {
    const e = text as int     // error[E0313]: cannot cast `str` to `int`
}

// Accepted.
fn valid(a: int, b: int, x: float, s: str, flag: bool) {
    const sum = a + b * 2 - a / b % 3
    const bits = a & b | a ^ b << 2 >> 1
    const less = a < b && x >= 1.5 || !flag
    const same = s == "x" && s != "y" && s < "z"
    const joined = s + "!"
    const converted = a as float + x
    const small = x as u8
}
