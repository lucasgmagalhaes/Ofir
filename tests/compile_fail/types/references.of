struct Holder {
    value: &int                  // error[E0702]: a reference cannot be stored in a struct field: store an owned value, or declare a `ref struct`
}

enum Either {
    Left(&str)
    Right(&[int])                // error[E0702]: a reference cannot be stored in an enum variant: store an owned value, or declare a `ref struct`
}

fn noSource(a: int, b: int) &int {   // error[E0702]: a function that returns a reference must borrow it from `self` or from its only borrowed parameter, which it has none of
    return &a
}

fn twoSources(a: List<int>, b: List<int>) &int {   // error[E0702]: a function that returns a reference must borrow it from `self` or from its only borrowed parameter, which it has several of
    return &a[0]
}

fn dangling(xs: List<int>) &int {
    let local = 5
    return &local                // error[E0702]: cannot return a reference to `local`, which ends with the function
}

enum Wrapped {
    One(List<int>)
    Two(List<int>)
}

// A binding of a `match` on a borrowed value is a copy that ends with the
// function; the elements it points to outlive it.
fn inside(w: &Wrapped) &List<int> {
    return match *w {
        Wrapped.One(list) => &list      // error[E0702]: cannot return a reference to `list`, which ends with the function
        Wrapped.Two(list) => {
            &list                // error[E0702]: cannot return a reference to `list`, which ends with the function
        }
    }
}

fn element(w: &Wrapped) &int {
    return match *w {
        Wrapped.One(list) => &list[0]
        Wrapped.Two(list) => &list[1]
    }
}

fn main() {
    let n = 1
    let r = &mut n               // error[E0315]: this value cannot be modified: declare it with `var`
    var m = 2
    let shared = &m
    *shared = 3                  // error[E0315]: this value cannot be modified: it is reached through a `&T`, not a `&mut T`
    let xs = [1, 2, 3]
    let view = xs[0..2]
    view[0] = 5                  // error[E0315]: this value cannot be modified: the elements of a `&[T]` are read-only
    let refs = [&m]              // error[E0702]: a reference cannot be stored in a container or a struct: store an owned value, or declare a `ref struct`
    let wrong: &[str] = xs       // error[E0300]: mismatched types: expected Slice<str>, found List<int>
}
