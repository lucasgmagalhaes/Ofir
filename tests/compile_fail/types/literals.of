fn ranges() {
    const a: u8 = 255
    const b: u8 = 256         // error[E0312]: integer literal out of range for `u8`
}

fn negative() {
    const a: i8 = -128
    const b: i8 = -129        // error[E0312]: integer literal out of range for `i8`
}

fn unsigned() {
    const c: u32 = -1         // error[E0313]: operator cannot be applied to type `u32`
}

fn defaults() {
    const big = 9223372036854775808   // error[E0312]: integer literal out of range for `int`
}

// Accepted: literals take the expected type.
fn inferred(small: u8, ratio: float) {
    const a = small + 1
    const b = 2 * small
    const c = ratio * 2
    var total: float = 0
    const d: i16 = -300
}

const LOOP = LOOP + 1   // error[E0800]: the constant `LOOP` depends on itself
