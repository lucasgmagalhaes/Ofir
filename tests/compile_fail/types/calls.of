fn add(a: int, b: int) int {
    return a + b
}

fn count() {
    const x = add(1)          // error[E0302]: wrong number of arguments: expected 2, found 1
}

fn extra() {
    println("a", "b")       // error[E0302]: wrong number of arguments: expected 1, found 2
}

fn notCallable(n: int) {
    n(1)                    // error[E0311]: expression of type `int` is not a function
}

fn typeAsValue() {
    const t = int             // error[E0310]: expected a value, found type `int`
}

fn valueAsType() {
    const x: add = 1          // error[E0310]: expected a type, found `add`
}

fn unknownType() {
    const x: Missing = 1      // error[E0200]: cannot find type `Missing` in this scope
}
