// `@test` functions take nothing and return nothing (spec 12.2), which
// every build checks, although only `astra test` compiles them.

@test                            // error[E0205]: a `@test` function takes no parameters and returns nothing
fn takesAnArgument(n: int) {
    assert(n > 0)
}

@test                            // error[E0205]: a `@test` function takes no parameters and returns nothing
fn returnsAValue() int {
    return 1
}

fn main() {
}
