// requires: stage1
// Named arguments and defaults at calls (spec 3.3): E0302, E0306, E0308.

fn connect(host: str, port: int = 443, verbose: bool = false) int {
    return host.len() + port
}

fn pair(a: int, b: int) int {
    return a + b
}

fn main() {
    let f = pair
    let a = connect("h", colour: 1)   // error[E0306]: `connect` has no parameter `colour`
    let b = connect("h", port: 1, port: 2)   // error[E0306]: the parameter `port` is given twice
    let c = connect(port: 1, "h")   // error[E0306]: a positional argument cannot follow a named one
    let d = connect("h", 1, true, 4)   // error[E0302]: wrong number of arguments: expected at most 3, found 4
    let e = connect(port: 1)   // error[E0308]: missing argument for the parameter `host`
    let g = pair(1)   // error[E0302]: wrong number of arguments: expected 2, found 1
    let h = f(a: 1, b: 2)   // error[E0306]: this callee has no named parameters: pass the argument by position
    println("{a} {b} {c} {d} {e} {g} {h}")
}
