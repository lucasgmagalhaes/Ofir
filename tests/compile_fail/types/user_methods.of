struct Point {
    x: int

    fn origin() Point {
        return Point{x: 0}
    }

    fn get(self) int {
        return self.x
    }

    fn set(mut self, x: int) {
        self.x = x
    }

    fn broken(self) {
        self.x = 1           // error[E0315]: this value cannot be modified: declare it with `let`
    }
}

fn change(n: mut int) {
    n = 1
}

fn unknown(p: Point) {
    const a = p.size()         // error[E0301]: no method `size` on type `Point`
}

fn onType() {
    const b = Point.get()      // error[E0301]: `get` is a method: call it on a value, `value.m()`
}

fn onValue(p: Point) {
    const c = p.origin()       // error[E0301]: `origin` is an associated function: call it on the type, `Type.f()`
}

fn immutableReceiver() {
    const p = Point.origin()
    p.set(2)                 // error[E0315]: this value cannot be modified: declare it with `let`
}

fn immutableArgument() {
    const n = 0
    change(n)                // error[E0315]: this value cannot be modified: declare it with `let`
}

fn temporaryArgument() {
    change(1 + 2)            // error[E0315]: only variables and their fields can be modified
}

// Accepted.
fn fine() {
    let p = Point.origin()
    p.set(3)
    let n = p.get()
    change(n)
    change(p.x)
}
