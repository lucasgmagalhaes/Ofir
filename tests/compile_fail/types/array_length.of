// requires: stage1
// An array literal has exactly the length of its type (spec 2.7).

fn main() {
    let _a: [int; 3] = [1, 2]   // error[E0300]: mismatched types: expected `[int; 3]`, found an array of 2 elements
    let n = 2
    let _b: [int; 2] = [0; n]   // error[E0300]: the count of `[value; count]` as an array must be an integer literal
}
