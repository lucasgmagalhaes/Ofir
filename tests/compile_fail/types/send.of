// requires: stage1
// A `+ Send` function type and the `Send` and `Sync` bounds (spec 14.3).

struct Raw {
    p: *int,
}

fn needSend<T: Send>(_: T) {
}

fn needSync<T: Sync>(_: T) {
}

unsafe fn raw() Raw {
    return Raw{p: 0 as *int}
}

fn main() {
    const r = unsafe { raw() }
    const f: move fn() int + Send = move () int => {   // error[E0360]: the closure captures `r` of type `Raw`, which is not `Send`
        const _ = r
        return 1
    }
    const g = () int => 2
    const h: fn() int + Send = () int => g()   // error[E0360]: the closure captures `g` of type `fn() int`, which is not `Sync`
    needSend(unsafe { raw() })   // error[E0332]: `Raw` does not satisfy the bound `Send`
    const s = unsafe { raw() }
    needSync(&s)   // error[E0332]: `&Raw` does not satisfy the bound `Sync`
    const _ = f
    const _ = h
}
