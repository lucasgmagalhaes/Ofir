enum Shape {
    Circle(radius: float)
    Empty
}

enum Bad {
    A(int) = 1                // error[E0319]: explicit discriminants are allowed only in enums without payloads
}

enum Twice {
    A = 1
    B = 1                     // error[E0319]: discriminant 1 is used twice
}

fn unknownVariant() {
    const s = Shape.Square(1.0) // error[E0301]: no method `Square` on type `Shape`
}

fn shorthandWithoutType() {
    const s = .Empty            // error[E0326]: a variant is named through its enum: write `Enum.Empty`
}

fn arity() {
    const s: Shape = Shape.Circle()  // error[E0302]: wrong number of arguments: expected 1, found 0
}

fn missingPayload() {
    const s = Shape.Circle      // error[E0302]: the variant `Circle` takes 1 values
}

fn extraPayload() {
    const s: Shape = Shape.Empty(1)  // error[E0302]: the variant `Empty` takes no values: write it without parentheses
}

fn nonExhaustive(s: Shape) int {
    return match s {          // error[E0500]: non-exhaustive `match`: `Shape.Empty` is not covered
        Shape.Circle(_) => 1
    }
}

fn guardedOnly(n: int) int {
    return match n {          // error[E0500]: non-exhaustive `match`: `_` is not covered
        x if x > 0 => 1
    }
}

fn wrongPattern(s: Shape) {
    match s {
        Shape.Square(x) => println("?")   // error[E0320]: no variant `Square` in `Shape`
        _ => println("?")
    }
}

fn refutableLet(s: Shape) {
    const Shape.Circle(r) = s        // error[E0501]: this pattern does not match every value: use `match` or `if const`
}

fn tupleArity() {
    const (a, b) = (1, 2, 3)    // error[E0302]: wrong number of fields in the pattern: expected 3, found 2
}

fn fallsThrough(r: Shape) {
    const Shape.Circle(x) = r else {   // error[E0307]: the `else` block of `const ... else` must not fall through: end it with `return`, `break`, `continue` or a panic
        println("no")
    }
}
