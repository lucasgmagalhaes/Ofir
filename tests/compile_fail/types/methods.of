fn unknown(n: int) {
    const x = n.size()          // error[E0301]: no method `size` on type `int`
}

fn wrongReceiver(flag: bool) {
    const x = flag.len()        // error[E0301]: no method `len` on type `bool`
}

fn immutable() {
    const s = "a"
    s.push("b")               // error[E0315]: this value cannot be modified: declare it with `var`
}

fn borrowedParameter(s: str) {
    s.clear()                 // error[E0315]: this value cannot be modified: declare it with `var`
}

fn typeArguments(n: int) {
    const a = n.wrappingCast()  // error[E0302]: wrong number of type arguments: expected 1, found 0
}

fn notInteger(n: int) {
    const b = n.wrappingCast<str>()   // error[E0300]: mismatched types: expected an integer type, found str
}

fn arguments(s: str) {
    const c = s.startsWith(1)   // error[E0300]: mismatched types: expected str, found int
}

fn indexing(n: int) {
    const d = n[0]              // error[E0313]: type `int` cannot be indexed
}

fn constants() {
    const e = i32.LARGEST       // error[E0301]: no constant `LARGEST` on type `i32`
}

// Accepted: a `mut` parameter and a `var` can be modified.
fn modify(s: mut str) {
    s.push("!")
    var t = "x"
    t.clear()
}
