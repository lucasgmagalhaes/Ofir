// `x.checkedCast<T>()`: None when the value does not fit in T.
fn main() {
    const a = 300.checkedCast<u8>()
    const b = 200.checkedCast<u8>()
    const c = (-1).checkedCast<u64>()
    println("{a.isNone()} {b.unwrap()} {c.isSome()} {(-5).checkedCast<i8>() ?? 0}")
    const big: u64 = 18446744073709551615
    println("{big.checkedCast<int>().isNone()} {127.checkedCast<i8>().unwrap()}")
}
