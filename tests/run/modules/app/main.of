import geometry
import geometry.shapes
import geometry.shapes.Circle
import geometry.shapes.Kind
import util as u

fn main() {
    const c = Circle{radius: 2.0}
    const s = shapes.Square.new(3.0)
    println("{shapes.area(c)} {s.area()} {u.twice(21)} {u.LIMIT}")
    const kind = shapes.Kind.Round
    println("{shapes.describe(kind)} {shapes.describe(Kind.Angular)}")
    println("{geometry.unitArea()}")
}
