// When values are dropped (spec 5.2): user `drop` methods show the order.

struct Noisy {
    name: str

    fn drop(mut self) {
        println("drop {self.name}")
    }
}

struct Pair {
    left: Noisy
    right: Noisy
}

fn make(name: move str) Noisy {
    return Noisy{name}
}

fn consume(n: move Noisy) {
    println("consume {n.name}")
}

fn early(flag: bool) int {
    const _a = make("early-a")
    if flag {
        const _b = make("early-b")
        return 1
    }
    return 2
}

fn main() {
    const _first = make("first")
    const _second = make("second")
    println("scope")
    {
        const _inner = make("inner")
        println("inner block")
    }
    const moved = make("moved")
    consume(moved)
    let slot = make("old")
    slot = make("new")
    println("{make("temp").name.len()} after temp")
    const n = early(true)
    for i in 0..3 {
        const _each = make("loop{i}")
        if i == 1 {
            break
        }
    }
    const pair = Pair{left: make("left"), right: make("right")}
    const taken = pair.left
    println("took {taken.name}")
    const _ = make("ignored")
    println("after ignored")
    const _maybe = Option.Some(make("inside"))
    println("end {n}")
}
