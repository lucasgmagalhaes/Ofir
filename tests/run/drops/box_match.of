// A `match` on the value in a box borrows its parts: the box still owns
// them (a stage 0 double free, found by the stage 1 AST printer).

struct Block {
    stmts: List<str>
}

enum Kind {
    Str(value: str)
    Blk(block: Block)
}

struct E {
    kind: Kind
}

fn show(otherwise: &Option<Box<E>>) {
    if let Option.Some(e) = *otherwise {
        match e.kind {
            Kind.Blk(block) => println("block {block.stmts.len()}")
            _ => println("other")
        }
    }
}

fn main() {
    let inner = E{kind: Kind.Blk(Block{stmts: ["a".toOwned()]})}
    let o: Option<Box<E>> = Option.Some(Box.new(inner))
    show(&o)
    show(&o)
}
