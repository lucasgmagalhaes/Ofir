// `s.toCString()` makes a NUL-terminated copy for C (spec 11.3).

extern "C" {
    fn strlen(s: *u8) uint
    fn atoi(s: *u8) i32
}

fn cLen(s: str) uint {
    let c = s.toCString()          // owned, null-terminated copy
    return unsafe { strlen(c.ptr()) }
}

fn main() {
    println("{cLen("hello")} {cLen("")} {cLen("café")}")
    var digits = "12"
    digits.push("34")
    let c = digits.toCString()
    println("{c.len()} {unsafe { atoi(c.ptr()) }}")
}
