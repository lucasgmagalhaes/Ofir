// requires: stage1
// Fixed arrays `[T; N]` (spec 2.7): literals, `[v; N]`, indexing, copies,
// arrays in structs and arrays of arrays.

copy struct Point {
    x: int,
    y: int,
}

struct Board {
    cells: [i32; 3],
    name: str,
}

fn filled() [int; 4] {
    return [7; 4]
}

fn main() {
    let grid: [u8; 4] = [0, 0, 0, 0]
    println("{grid[0]} {grid[3]}")
    var a: [int; 4] = [1, 2, 3, 4]
    a[2] = 30
    let b = a   // a copy: changing `a` leaves `b` as it was
    a[0] = 100
    println("{a[0]} {b[0]} {b[2]}")
    let f = filled()
    println("{f[0]} {f[3]}")
    var board = Board{cells: [0; 3], name: "board"}
    board.cells[1] = 5
    println("{board.cells[0]} {board.cells[1]} {board.name}")
    var m: [[u8; 2]; 2] = [[1, 2], [3, 4]]
    m[1][0] = 9
    let row = 1
    println("{m[0][1]} {m[row][0]} {m[row][1]}")
    let points: [Point; 2] = [Point{x: 1, y: 2}, Point{x: 3, y: 4}]
    println("{points[1].x} {points[0].y}")
}
