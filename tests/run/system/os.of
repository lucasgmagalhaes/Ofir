// std.os (roadmap 3.9): arguments, environment and running a program,
// here the C compiler the toolchain uses.

import std.io
import std.os

fn main() {
    const args = os.args()
    println("args {args.len()}")
    println("unset {os.env("OFIR_SURELY_UNSET_VARIABLE") ?? "none"}")
    match os.run("clang", ["--version"]) {
        Result.Ok(out) => println("clang {out.status} {out.stdout.contains("clang version")}")
        Result.Err(e) => println("clang: {e.message}")
    }
    match os.run("sh", ["-c", "printf out; printf err >&2; exit 3"]) {
        Result.Ok(out) => println("sh {out.status} [{out.stdout}] [{out.stderr}]")
        Result.Err(e) => println("sh: {e.message}")
    }
    match os.run("ofir-no-such-program", []) {
        Result.Ok(out) => println("missing ran {out.status}")
        Result.Err(e) => println("missing {e.kind == io.IoErrorKind.NotFound}")
    }
    match os.currentDir() {
        Result.Ok(dir) => println("cwd absolute {dir.startsWith("/") || dir.slice(1, 3) == ":/"}")
        Result.Err(e) => println("cwd: {e.message}")
    }
    eprintln("this goes to standard error")
}
