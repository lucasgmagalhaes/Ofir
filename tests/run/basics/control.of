fn sign(n: int) str {
    if n > 0 {
        return "positive"
    } else if n < 0 {
        return "negative"
    }
    return "zero"
}

fn trace(name: str, value: bool) bool {
    println("eval {name}")
    return value
}

fn main() {
    println("{sign(5)} {sign(-3)} {sign(0)}")
    const parity = if 7 % 2 == 0 { "even" } else { "odd" }
    println(parity)
    const block = {
        const inner = 20
        inner + 1
    }
    println("{block}")
    if trace("a", false) && trace("b", true) {
        println("no")
    }
    if trace("c", true) || trace("d", true) {
        println("short-circuit")
    }
    println("{!true} {1 < 2 && 2 <= 2} {3 != 3 || 4 >= 5}")
}
