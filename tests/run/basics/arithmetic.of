fn main() {
    const a = 17
    const b = 5
    println("{a + b} {a - b} {a * b} {a / b} {a % b}")
    println("{-a / b} {-a % b} {a / -b}")
    println("{a & b} {a | b} {a ^ b} {a << 2} {a >> 1} {-a >> 1}")
    const small: u8 = 200
    println("{small + 55} {small / 3} {small >> 4}")
    const wide: u64 = 18446744073709551615
    println("{wide} {wide / 2}")
    const neg: i8 = -128
    println("{neg} {neg + 127}")
    const x = 1.5
    println("{x * 2.0} {x / 4.0} {0.1 + 0.2} {1.0 / 3.0} {x - 1.5}")
    var total: float = 0
    total += 2
    println("{total}")
}
