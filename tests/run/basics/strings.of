const GREETING = "hello"

fn shout(text: str) str {
    return text + "!"
}

fn main() {
    const name = "Ofir"
    const message = "{GREETING}, {name}"
    println(message)
    println(shout(message))
    println("{name == "Ofir"} {name != "ofir"} {"abc" < "abd"} {"b" > "abc"} {"" < "a"}")
    const flag = true
    const ratio: f32 = 0.5
    const byte: u8 = 65
    println("{flag} {ratio} {byte} {-7} {1e21} {0.00001} {100.0}")
    let built = ""
    for i in 0..3 {
        built = built + "{i},"
    }
    println(built)
    println("tab\there \"quoted\" \\ done")
}
