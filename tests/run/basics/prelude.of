// Ordering comes from std.core, visible without an import.
fn compare(a: int, b: int) Ordering {
    if a < b {
        return Ordering.Less
    }
    return if a == b { Ordering.Equal } else { Ordering.Greater }
}

fn main() {
    let o = compare(1, 2)
    println("{o.isLt()} {o.reverse().isGt()} {compare(3, 3).then(Ordering.Greater).isGt()} {o.then(Ordering.Greater).isLt()}")
}
