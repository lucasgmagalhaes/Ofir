// requires: stage1
// Arrow closures (spec 10.3) that borrow what they capture: their
// environment is on the stack; one that modifies a variable borrows it
// `&mut`.

struct Point {
    x: int
    y: int
}

fn each<T>(items: &List<T>, f: fn(&T)) {
    for i in 0..items.len() {
        f(&items[i])
    }
}

fn count<T>(items: &List<T>, keep: fn(&T) bool) int {
    let n = 0
    each(items, item => {
        if keep(item) {
            n += 1
        }
    })
    return n
}

fn bump(total: mut int, by: int) {
    const add = () => {
        total += by
    }
    add()
    add()
}

fn apply(f: fn(int) int, x: int) int {
    return f(x)
}

fn twice(f: fn()) {
    f()
    f()
}

fn main() {
    let total = 0
    const k = 3
    const add = (a: int, b: int) int => a + b + k
    println("{add(1, 2)}")
    println("{apply(x => x * 2 + k, 4)}")
    const name = "ofir"
    const greet = () => {
        println("hi {name}")
    }
    greet()
    twice(() => {
        total += 10
    })
    println("{total}")
    const s = "a" + "b"
    const len = () => s.len()
    println("{len()}")
    const list = [1, 5, 8, 2, 9]
    const limit = 4
    println("{count(&list, x => *x > limit)}")
    let t = 1
    bump(t, 5)
    println("{t}")
    const p = Point{x: 2, y: 3}
    const norm = () int => p.x * p.x + p.y * p.y
    println("{norm()}")
    const prefix = "n="
    const show = (n: int) str => "{prefix}{n}"
    println(show(7))
    let sum = 0
    for i in 0..4 {
        const addI = () => {
            sum += i
        }
        addI()
    }
    println("{sum}")
    const outer = 10
    const mk = (a: int) int => {
        const inner = (b: int) int => a + b + outer
        inner(1)
    }
    println("{mk(5)}")
}
