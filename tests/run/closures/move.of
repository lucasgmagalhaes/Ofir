// requires: stage1
// `move` closures (spec 10.3, 10.4): they own what they capture, in an
// environment on the heap that is dropped and freed with the closure.

struct Noisy {
    name: str

    fn drop(mut self) {
        println("drop {self.name}")
    }
}

struct Button {
    label: str
    handler: move fn() int
}

fn consume(f: move fn() int) {
    println("consume {f()}")
}

fn compose(f: move fn(int) int, g: move fn(int) int) move fn(int) int {
    return move (x: int) int => g(f(x))
}

fn noisy(name: str) Noisy {
    return Noisy{name: name.toOwned()}
}

fn makeGreeter(name: move str) move fn() str {
    return move () str => "hello, {name}"
}

fn makeAdder(k: int) move fn(int) int {
    return move (x: int) int => x + k
}

fn run(f: move fn() int) int {
    return f() + 1
}

fn main() {
    const greet = makeGreeter("ofir".toOwned())
    println(greet())
    const add = makeAdder(5)
    println("{add(2)}")
    const e = noisy("e")
    const size = move () int => e.name.len()
    println("{run(size)}")
    const none: move fn() int = () => 3
    println("{none()}")
    const a = noisy("a")
    const b = Button{label: "ok".toOwned(), handler: move () int => a.name.len() + 40}
    println(b.label)
    var list: List<move fn() int> = []
    for i in 0..3 {
        const n = noisy("n{i}")
        list.push(move () int => n.name.len() * 10 + i)
    }
    for i in 0..list.len() {
        println("{(list[i])()}")
    }
    const c = noisy("c")
    const f = move () int => c.name.len()
    if list.len() > 5 {
        consume(f)
    }
    println("after if")
    const h = compose(move (x: int) int => x + 1, move (x: int) int => x * 3)
    println("{h(4)}")
    const d = noisy("d")
    const outer = move () int => {
        const inner = () int => d.name.len() + 100
        inner()
    }
    println("{outer()}")
    const g2 = outer
    println("{g2()}")
    println("end")
}
