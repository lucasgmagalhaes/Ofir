// requires: stage1
// Built-in interfaces on unions (spec 17.5).

struct Point {
    x: int
    y: int
}

type Value = int | str | bool

fn main() {
    const a: Value = 3
    const b: Value = "hi"
    const c: Value = true
    println("{a} {b} {c}")
    const text = "[{a}, {b}, {c}]"
    println(text)
    println("{a:?} {b:?} {c:?}")
    const p: int | Point = Point { x: 1, y: 2 }
    println("{p:?}")
    const some: Option<Value> = Option.Some(b.clone())
    println("{some:?}")
    const three: Value = 3
    println("{a == three} {a == b} {a != c}")
    const twin = b.clone()
    println("{twin == b}")
    var counts: Map<Value, int> = Map.new()
    counts.insert(a, 1)
    counts.insert(b, 2)
    counts.insert(three, 3)
    println("{counts.len()}")
    const f: f64 | int = 1.5
    println("{f}")
}
