// requires: stage1
// Union types (spec 17.1-17.3, 17.6): normalization and widening at the
// coercion points.

struct IoError {
    code: int
}

struct ParseError {
    line: int
}

type LoadError = IoError | ParseError
type Reversed = ParseError | IoError
type Nested = LoadError | IoError

struct Holder {
    value: int | str
}

fn take(e: move LoadError) int {
    return 1
}

fn same(e: move Reversed) LoadError {
    return e   // the same type: members are sorted
}

fn flat(e: move Nested) LoadError {
    return e   // flattened, repeats removed
}

fn make(ok: bool) LoadError {
    if ok {
        return IoError{code: 2}
    }
    return ParseError{line: 3}
}

fn pick(ok: bool) int | str {
    return if ok { 1 } else { "one" }
}

fn main() {
    let a: LoadError = IoError{code: 1}
    let b = same(a)
    let c = flat(b)
    println("take {take(ParseError{line: 4})} {take(c)}")
    let _d = make(true)
    let _e: Option<int | bool> = Option.Some(true)
    let _h = Holder{value: "text"}
    var n: int | str = 5
    n = "five"
    let _m = n
    let _p = pick(false)
    let k = 2
    let _q: int | bool = match k {
        2 => true
        _ => 7
    }
    let _r: int | str = if k > 1 { 1 } else { "one" }
    println("done")
}
