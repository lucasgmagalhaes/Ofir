// `sort`: integers, floats and strings; stable, of any length.

fn show(values: List<int>) str {
    var text = ""
    for v in values {
        text.push("{v} ")
    }
    return text
}

fn main() {
    var ints = [5, -3, 9, 0, 9, 2, -3, 7]
    ints.sort()
    println(show(ints))

    var floats = [2.5, -1.0, 0.5]
    floats.sort()
    println("{floats[0]} {floats[1]} {floats[2]}")

    var names = ["mia", "ana", "zoe", "bob", "ana"]
    names.sort()
    println("{names[0]} {names[1]} {names[2]} {names[3]} {names[4]}")

    var big: List<int> = []
    var seed = 12345
    for _ in 0..10000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        big.push(seed % 1000)
    }
    big.sort()
    var ordered = true
    for i in 1..big.len() {
        if big[i - 1] > big[i] {
            ordered = false
        }
    }
    println("{big.len()} {ordered} {big[0]} {big[9999]}")

    var one = [1]
    one.sort()
    var none: List<int> = []
    none.sort()
    println("{one[0]} {none.len()}")
}
