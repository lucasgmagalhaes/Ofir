// List literals, indexing, writing elements, the std methods and `for`.

struct Point {
    x: int
    y: int
}

fn total(values: List<int>) int {
    let sum = 0
    for v in values {
        sum += v
    }
    return sum
}

fn show(values: List<int>) str {
    let text = ""
    for i in 0..values.len() {
        if i > 0 {
            text.push(" ")
        }
        text.push("{values[i]}")
    }
    return text
}

fn main() {
    let xs = [3, 1, 2]
    println("{xs.len()} {xs[0]} {xs[2]} {total(xs)}")
    xs.push(10)
    xs[1] = 7
    xs[0] += 100
    println(show(xs))

    const empty: List<str> = []
    println("{empty.len()} {empty.isEmpty()}")
    const zeros = [0; 5]
    println(show(zeros))

    let words = ["b", "c"]
    words.insert(0, "a")
    words.push("d")
    const removed = words.remove(1)
    const swapped = words.swapRemove(0)
    println("{removed} {swapped} {words.len()} {words[0]} {words[1]}")

    let points = [Point{x: 1, y: 2}, Point{x: 3, y: 4}]
    points[1].y = 40
    println("{points[0].x} {points[1].y}")

    let grid = [[1, 2], [3, 4]]
    grid[1][0] = 30
    println("{grid[0][1]} {grid[1][0]}")

    let many: List<int> = List.new()
    for i in 0..1000 {
        many.push(i * i)
    }
    println("{many.len()} {many[999]} {many.capacity() >= 1000}")

    let more = [1, 2]
    more.extend([3, 4, 5])
    more.reverse()
    more.truncate(4)
    println(show(more))
    more.clear()
    println("{more.len()}")
}
