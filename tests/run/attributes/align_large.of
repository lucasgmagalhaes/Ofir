// requires: stage1
// `@align(N)` above 16 (spec 13.2, 13.7): locals, fields, enum payloads,
// `Box`, `List` and `move` closures all keep the alignment.

@align(64)
struct Line {
    a: u8
}

@align(4096)
struct Page {
    a: u8
}

struct Holder {
    b: u8
    line: Line
}

enum Slot {
    Empty
    Full(Line)
}

fn lineAt(l: &Line) int {
    return unsafe { l as *Line as int } % 64
}

fn pageAt(p: &Page) int {
    return unsafe { p as *Page as int } % 4096
}

fn main() {
    println("{sizeOf<Line>()} {alignOf<Line>()} {sizeOf<Holder>()} {alignOf<Slot>()}")
    println("{sizeOf<Page>()} {alignOf<Page>()}")
    const line = Line{a: 1}
    const page = Page{a: 2}
    const h = Holder{b: 3, line: Line{a: 4}}
    println("{lineAt(&line)} {pageAt(&page)} {lineAt(&h.line)}")
    const boxed = Box.new(Page{a: 5})
    println("{pageAt(&*boxed)} {boxed.a}")
    var lines: List<Line> = []
    for _i in 0..100 {
        lines.push(Line{a: 6})
    }
    var pages: List<Page> = []
    for _i in 0..10 {
        pages.push(Page{a: 7})
    }
    println("{lineAt(&lines[99])} {pageAt(&pages[9])} {lines.len()} {pages[9].a}")
    const slots = [Slot.Empty, Slot.Full(Line{a: 8})]
    const inSlot = match slots[1] {
        Slot.Full(l) => lineAt(&l)
        Slot.Empty => -1
    }
    const captured = Page{a: 9}
    const f = move () int => pageAt(&captured) + captured.a as int
    println("{inSlot} {f()}")
}
