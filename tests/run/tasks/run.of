// requires: stage1
// `task.run` starts a task on a thread of its own and `join` returns its
// result (spec 14.2).

import std.task

struct Pair {
    a: int
    b: str
}

fn main() {
    let data = [1, 2, 3]
    let handle = task.run(move () int => {
        var sum = 0
        for x in data {
            sum += x
        }
        return sum
    })
    println("{handle.join()}")
    var handles: List<task.Task<int>> = []
    for i in 0..4 {
        handles.push(task.run(move () int => i * i))
    }
    var total = 0
    for _ in 0..handles.len() {
        total += handles.pop().unwrap().join()
    }
    println("{total}")
    let name = "ofir".toOwned()
    let p = task.run(move () Pair => Pair{a: name.len(), b: "{name}!"})
    let r = p.join()
    println("{r.a} {r.b}")
    let done = task.run(move () => println("in a task"))
    done.join()
    println("end")
}
