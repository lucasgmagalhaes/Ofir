// requires: stage1
// `task.run` starts a task on a thread of its own and `join` returns its
// result (spec 14.2).

import std.task

struct Pair {
    a: int
    b: str
}

fn main() {
    const data = [1, 2, 3]
    const handle = task.run(move () int => {
        let sum = 0
        for x in data {
            sum += x
        }
        return sum
    })
    println("{handle.join()}")
    let handles: List<task.Task<int>> = []
    for i in 0..4 {
        handles.push(task.run(move () int => i * i))
    }
    let total = 0
    for _ in 0..handles.len() {
        total += handles.pop().unwrap().join()
    }
    println("{total}")
    const name = "ofir".toOwned()
    const p = task.run(move () Pair => Pair{a: name.len(), b: "{name}!"})
    const r = p.join()
    println("{r.a} {r.b}")
    const done = task.run(move () => println("in a task"))
    done.join()
    println("end")
}
