// Moves the analysis accepts: reassigning after a move, moving on every
// path, moving parts, `mut` parameters given a new value, mem.replace.

import std.mem

struct User {
    name: str
    age: int
}

fn consume(s: move str) int {
    return s.len()
}

fn reset(s: mut str) str {
    const old = mem.replace(s, "new")
    return old
}

fn rename(s: mut str) {
    const taken = s
    s = "{taken}!"
}

fn pick(flag: bool) str {
    const a = "left".toOwned()
    const b = "right".toOwned()
    if flag {
        return a
    }
    return b
}

fn main() {
    let s = "first".toOwned()
    const n = consume(s)
    s = "second".toOwned()          // a new value after the move
    println("{n} {s}")

    const u = User{name: "ana", age: 30}
    const name = u.name               // moves a part
    println("{name} {u.age}")

    let label = "old".toOwned()
    println("{reset(label)} {label}")
    rename(label)
    println(label)

    const options = [Option.Some(1), Option.None]
    for o in options {
        print("{o ?? 0} ")
    }
    println("")
    println("{pick(true)} {pick(false)}")

    let names = ["b", "a"]
    const first = mem.replace(names[0], "c")
    let x = 1
    let y = 2
    mem.swap(x, y)
    println("{first} {names[0]} {x} {y}")

    let maybe = Option.Some("token".toOwned())
    const taken = maybe.take()
    println("{taken.isSome()} {maybe.isNone()}")
}
