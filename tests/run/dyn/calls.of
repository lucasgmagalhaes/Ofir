// requires: stage1
// `dyn I` (spec 9.7): borrowed `dyn` parameters, `&dyn I` and
// `Box<dyn I>`, with calls through the vtable, default methods included.

interface Shape {
    fn area(self) int

    fn describe(self) str {
        return "area {self.area()}"
    }
}

struct Square {
    side: int

    fn area(self) int {
        return self.side * self.side
    }
}

struct Rect: Shape {
    w: int
    h: int

    fn area(self) int {
        return self.w * self.h
    }
}

fn show(s: dyn Shape) {
    println(s.describe())
}

fn main() {
    let sq = Square{side: 3}
    show(sq)
    show(Rect{w: 2, h: 5})
    let r: &dyn Shape = &sq
    println("{r.area()}")
    let shapes: List<Box<dyn Shape>> = [Box.new(Square{side: 2}), Box.new(Rect{w: 1, h: 7})]
    for i in 0..shapes.len() {
        println(shapes[i].describe())
    }
}
