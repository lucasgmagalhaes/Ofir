// requires: stage1
// flags: --release
// Under -O2, with `noalias` and `readonly` parameters (spec 13.5): `dyn`
// calls pass every argument through the vtable thunk.

interface Shape {
    fn area(self, scale: int) int
    fn grow(mut self, by: int, times: int)
}

struct Square {
    side: int

    fn area(self, scale: int) int {
        return self.side * self.side * scale
    }

    fn grow(mut self, by: int, times: int) {
        self.side = self.side + by * times
    }
}

fn total(shapes: &List<Box<dyn Shape>>, scale: int) int {
    let sum = 0
    for s in shapes {
        sum = sum + s.area(scale)
    }
    return sum
}

fn addInto(dst: mut int, src: &int) {
    dst = dst + *src
}

fn main() {
    let shapes: List<Box<dyn Shape>> = List.new()
    const small: Box<dyn Shape> = Box.new(Square{side: 2})
    const big: Box<dyn Shape> = Box.new(Square{side: 3})
    shapes.push(small)
    shapes.push(big)
    println("{total(&shapes, 2)}")
    let sq = Square{side: 1}
    const d: &mut dyn Shape = &mut sq
    d.grow(2, 3)
    println("{sq.side}")
    let x = 4
    const y = 5
    addInto(x, &y)
    println("{x}")
}
