// requires: stage1
// Conditional types (spec 16.5): `if A is B`, `infer` and filters.

struct Config {
    host: Option<str>
    port: Option<int>
    retries: int
}

struct Mixed {
    a: int
    b: str
    c: int
}

type Unwrap<T> = if T is Option<infer U> { U } else { T }
type Required<T> = { [K in keyof T]: Unwrap<T[K]> }
type Ints<T> = { [K in keyof T if T[K] is int]: T[K] }
type IsInt<T> = if T is int { true } else { false }
type Pick2<T> = if IsInt<T> { (T, T) } else { T }
type Same<T> = if T is (infer A, infer A) { A } else { bool }

fn port(c: &Required<Config>) int {
    return c.port + c.retries
}

fn main() {
    const r = Required<Config>{host: "localhost".toOwned(), port: 8080, retries: 2}
    println("{r.host} {port(&r)}")
    const i = Ints<Mixed>{a: 1, c: 3}
    println("{i.a + i.c}")
    const w: Unwrap<int> = 4
    const v: Unwrap<Option<int>> = 5
    println("{w + v}")
    const pair: Pick2<int> = (6, 7)
    const one: Pick2<str> = "eight"
    println("{pair.0 + pair.1} {one}")
    const same: Same<(int, int)> = 9
    const other: Same<(int, str)> = true
    println("{same} {other}")
}
