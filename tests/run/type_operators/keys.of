// requires: stage1
// Key types and indexed access (spec 16.1-16.3): `T[K]` is the type of a
// field, and `a[.k]` is the field `a.k`, a place that can be assigned.

struct Point {
    x: float
    y: float
    label: str
}

struct Pair(int, str)

type X = Point[.x]
type Coords = keyof Point - .label
type Coord = Point[Coords]
type Second = (int, str)[.1]
type Both = Pair[.0 | .0]

fn scale(v: Coord, by: X) float {
    return v * by
}

fn main() {
    var p = Point{x: 1.0, y: 2.0, label: "p"}
    p[.x] = 3.0
    p[.y] += 1.5
    let x: X = p[.x]
    let y: Coord = p[.y]
    println("{x} {y} {p[.label]} {scale(y, 2.0)}")
    let t = (7, "seven")
    let s: Second = t[.1]
    let pair = Pair(8, "eight")
    let n: Both = pair[.0]
    println("{t[.0]} {s} {n} {pair[.1]}")
    let list = [10, 20]
    println("{list[1]}")
}
