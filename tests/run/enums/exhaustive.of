// Matches that are exhaustive only through nested patterns.

enum Error {
    Empty
    BadDigit(u8)
    TooLarge
}

fn describe(r: Result<int, Error>) str {
    return match r {
        Result.Ok(n) => "ok {n}"
        Result.Err(Error.Empty) => "empty"
        Result.Err(Error.BadDigit(b)) => "bad {b}"
        Result.Err(Error.TooLarge) => "large"
    }
}

fn both(a: bool, b: bool) str {
    return match (a, b) {
        (true, true) => "tt"
        (true, false) => "tf"
        (false, true) => "ft"
        (false, false) => "ff"
    }
}

fn depth(o: Option<Option<int>>) int {
    return match o {
        Option.Some(Option.Some(n)) => n
        Option.Some(Option.None) => -1
        Option.None => -2
    }
}

fn main() {
    println("{describe(Result.Ok(1))} {describe(Result.Err(Error.Empty))} {describe(Result.Err(Error.BadDigit(7)))} {describe(Result.Err(Error.TooLarge))}")
    println("{both(true, false)} {both(false, true)}")
    println("{depth(Option.Some(Option.Some(3)))} {depth(Option.Some(Option.None))} {depth(Option.None)}")
}
