copy enum Direction {
    North
    East
    South
    West

    fn turned(self) Direction {
        return match self {
            Direction.North => Direction.East
            Direction.East => Direction.South
            Direction.South => Direction.West
            Direction.West => Direction.North
        }
    }

    fn name(self) str {
        return match self {
            Direction.North => "north"
            Direction.East => "east"
            Direction.South => "south"
            Direction.West => "west"
        }
    }
}

enum Shape {
    Circle(radius: float)
    Square(side: float)

    fn scaled(self, k: float) Shape {
        return match self {
            Shape.Circle(r) => Shape.Circle(r * k)
            Shape.Square(s) => Shape.Square(s * k)
        }
    }

    fn area(self) float {
        return match self {
            Shape.Circle(r) => 3.0 * r * r
            Shape.Square(s) => s * s
        }
    }
}

fn main() {
    var d = Direction.North
    for _ in 0..5 {
        print("{d.name()} ")
        d = d.turned()
    }
    println("")
    println("{d == Direction.East} {d == Direction.West} {d != Direction.North}")
    var s: Shape = Shape.Square(2.0)
    s = s.scaled(1.5)
    const c = Shape.Circle(1.0).scaled(2.0)
    println("{s.area()} {c.area()}")
    const pair = (d, s)
    println("{pair.0.name()} {pair.1.area()}")
}
