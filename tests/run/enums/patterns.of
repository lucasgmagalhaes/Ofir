enum Token {
    Number(int)
    Word(text: str)
    Pair(left: int, right: int)
    End
}

struct Point {
    x: int
    y: int
}

struct UserId(int)

enum Expr {
    Literal(int)
    Negate(Token)
    Add(Token, Token)
}

fn describe(t: Token) str {
    return match t {
        Token.Number(0) => "zero"
        Token.Number(n) if n < 0 => "negative {n}"
        Token.Number(n) => "number {n}"
        Token.Word("hi") | Token.Word("hello") => "greeting"
        Token.Word(w) => "word {w}"
        Token.Pair(a, _) | Token.Pair(_, a) if a == 0 => "pair with zero"
        Token.Pair(a, b) => "pair {a + b}"
        Token.End => "end"
    }
}

fn eval(e: Expr) int {
    return match e {
        Expr.Literal(n) => n
        Expr.Negate(Token.Number(n)) => -n
        Expr.Add(Token.Number(a), Token.Number(b)) => a + b
        _ => 0
    }
}

fn quadrant(p: Point) str {
    return match p {
        Point{x: 0, y: 0} => "origin"
        Point{x: 0, ..} | Point{y: 0, ..} => "axis"
        Point{x, y} if x > 0 && y > 0 => "first"
        _ => "other"
    }
}

fn main() {
    const tokens = (Token.Number(0), Token.Number(-3), Token.Number(7), Token.Word("hi"))
    println("{describe(tokens.0)}, {describe(tokens.1)}, {describe(tokens.2)}, {describe(tokens.3)}")
    println("{describe(Token.Word("x"))}, {describe(Token.Pair(0, 5))}, {describe(Token.Pair(2, 3))}, {describe(Token.End)}")
    println("{eval(Expr.Literal(4))} {eval(Expr.Negate(Token.Number(5)))} {eval(Expr.Add(Token.Number(1), Token.Number(2)))} {eval(Expr.Negate(Token.End))}")
    println("{quadrant(Point{x: 0, y: 0})} {quadrant(Point{x: 0, y: 3})} {quadrant(Point{x: 2, y: 2})} {quadrant(Point{x: -1, y: 2})}")
    const id = UserId(42)
    const UserId(raw) = id
    const Point{x, y: height} = Point{x: 7, y: 8}
    const (first, (second, third)) = (1, (2.5, "three"))
    println("{raw} {x} {height} {first} {second} {third}")
    const flag = true
    match flag {
        true => println("yes")
        false => println("no")
    }
    const grade = match 85 {
        90..=100 => "A"
        80..90 => "B"
        _ => "C"
    }
    println(grade)
}
