// requires: stage1 (raw, multi-line and byte strings, roadmap 5.10)
// Raw strings, multi-line strings and byte strings (spec 1.7).

fn sum(bytes: &[u8]) int {
    var total = 0
    for b in bytes {
        total += b as int
    }
    return total
}

fn main() {
    println(r"C:\path\{name}")
    println(r"")

    let request = b"GET \xff\"\n"
    println("{request.len()} {request[0]} {request[4]} {request[5]} {request[6]}")
    println("{sum(b"ab")} {b"".len()}")

    let text = """
        first
          indented

        raw: \n {x}
        """
    print(text)
    print("""
    last
    """)
    println("{"""
        a
        """.len()}")
}
