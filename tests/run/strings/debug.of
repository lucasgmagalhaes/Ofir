// requires: stage1 (Debug and {x:?}, roadmap 5.5)
struct Point {
    x: int
    y: int
}

struct Meters(int)

struct Empty {}

enum Shape {
    Circle(f64)
    Rect(w: int, h: int)
    Dot
}

struct Secret {
    code: int

    fn debug(self, out: mut str) {
        out = out + "Secret(***)"
}
    }

fn show<T: Debug>(value: T) {
    println("generic {value:?}")
}

fn main() {
    const n = 42
    const s = "a\"b\n\tc"
    println("{n:?} {s:?} {true:?} {1.5:?}")
    const p = Point{x: 1, y: 2}
    println("{p:?}")
    const m = Meters(5)
    println("{m:?}")
    const e = Empty{}
    println("{e:?}")
    const t = (1, "x")
    const one = (7,)
    println("{t:?} {one:?}")
    const a = Shape.Circle(2.5)
    const b = Shape.Rect(3, 4)
    const c = Shape.Dot
    println("{a:?} {b:?} {c:?}")
    const o: Option<int> = Option.Some(3)
    println("{o:?}")
    const k = Secret{code: 7}
    println("{k:?}")
    show(p)
    show("hi")
    more()
}

fn more() {
    const xs = [1, 2, 3]
    const names = ["a", "b"]
    const nested = [[1], [], [2, 3]]
    const bx = Box.new(Point{x: 5, y: 6})
    const ops: List<Option<int>> = [Option.Some(1), Option.None]
    const r = &xs
    println("{xs:?} {names:?} {nested:?} {bx:?} {ops:?} {r:?}")
    const empty: List<int> = []
    println("{empty:?} {():?}")
    const s = "{xs:?}!"
    println(s)
    var m: Map<str, List<int>> = Map.new()
    m.insert("a", [1])
    m.insert("b", [])
    println("{m:?}")
    const leaf = Box.new(Tree.Leaf)
    const right = Tree.Node(Box.new(Tree.Leaf), 2, Box.new(Tree.Leaf))
    const tree = Tree.Node(leaf, 1, Box.new(right))
    println("{tree:?} {"\x01\x7f\r\0\\":?}")
}

enum Tree {
    Leaf
    Node(Box<Tree>, int, Box<Tree>)
}
