// panic: stack overflow
// Larger frames: each call holds a list header and a string on the stack
// (both short, so that reaching the limit takes little time).

fn deep(tag: str, n: int) int {
    const label = "{tag}{n % 10}"
    const items = [n, n + 1, n + 2]
    return deep(label.slice(0, 1), n + 1) + items[0]
}

fn main() {
    println("{deep("x", 0)}")
}
