// requires: stage1
// A `ListIter` borrows its list: the list cannot change while the iterator
// is in use (spec 5.6).

fn main() {
    let xs = [1, 2]
    for x in xs.iter() {
        xs.push(*x)             // error[E0701]: cannot borrow `xs` as mutable because it is also borrowed as shared by the `for` loop
    }
    let it = xs.iter()
    xs.push(3)                  // error[E0701]: cannot borrow `xs` as mutable because it is also borrowed as shared by `it`
    const _y = it.next()
    let later = xs.iter()
    const _z = later.next()
    xs.push(4)
}
