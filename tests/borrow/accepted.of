// Programs the borrow checker accepts (spec 5.4).

struct Lexer {
    interpolations: List<int>
    brackets: List<int>
}

struct Pair {
    a: List<int>
    b: List<int>
}

fn append(dst: mut List<int>, src: List<int>) {
    for x in src {
        dst.push(x)
    }
}

fn total(xs: List<int>) int {
    let sum = 0
    for x in xs {
        sum += x
    }
    return sum
}

// A borrow lasts until the last use of the reference.
fn lastUse() {
    let list = [1, 2, 3]
    const r = &list
    println("{r.len()}")
    list.push(4)
}

// Arguments are evaluated before the exclusive borrow of `mut self`.
fn twoPhase() {
    let list = [1, 2, 3]
    list.push(list.len())
    let other = [4]
    append(list, other)
    append(other, list)
}

// Distinct fields are borrowed independently.
fn disjointFields() {
    let lx = Lexer{interpolations: [], brackets: [1]}
    lx.interpolations.push(lx.brackets.len())
    let pair = Pair{a: [1], b: [2]}
    const r = &pair.a
    pair.b.push(3)
    println("{r.len()}")
}

// A loop that leaves right after modifying what it iterates.
fn breakAfterPush() {
    let list = [1, 2, 3]
    for x in list {
        if x == 2 {
            list.push(4)
            break
        }
    }
    println("{list.len()}")
}

// The reference is used on one branch, the list modified on the other.
fn branches(flag: bool) {
    let list = [1, 2, 3]
    const r = &list
    if flag {
        println("{r.len()}")
    } else {
        list.push(4)
    }
}

// A reference given a new value no longer borrows the old place.
fn reassigned() {
    let a = [1]
    let b = [2]
    let r = &a
    println("{r.len()}")
    r = &b
    a.push(3)
    println("{r.len()}")
}

// Shared borrows may overlap.
fn shared() {
    const list = [1, 2, 3]
    const r = &list
    const s = &list
    println("{total(list)} {r.len()} {s.len()}")
}

// A borrow made in each iteration ends within it.
fn eachIteration() {
    let list = [1, 2, 3]
    for i in 0..3 {
        const r = &list
        println("{r.len()} {i}")
        list.push(i)
    }
}

// A result that holds no reference does not borrow.
fn copied() {
    let list = [1, 2, 3]
    const n = list.len()
    const first = match list.first() {
        Option.Some(x) => *x
        Option.None => 0
    }
    list.push(n + first)
}

fn main() {
    lastUse()
    twoPhase()
    disjointFields()
    breakAfterPush()
    branches(true)
    reassigned()
    shared()
    eachIteration()
    copied()
}
