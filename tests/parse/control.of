fn control(n: int) int {
    if n < 0 {
        return -1
    } else if n == 0 {
        return 0
    } else {
        println("positive")
    }

    const kind = if n % 2 == 0 { "even" } else { "odd" }

    if const .Some(value) = lookup(n) {
        println("{value}")
    }

    if point == (Point { x: 0, y: 0 }) {
        return 0
    }

    const size = match shape {
        .Circle(r) => r * r
        .Rect(w, h) if w > h => w * h
        .Rect(w, h) => {
            const area = w * h
            area
        }
        _ => 0
    }

    match n {
        0 | 1 => println("small"),
        2..=9 => println("digit"),
        -5..0 => println("negative"),
        Point { x, y: 0, .. } => println("on the axis"),
        Pair(a, _) => println("pair"),
        Shape.Circle(r) => println("circle"),
        (a, b) => println("tuple"),
        mut other => println("other"),
    }

    return size
}
