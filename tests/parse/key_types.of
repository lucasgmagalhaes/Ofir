// requires: stage1
// Key types (spec 16.1-16.3): `keyof`, key literals, `|`, `&`, `-` and
// indexed access. `as` and type tests keep `|`, `&`, `-` and `[` for the
// expression or the pattern around them.

struct Point {
    x: float
    y: float
}

type PointKey = keyof Point
type First = .x
type Second = .1
type Both = .x | .y
type Keys = keyof Point - .x | .y & keyof Point
type Coord = Point[.x]
type All = Point[keyof Point]?
type keyof = int

fn get<T, K: keyof T>(value: T, key: K) T[K] {
    return value[key]
}

fn masks(a: int, b: int) int {
    return a as int - 1 | b as int & 3
}

fn test(e: dyn Debug) bool {
    return match e {
        n: int | n: Point => true
        _ => false
    }
}

fn plain(k: keyof) keyof {
    return k
}
