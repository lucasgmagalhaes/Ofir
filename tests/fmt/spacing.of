import std.io
import std.fmt

fn add( a:int,b : int ) int {
  return a+b*2
}

fn main() {
    const xs = [1,2 , 3]
    const n = -xs[0] + xs . len()
    var total=0
    total+=add(n , 1)
    if total>=2&&n<=3 { println("{total}") }
    const p = &xs
    const v = if n > 0 { n } else { -n }
    println("{v} {p.len()}")
}
